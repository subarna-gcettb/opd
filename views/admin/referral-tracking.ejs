<div class="d-flex justify-content-between align-items-center mb-3">
  <div><h4 class="mb-1">Referral Tracking</h4><div class="small text-muted">Track every patient registration and downstream OPD / diagnostic activity by referral provider.</div></div>
  <a href="/admin/referrals" class="btn btn-outline-secondary btn-sm">Manage Providers</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted small">Configured Providers</div><div class="display-6 fw-semibold"><%= providers.length %></div></div></div></div>
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted small">Attributed Patients</div><div class="display-6 fw-semibold"><%= providers.reduce((n,p)=>n+Number(p.patients),0) %></div></div></div></div>
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted small">OPD + Diagnostic Activity</div><div class="display-6 fw-semibold"><%= providers.reduce((n,p)=>n+Number(p.opd)+Number(p.tests),0) %></div></div></div></div>
</div>

<div class="card mb-4">
  <div class="card-header"><strong>Provider Performance</strong></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Provider</th><th>Referral Code</th><th>Patients Registered</th><th>OPD</th><th>Diagnostics</th><th>Total Activity</th><th>Status</th></tr></thead>
    <tbody>
    <% providers.forEach(function(p){ %>
      <tr>
        <td><strong><%= p.provider_name %></strong><div class="small text-muted"><%= p.provider_type || '—' %></div></td>
        <td><code><%= p.referral_code %></code></td>
        <td><strong><%= p.patients %></strong></td><td><%= p.opd %></td><td><%= p.tests %></td>
        <td><span class="badge text-bg-primary"><%= Number(p.patients)+Number(p.opd)+Number(p.tests) %></span></td>
        <td><span class="badge text-bg-<%= p.is_active ? 'success':'secondary' %>"><%= p.is_active ? 'Active':'Inactive' %></span></td>
      </tr>
    <% }) %>
    <% if(!providers.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No referral providers configured.</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<% if(legacy.length){ %>
<div class="card mb-4 border-warning">
  <div class="card-header bg-warning-subtle"><strong>Legacy / Unmapped Referral Codes</strong><div class="small">These records contain a referral code but are not yet linked to a Super Admin provider. Create the matching provider/code to claim future attribution; existing matching records are automatically linked when the provider is created.</div></div>
  <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Code</th><th>Patients</th><th>OPD</th><th>Tests</th></tr></thead><tbody>
  <% legacy.forEach(function(r){ %><tr><td><code><%= r.referral_code %></code></td><td><%= r.patients %></td><td><%= r.opd %></td><td><%= r.tests %></td></tr><% }) %>
  </tbody></table></div>
</div>
<% } %>

<div class="card">
  <div class="card-header"><strong>Recent Referral Patient Registrations</strong></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Date</th><th>Patient</th><th>Health ID</th><th>Referral Provider</th><th>Referral Code</th><th>Registered By</th></tr></thead>
    <tbody>
    <% recentPatients.forEach(function(p){ %>
      <tr>
        <td><%= formatDateTime(p.created_at) %></td>
        <td><strong><%= p.name %></strong><div class="small text-muted"><%= p.registration_number %></div></td>
        <td><code><%= p.health_id %></code></td>
        <td><%= p.provider_name || 'Legacy / Unmapped' %></td>
        <td><code><%= p.referral_code %></code></td>
        <td><%= p.registered_by_name || '—' %></td>
      </tr>
    <% }) %>
    <% if(!recentPatients.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No referred patients registered yet.</td></tr><% } %>
    </tbody>
  </table></div>
</div>