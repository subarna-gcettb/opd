<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Users</h4>
  <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newUserModal"><i class="bi bi-person-plus"></i> Create User</button>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Name</th><th>Email</th><th>Branch</th><th>Roles</th><th>Status</th><th>Last Login</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.branch_name || '—' %></td>
            <td><%= u.roles || '—' %></td>
            <td><span class="badge text-bg-<%= u.is_active ? 'success' : 'secondary' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span>
              <% if (u.must_reset_password) { %><span class="badge text-bg-warning">Must reset PW</span><% } %>
            </td>
            <td><%= u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'Never' %></td>
            <td>
              <div class="d-flex gap-1">
                <form method="POST" action="/admin/users/<%= u.id %>/active">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="isActive" value="<%= u.is_active ? '0' : '1' %>">
                  <button class="btn btn-sm btn-outline-<%= u.is_active ? 'danger' : 'success' %>"><%= u.is_active ? 'Deactivate' : 'Activate' %></button>
                </form>
                <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetModal<%= u.id %>">Reset PW</button>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#rolesModal<%= u.id %>">Roles</button>
              </div>

              <div class="modal fade" id="resetModal<%= u.id %>" tabindex="-1">
                <div class="modal-dialog"><form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="modal-content">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="modal-header"><h5 class="modal-title">Reset Password — <%= u.name %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                  <div class="modal-body"><input type="text" name="newPassword" class="form-control" minlength="8" placeholder="New temporary password" required></div>
                  <div class="modal-footer"><button type="submit" class="btn btn-primary">Reset</button></div>
                </form></div>
              </div>

              <div class="modal fade" id="rolesModal<%= u.id %>" tabindex="-1">
                <div class="modal-dialog"><form method="POST" action="/admin/users/<%= u.id %>/roles" class="modal-content">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="modal-header"><h5 class="modal-title">Roles — <%= u.name %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                  <div class="modal-body">
                    <% roles.forEach(function(r) { %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="roleIds" value="<%= r.id %>" <%= (u.roles || '').includes(r.code) ? 'checked' : '' %>>
                        <label class="form-check-label"><%= r.name %></label>
                      </div>
                    <% }) %>
                  </div>
                  <div class="modal-footer"><button type="submit" class="btn btn-primary">Save Roles</button></div>
                </form></div>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="newUserModal" tabindex="-1">
  <div class="modal-dialog"><form method="POST" action="/admin/users" class="modal-content">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-header"><h5 class="modal-title">Create User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <div class="mb-2"><label class="form-label">Name</label><input type="text" name="name" class="form-control" required></div>
      <div class="mb-2"><label class="form-label">Email</label><input type="email" name="email" class="form-control" required></div>
      <div class="mb-2"><label class="form-label">Mobile</label><input type="tel" name="mobile" class="form-control"></div>
      <div class="mb-2">
        <label class="form-label">Branch</label>
        <select name="branchId" class="form-select">
          <option value="">—</option>
          <% branches.forEach(function(b) { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
        </select>
      </div>
      <div class="mb-2"><label class="form-label">Temporary Password</label><input type="text" name="temporaryPassword" class="form-control" minlength="8" required></div>
      <div class="mb-2">
        <label class="form-label">Roles</label>
        <% roles.forEach(function(r) { %>
          <div class="form-check"><input class="form-check-input" type="checkbox" name="roleIds" value="<%= r.id %>"><label class="form-check-label"><%= r.name %></label></div>
        <% }) %>
      </div>
    </div>
    <div class="modal-footer"><button type="submit" class="btn btn-primary">Create</button></div>
  </form></div>
</div>
