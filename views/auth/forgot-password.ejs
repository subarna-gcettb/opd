<div class="card shadow-sm auth-card"><div class="card-body p-4"><h4>Forgot Password</h4><%- include('../partials/flash') %><% if (typeof query !== 'undefined' && query) { %><% } %><form method="POST" action="/auth/forgot-password/request-otp"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" type="email" name="email" placeholder="Patient account email" required><button class="btn btn-outline-primary w-100 mt-3">Send OTP</button></form><hr><form method="POST" action="/auth/forgot-password/reset"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control mb-2" type="email" name="email" placeholder="Email" required><input class="form-control mb-2" name="otp" placeholder="6-digit OTP" maxlength="6" required><input class="form-control mb-2" type="password" name="newPassword" placeholder="New password" minlength="8" required><input class="form-control" type="password" name="confirmPassword" placeholder="Confirm password" minlength="8" required><button class="btn btn-primary w-100 mt-3">Reset Password</button></form><a href="/auth/login" class="btn btn-link w-100 mt-2">Back to sign in</a></div></div>