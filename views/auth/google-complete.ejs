<div class="card shadow-sm auth-card"><div class="card-body p-4"><h4>Complete Patient Sign Up</h4><p class="text-muted">Google verified <strong><%= googlePending.email %></strong>. Add the minimum details needed for your patient record.</p><%- include('../partials/flash') %><form method="POST" action="/auth/google/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control mb-2" value="<%= googlePending.name %>" readonly><select class="form-select mb-2" name="gender" required><option value="">Gender</option><option>Male</option><option>Female</option><option>Other</option></select><input class="form-control" name="mobile" placeholder="10-digit mobile" inputmode="numeric" required><button class="btn btn-primary w-100 mt-3">Create Patient Account</button></form></div></div>