<div class="card shadow-sm auth-card"><div class="card-body p-4">
<div class="text-center mb-3">
  <img src="/images/chhayabithi-logo.webp" alt="Chhayabithi" class="login-logo" width="240" height="68">
  <p class="text-muted small mt-2">Patient & Hospital Portal</p>
</div>
<%- include('../partials/flash') %>
<div class="text-center text-muted small mb-2">Sign in with password</div>
<form method="POST" action="/auth/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input class="form-control mb-2" name="identifier" placeholder="Email, phone number or Health ID" required>
<input class="form-control mb-2" type="password" name="password" placeholder="Password" required>
<button class="btn btn-primary w-100">Sign In</button></form>
<div class="text-center mt-3"><a href="/auth/forgot-password">Forgot password?</a></div>
<hr><div class="text-center small">Patient new here? <a href="/auth/signup">Create an account</a></div>
<% if (otpMode) { %><div class="alert alert-info small">Enter the 6-digit code sent to <strong><%= otpEmail %></strong>. It expires in 10 minutes.</div><form method="POST" action="/auth/login/verify-otp"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control text-center fs-4 mb-2" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="6-digit OTP" aria-label="6-digit email OTP" required><button class="btn btn-success w-100" type="submit">Verify OTP & Sign In</button></form><div class="text-center small mt-2"><a href="/auth/login">Use password instead</a></div><hr><% } %><div class="border-top mt-3 pt-3"><div class="small text-muted mb-2">Email OTP login</div><form method="POST" action="/auth/login/request-otp" class="d-flex gap-2"><input class="form-control" type="email" name="email" autocomplete="email" placeholder="Your email" required><button class="btn btn-outline-primary" type="submit">Send OTP</button></form><div class="form-text">We’ll email you a 6-digit code. The code is valid for 10 minutes.</div></div>
</div></div>