<div class="card shadow-sm auth-card"><div class="card-body p-4">
<div class="text-center mb-3"><i class="bi bi-hospital fs-1 text-primary"></i><h4>Chhayabithi HMS</h4><p class="text-muted small">Patient & Hospital Portal</p></div>
<%- include('../partials/flash') %>
<a href="/auth/google" class="btn btn-outline-dark w-100 mb-3"><i class="bi bi-google"></i> Continue with Google</a>
<div class="text-center text-muted small mb-2">or sign in with password</div>
<form method="POST" action="/auth/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input class="form-control mb-2" name="identifier" placeholder="Email, phone number or Health ID" required>
<input class="form-control mb-2" type="password" name="password" placeholder="Password" required>
<button class="btn btn-primary w-100">Sign In</button></form>
<div class="text-center mt-3"><a href="/auth/forgot-password">Forgot password?</a></div>
<hr><div class="text-center small">Patient new here? <a href="/auth/signup">Create an account</a></div>
<div class="border-top mt-3 pt-3"><div class="small text-muted mb-2">Email OTP login</div><form method="POST" action="/auth/login/request-otp" class="d-flex gap-2"><input class="form-control" type="email" name="email" placeholder="Your email" required><button class="btn btn-outline-primary">Send OTP</button></form></div>
</div></div>