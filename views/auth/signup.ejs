<div class="card shadow-sm auth-card"><div class="card-body p-4"><div class="text-center mb-3"><i class="bi bi-person-plus fs-1 text-primary"></i><h4>Patient Sign Up</h4><p class="text-muted small">Create your Chhayabithi patient portal account.</p></div><%- include('../partials/flash') %><form method="POST" action="/auth/signup/request-otp"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-2"><div class="col-12"><input class="form-control" name="name" placeholder="Full name" required></div><div class="col-6"><select class="form-select" name="gender" required><option value="">Gender</option><option>Male</option><option>Female</option><option>Other</option></select></div><div class="col-6"><input class="form-control" name="mobile" placeholder="10-digit mobile" inputmode="numeric" required></div><div class="col-12"><input class="form-control" type="email" name="email" placeholder="Email address" required></div><div class="col-6"><input class="form-control" type="password" name="password" placeholder="Password" minlength="8" required></div><div class="col-6"><input class="form-control" type="password" name="confirmPassword" placeholder="Confirm password" minlength="8" required></div></div><button class="btn btn-primary w-100 mt-3">Send Email OTP</button></form><div class="text-center small mt-3">Already registered? <a href="/auth/login">Sign in</a></div></div></div>