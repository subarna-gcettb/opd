<div class="card shadow-sm auth-card"><div class="card-body p-4"><h4>Verify your email</h4><p class="text-muted">Enter the 6-digit OTP sent to <strong><%= email %></strong>.</p><%- include('../partials/flash') %><form method="POST" action="/auth/verify-signup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= email %>"><input class="form-control text-center fs-4 letter-spacing" name="otp" inputmode="numeric" maxlength="6" required autofocus><button class="btn btn-primary w-100 mt-3">Verify & Create Account</button></form><a href="/auth/signup" class="btn btn-link w-100 mt-2">Start again</a></div></div>