<% const can = (p) => currentUser && currentUser.permissions.includes(p); %>

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0">Invoice <code><%= invoice.invoice_number %></code></h4>
    <div class="text-muted"><%= invoice.patient_name %> (<code><%= invoice.health_id %></code>) &middot; <%= invoice.doctor_name %> &middot; <%= invoice.department_name %></div>
  </div>
  <div class="d-flex gap-2">
    <a href="/billing/invoices/<%= invoice.id %>/print" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Print Invoice</a>
    <span class="badge fs-6 text-bg-<%= invoice.status === 'PAID' ? 'success' : 'secondary' %> align-self-center"><%= invoice.status.replace('_',' ') %></span>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card mb-3">
      <div class="card-header">Line Items</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Description</th><th class="text-end">Amount</th></tr></thead>
          <tbody>
            <% items.forEach(function(it) { %>
              <tr><td><%= it.description %></td><td class="text-end">₹<%= Number(it.amount).toFixed(2) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-between"><span>Gross Amount</span><strong>₹<%= Number(invoice.gross_amount).toFixed(2) %></strong></div>
        <div class="d-flex justify-content-between text-danger"><span>Discount</span><strong>-₹<%= Number(invoice.discount_amount).toFixed(2) %></strong></div>
        <div class="d-flex justify-content-between border-top pt-2 mt-1"><span>Net Amount</span><strong class="fs-5">₹<%= Number(invoice.net_amount).toFixed(2) %></strong></div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">Discount Requests</div>
      <ul class="list-group list-group-flush">
        <% discountRequests.forEach(function(dr) { %>
          <li class="list-group-item small">
            <div class="d-flex justify-content-between">
              <span>
                <%= dr.requested_amount ? '₹' + Number(dr.requested_amount).toFixed(2) : dr.requested_percentage + '%' %>
                — <%= dr.reason %>
              </span>
              <span class="badge text-bg-<%= dr.status === 'APPROVED' ? 'success' : (dr.status === 'REJECTED' ? 'danger' : 'warning') %>"><%= dr.status %></span>
            </div>
            <div class="text-muted">Requested by <%= dr.requested_by_name %> on <%= new Date(dr.requested_at).toLocaleString() %>
              <% if (dr.approved_by_name) { %> &middot; Decided by <%= dr.approved_by_name %><% } %>
            </div>
            <% if (dr.rejection_reason) { %><div class="text-danger">Reason: <%= dr.rejection_reason %></div><% } %>
          </li>
        <% }) %>
        <% if (discountRequests.length === 0) { %><li class="list-group-item text-muted text-center small py-3">No discount requests.</li><% } %>
      </ul>
      <% if (can('discount.request') && invoice.status !== 'PAID' && !discountRequests.some(d => d.status === 'PENDING')) { %>
        <div class="card-body border-top">
          <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#discountModal"><i class="bi bi-percent"></i> Request Discount</button>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card mb-3">
      <div class="card-header">Payments</div>
      <ul class="list-group list-group-flush">
        <% payments.forEach(function(p) { %>
          <li class="list-group-item small d-flex justify-content-between align-items-center">
            <div>
              <strong>₹<%= Number(p.amount).toFixed(2) %></strong> via <%= p.method %>
              <div class="text-muted"><%= p.payment_code %> &middot; <%= new Date(p.paid_at).toLocaleString() %></div>
            </div>
            <a href="/billing/invoices/<%= invoice.id %>/receipt/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary">Receipt</a>
          </li>
        <% }) %>
        <% if (payments.length === 0) { %><li class="list-group-item text-muted text-center small py-3">No payments recorded yet.</li><% } %>
      </ul>

      <% if (can('payment.record') && invoice.status !== 'PAID' && invoice.status !== 'CANCELLED') { %>
        <div class="card-body border-top">
          <% const hasPending = discountRequests.some(d => d.status === 'PENDING'); %>
          <% if (hasPending) { %>
            <div class="alert alert-warning small mb-0">A discount request is pending Super Admin approval. Payment cannot be recorded until it is decided.</div>
          <% } else { %>
            <form method="POST" action="/billing/invoices/<%= invoice.id %>/payment">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-2">
                <label class="form-label small">Amount</label>
                <input type="number" step="0.01" name="amount" class="form-control" value="<%= invoice.net_amount %>" readonly>
              </div>
              <div class="mb-2">
                <label class="form-label small">Payment Method</label>
                <select name="method" class="form-select" id="methodSelect" required>
                  <option value="CASH">Cash</option>
                  <option value="UPI">UPI</option>
                  <option value="CARD">Card</option>
                </select>
              </div>
              <div class="mb-2" id="refField" style="display:none;">
                <label class="form-label small">Transaction / Reference Number</label>
                <input type="text" name="referenceNumber" class="form-control">
              </div>
              <button type="submit" class="btn btn-primary w-100">Record Payment</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="modal fade" id="discountModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/billing/invoices/<%= invoice.id %>/discount-request" class="modal-content">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h5 class="modal-title">Request Discount</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Discount Amount (₹)</label>
          <input type="number" step="0.01" name="amount" class="form-control">
        </div>
        <div class="text-center text-muted small mb-2">— OR —</div>
        <div class="mb-3">
          <label class="form-label">Discount Percentage (%)</label>
          <input type="number" step="0.01" name="percentage" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">Reason *</label>
          <textarea name="reason" class="form-control" rows="2" required></textarea>
        </div>
        <div class="alert alert-info small mb-0">This request will be sent to a Super Admin for approval. You cannot approve your own request.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-warning">Submit Request</button>
      </div>
    </form>
  </div>
</div>

<script>
  const methodSelect = document.getElementById('methodSelect');
  const refField = document.getElementById('refField');
  if (methodSelect) {
    methodSelect.addEventListener('change', function () {
      refField.style.display = methodSelect.value === 'CASH' ? 'none' : 'block';
    });
  }
</script>
