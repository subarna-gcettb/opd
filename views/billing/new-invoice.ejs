<h4 class="mb-3">Generate Invoice</h4>

<div class="card mb-3">
  <div class="card-body small">
    <strong>Patient:</strong> <%= visit.patient_name %> (<code><%= visit.health_id %></code>) &middot;
    <strong>Doctor:</strong> <%= visit.doctor_name %> &middot; <strong>Department:</strong> <%= visit.department_name %>
  </div>
</div>

<form method="POST" action="/billing/invoices/new" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="visitId" value="<%= visit.id %>">
  <div class="card-body">
    <table class="table">
      <thead><tr><th>Description</th><th class="text-end">Amount (₹)</th></tr></thead>
      <tbody>
        <tr><td>OPD Consultation Fee</td><td class="text-end"><%= Number(visit.consultation_fee).toFixed(2) %></td></tr>
      </tbody>
      <tbody id="otherCharges"></tbody>
    </table>
    <button type="button" id="addChargeBtn" class="btn btn-sm btn-outline-secondary">+ Add Other Charge</button>
  </div>
  <div class="card-footer d-flex justify-content-end gap-2">
    <a href="/opd/queue" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">Create Invoice</button>
  </div>
</form>

<script>
document.getElementById('addChargeBtn').addEventListener('click', function () {
  const tbody = document.getElementById('otherCharges');
  const row = document.createElement('tr');
  row.innerHTML = '<td><input type="text" name="otherDescription" class="form-control form-control-sm" placeholder="e.g. Dressing charge"></td>' +
    '<td><input type="number" step="0.01" name="otherAmount" class="form-control form-control-sm text-end"></td>';
  tbody.appendChild(row);
});
</script>
