<%
  const isFinalized = visit.status === 'COMPLETED';
  const c = consultation || {};
  const hasPrescription = currentPrescriptions && currentPrescriptions.length > 0;
%>

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0"><%= visit.patient_name %>
      <span class="token-badge ms-2"><%= String(visit.token_number).padStart(3,'0') %></span>
    </h4>
    <div class="text-muted">
      <code><%= visit.health_id %></code> &middot; <%= visit.age_years || '—' %>/<%= visit.gender %> &middot;
      <%= visit.department_name %> &middot; Visit <%= visit.visit_code %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/patients/<%= visit.health_id %>" class="btn btn-outline-secondary btn-sm">Full Profile</a>
    <% if (!isFinalized) { %>
      <form method="POST" action="/doctor/consultation/<%= visit.id %>/complete" data-confirm="Complete this consultation? The clinical record will be finalized and can no longer be edited.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-success btn-sm"><i class="bi bi-check2-all"></i> Complete Consultation</button>
      </form>
    <% } %>
  </div>
</div>

<% if (isFinalized) { %>
  <div class="alert alert-secondary"><i class="bi bi-lock"></i> This consultation is finalized. The clinical record is read-only; corrections to the prescription must go through an amendment.</div>
<% } %>

<% if (String(visit.gender || '').toLowerCase() === 'female') { %>
<div class="pregnancy-doctor-card mb-3">
  <div class="pregnancy-doctor-card__head">
    <div><span class="small text-uppercase fw-bold">Female / Obstetric Assessment</span><h5 class="mb-0 mt-1"><i class="bi bi-gender-female me-1"></i> Pregnancy information</h5></div>
    <span class="badge text-bg-<%= visit.pregnancy_status === 'PREGNANT' ? 'success' : 'secondary' %>"><%= visit.pregnancy_status || 'UNKNOWN' %></span>
  </div>
  <div class="row g-2 mt-1 small">
    <div class="col-6 col-md-3"><strong>LMP</strong><span><%= visit.lmp_date ? new Date(visit.lmp_date).toLocaleDateString() : '—' %></span></div>
    <div class="col-6 col-md-3"><strong>Gravida (G)</strong><span><%= visit.gravida ?? '—' %></span></div>
    <div class="col-6 col-md-3"><strong>Para (P)</strong><span><%= visit.para ?? '—' %></span></div>
    <div class="col-6 col-md-3"><strong>Abortions (A)</strong><span><%= visit.abortions ?? '—' %></span></div>
    <% if (pregnancyCalculation) { %>
      <div class="col-6 col-md-3"><strong>Gestational age</strong><span><%= pregnancyCalculation.gestationalAgeLabel %></span></div>
      <div class="col-6 col-md-3"><strong>EDD</strong><span><%= pregnancyCalculation.estimatedDueDate %></span></div>
      <div class="col-6 col-md-3"><strong>Trimester</strong><span><%= pregnancyCalculation.trimester %></span></div>
      <div class="col-6 col-md-3"><strong>Remaining</strong><span><%= pregnancyCalculation.remainingWeeks %>w <%= pregnancyCalculation.remainingExtraDays %>d</span></div>
      <div class="col-12"><strong>Status</strong><span><%= pregnancyCalculation.termStatus %></span></div>
    <% } %>
    <% if (visit.obstetric_notes) { %><div class="col-12"><strong>Obstetric notes</strong><span><%= visit.obstetric_notes %></span></div><% } %>
  </div>
</div>
<% } %>
<% if (appointmentVitals) { %>
<div class="card mb-3 border-primary-subtle">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-heart-pulse me-1"></i> Receptionist-collected Vitals</span>
    <span class="badge text-bg-primary">Recorded</span>
  </div>
  <div class="card-body">
    <div class="row g-2">
      <div class="col-6 col-md-3"><div class="small text-muted">BP</div><strong><%= appointmentVitals.bp || '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">Pulse</div><strong><%= appointmentVitals.pulse ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">Temp (°F)</div><strong><%= appointmentVitals.temperature ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">SpO2 (%)</div><strong><%= appointmentVitals.spo2 ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">Weight (kg)</div><strong><%= appointmentVitals.weight_kg ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">Height (cm)</div><strong><%= appointmentVitals.height_cm ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">Respiratory rate</div><strong><%= appointmentVitals.respiratory_rate ?? '—' %></strong></div>
      <div class="col-6 col-md-3"><div class="small text-muted">BMI</div><strong id="receptionistBmi">—</strong></div>
    </div>
    <% if (appointmentVitals.recorded_at) { %>
      <div class="small text-muted mt-2">Recorded at <%= appointmentVitals.recorded_at %></div>
    <% } %>
  </div>
</div>
<% } %>

<% if (visit.allergies) { %>
  <div class="alert alert-danger"><strong><i class="bi bi-exclamation-triangle"></i> Allergies:</strong> <%= visit.allergies %></div>
<% } %>

<div class="row g-3">
  <!-- LEFT: consultation form -->
  <div class="col-lg-8">
    <form method="POST" action="/doctor/consultation/<%= visit.id %>" class="card mb-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header">Consultation</div>
      <div class="card-body">
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center gap-2">
            <label class="form-label mb-1">Chief Complaint</label>
            <span class="badge text-bg-light border">Press Enter to add a complaint</span>
          </div>
          <input type="hidden" name="complaints" id="complaintValue">
          <div id="complaintTags" class="d-flex flex-wrap gap-2 mb-2"></div>
          <% if (!isFinalized) { %>
            <div class="position-relative">
              <input type="text" id="complaintInput" class="form-control" autocomplete="off" placeholder="Type a chief complaint and press Enter..." aria-label="Chief complaint">
              <div id="complaintSuggestions" class="list-group position-absolute w-100 shadow-sm" style="z-index:20;display:none;max-height:220px;overflow:auto;"></div>
            </div>
            <div class="small text-muted mt-1">Existing complaints appear as suggestions. New complaints are saved to your doctor-specific suggestion list.</div>
          <% } %>
        </div>
        <div class="mb-3">
          <h6 class="text-uppercase text-muted small mb-2">Personal History</h6>
          <input type="hidden" name="personalHistory" id="personalHistoryValue">
          <div class="row g-2">
            <div class="col-md-4"><label class="form-label small">Surgery</label><select id="phSurgery" class="form-select form-select-sm" <%= isFinalized ? 'disabled' : '' %>><option value="NO">No</option><option value="YES">Yes</option><option value="OTHER">Other</option></select><input id="phSurgeryOther" class="form-control form-control-sm mt-1" placeholder="Surgery details" style="display:none" <%= isFinalized ? 'readonly' : '' %>></div>
            <div class="col-md-4"><label class="form-label small">Sleep</label><select id="phSleep" class="form-select form-select-sm" <%= isFinalized ? 'disabled' : '' %>><option value="NORMAL">Normal</option><option value="DISTURBED">Disturbed</option><option value="INSOMNIA">Insomnia</option><option value="EXCESSIVE">Excessive</option><option value="OTHER">Other</option></select><input id="phSleepOther" class="form-control form-control-sm mt-1" placeholder="Sleep details" style="display:none" <%= isFinalized ? 'readonly' : '' %>></div>
            <div class="col-md-4"><label class="form-label small">Drinking / Alcohol</label><select id="phDrinking" class="form-select form-select-sm" <%= isFinalized ? 'disabled' : '' %>><option value="NO">No</option><option value="YES">Yes</option><option value="OCCASIONAL">Occasional</option><option value="OTHER">Other</option></select><input id="phDrinkingOther" class="form-control form-control-sm mt-1" placeholder="Drinking details" style="display:none" <%= isFinalized ? 'readonly' : '' %>></div>
            <div class="col-md-4"><label class="form-label small">Bowel</label><select id="phBowel" class="form-select form-select-sm" <%= isFinalized ? 'disabled' : '' %>><option value="REGULAR">Regular</option><option value="CONSTIPATION">Constipation</option><option value="DIARRHEA">Diarrhea</option><option value="IRREGULAR">Irregular</option><option value="OTHER">Other</option></select><input id="phBowelOther" class="form-control form-control-sm mt-1" placeholder="Bowel details" style="display:none" <%= isFinalized ? 'readonly' : '' %>></div>
            <div class="col-12"><div class="d-flex justify-content-between align-items-center"><label class="form-label small mb-1">Additional history</label><% if (!isFinalized) { %><button type="button" class="btn btn-sm btn-outline-secondary" id="addHistoryItem"><i class="bi bi-plus"></i> Add item</button><% } %></div><div id="customHistoryItems" class="row g-2"></div></div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Symptoms</label>
          <textarea name="symptoms" class="form-control" rows="2" <%= isFinalized ? 'readonly' : '' %>><%= c.symptoms || '' %></textarea>
        </div>

        <h6 class="text-uppercase text-muted small mt-4 mb-2">Vitals</h6>
        <div class="row g-2">
          <div class="col-6 col-md-2"><label class="form-label small">BP</label><input type="text" name="bp" class="form-control form-control-sm" placeholder="120/80" value="<%= c.bp || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">Pulse</label><input type="number" name="pulse" class="form-control form-control-sm" value="<%= c.pulse || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">Temp (°F)</label><input type="number" step="0.1" name="temperature" class="form-control form-control-sm" value="<%= c.temperature || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">SpO2 (%)</label><input type="number" name="spo2" class="form-control form-control-sm" value="<%= c.spo2 || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">Weight (kg)</label><input type="number" step="0.1" name="weightKg" class="form-control form-control-sm" value="<%= c.weight_kg || visit.profile_weight || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">Height (cm)</label><input type="number" step="0.1" name="heightCm" id="consultHeightCm" class="form-control form-control-sm" value="<%= c.height_cm || visit.profile_height || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">Respiratory rate</label><input type="number" name="respiratoryRate" class="form-control form-control-sm" value="<%= c.respiratory_rate || '' %>" <%= isFinalized ? 'readonly' : '' %>></div>
          <div class="col-6 col-md-2"><label class="form-label small">BMI</label><div class="form-control form-control-sm bg-light fw-semibold" id="consultBmi">—</div></div>
        </div>

        <h6 class="text-uppercase text-muted small mt-4 mb-2">Clinical</h6>
        <div class="mb-3">
          <label class="form-label">Allergies (update if changed)</label>
          <input type="text" name="allergies" class="form-control" value="<%= visit.allergies || '' %>" <%= isFinalized ? 'readonly' : '' %>>
        </div>
        <div class="mb-3">
          <label class="form-label">Diagnosis</label>
          <textarea name="diagnosis" class="form-control" rows="2" <%= isFinalized ? 'readonly' : '' %>><%= c.diagnosis || '' %></textarea>
        </div>
        <div class="mb-3">
          <div class="form-check form-switch border rounded p-3 bg-light-subtle">
            <input class="form-check-input" type="checkbox" role="switch" id="complementaryRequested" name="complementaryRequested" value="1" <%= complementaryRequested ? 'checked' : '' %> <%= isFinalized ? 'disabled' : '' %>>
            <label class="form-check-label" for="complementaryRequested"><strong>Complementary consultation</strong><span class="d-block small text-muted">Internal billing flag only. This requests a 100% discount and is not shown as “complementary” to the patient.</span></label>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Clinical Notes</label>
          <textarea name="clinicalNotes" class="form-control" rows="3" <%= isFinalized ? 'readonly' : '' %>><%= c.clinical_notes || '' %></textarea>
        </div>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label">Investigation Advice</label>
            <textarea name="investigationAdvice" class="form-control" rows="2" <%= isFinalized ? 'readonly' : '' %>><%= c.investigation_advice || '' %></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label">Follow-up Date</label>
            <input type="date" name="followUpDate" class="form-control" value="<%= c.follow_up_date || '' %>" <%= isFinalized ? 'readonly' : '' %>>
          </div>
        </div>
      </div>
      <% if (!isFinalized) { %>
        <div class="card-footer text-end"><button type="submit" class="btn btn-primary">Save Consultation</button></div>
      <% } %>
    </form>

    <% if (invoice) { %>
      <div class="card mb-3 border-warning">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-receipt"></i> OPD Billing</span>
          <span class="badge text-bg-<%= invoice.status === 'PAID' ? 'success' : 'secondary' %>"><%= invoice.status %></span>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div><strong><%= invoice.invoice_number %></strong><div class="small text-muted">Net ₹<%= Number(invoice.net_amount).toFixed(2) %></div></div>
            <a href="/billing/invoices/<%= invoice.id %>" class="btn btn-sm btn-outline-warning">View / Request Discount</a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- PRESCRIPTION -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Prescription</span>
        <% if (hasPrescription) { %>
          <a href="/prescriptions/<%= currentPrescriptions[0].id %>" class="btn btn-sm btn-outline-primary">
            Open <%= currentPrescriptions[0].prescription_code %> (v<%= currentPrescriptions[0].version %>)
          </a>
        <% } %>
      </div>
      <div class="card-body">
        <% if (hasPrescription) { %>
          <div class="alert alert-info mb-0">
            A prescription already exists for this visit. Open it to view, print, or amend it — finalized prescriptions are never overwritten.
          </div>
        <% } else if (isFinalized) { %>
          <div class="text-muted">No prescription was issued for this visit.</div>
        <% } else { %>
          <form method="POST" action="/prescriptions" id="rxForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="visitId" value="<%= visit.id %>">

            <datalist id="medicineList">
              <% medicines.forEach(function(m) { %>
                <option value="<%= m.name %>" label="<%= [m.strength, m.composition, m.form].filter(Boolean).join(' · ') %>"></option>
              <% }) %>
            </datalist>

            <div class="table-responsive">
              <table class="table table-sm align-middle" id="rxTable">
                <thead><tr><th style="min-width:190px;">Medicine *</th><th style="min-width:150px;">Composition</th><th>Type</th><th>Dosage</th><th style="min-width:190px;">Frequency</th><th>Days</th><th>Route</th><th>Qty</th><th style="min-width:150px;">Instructions</th><th></th></tr></thead>
                <tbody id="rxBody"></tbody>
              </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="addRowBtn"><i class="bi bi-plus-lg"></i> Add Medicine</button>
            <div class="text-end mt-3">
              <button type="submit" class="btn btn-primary"><i class="bi bi-file-earmark-medical"></i> Create Prescription</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- RIGHT: history -->
  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-header">Patient Summary</div>
      <div class="card-body small">
        <div><strong>Blood Group:</strong> <%= visit.blood_group || '—' %></div>
        <div><strong>Mobile:</strong> <%= visit.mobile %></div>
        <div><strong>Existing Conditions:</strong> <%= visit.existing_conditions || 'None recorded' %></div>
        <div><strong>Appointment:</strong> <%= visit.appointment_code %></div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">Previous Visits</div>
      <div class="card-body p-0" style="max-height: 340px; overflow-y: auto;">
        <ul class="list-group list-group-flush">
          <% previousVisits.forEach(function(v) { %>
            <li class="list-group-item small">
              <div class="d-flex justify-content-between">
                <strong><%= new Date(v.checked_in_at).toLocaleDateString() %></strong>
                <span class="text-muted"><%= v.doctor_name %></span>
              </div>
              <div><strong>Dx:</strong> <%= v.diagnosis || '—' %></div>
              <% if (v.bp || v.pulse || v.weight_kg) { %>
                <div class="text-muted">
                  <%= v.bp ? 'BP ' + v.bp : '' %>
                  <%= v.pulse ? ' · Pulse ' + v.pulse : '' %>
                  <%= v.weight_kg ? ' · ' + v.weight_kg + ' kg' : '' %>
                </div>
              <% } %>
            </li>
          <% }) %>
          <% if (previousVisits.length === 0) { %>
            <li class="list-group-item text-muted small text-center py-3">First visit — no prior history.</li>
          <% } %>
        </ul>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Previous Prescriptions</div>
      <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
        <ul class="list-group list-group-flush">
          <% previousPrescriptions.forEach(function(p) { %>
            <li class="list-group-item small d-flex justify-content-between align-items-center">
              <div>
                <div><strong><%= new Date(p.created_at).toLocaleDateString() %></strong> — <%= p.doctor_name %></div>
                <div class="text-muted"><%= p.diagnosis || p.prescription_code %></div>
              </div>
              <a href="/prescriptions/<%= p.id %>/print" target="_blank" class="btn btn-sm btn-outline-secondary">View</a>
            </li>
          <% }) %>
          <% if (previousPrescriptions.length === 0) { %>
            <li class="list-group-item text-muted small text-center py-3">No previous prescriptions.</li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const body = document.getElementById('rxBody');
  if (!body) return;
  const formOptions = <%- JSON.stringify(formOptions || []) %>;
  const routeOptions = <%- JSON.stringify(routeOptions || []) %>;
  const medicineCatalog = <%- JSON.stringify(medicines || []) %>;
  const freq = ['OD','BD','TDS','QDS','SOS'];
  function esc(v){return String(v || '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
  function optionList(items){return items.map(x=>'<option value="'+esc(x)+'">'+esc(x)+'</option>').join('');}
  function rowHtml(){
    return '<tr>'+
      '<td><input type="text" name="medicineName" class="form-control form-control-sm" list="medicineList" required></td>'+
      '<td><input type="text" name="composition" class="form-control form-control-sm" placeholder="Composition"></td>'+
      '<td><select name="medicineForm" class="form-select form-select-sm medicine-form"><option value="">Select</option>'+optionList(formOptions)+'<option value="__OTHER__">+ Add type</option></select><input type="text" class="form-control form-control-sm mt-1 custom-form" placeholder="New type" style="display:none"></td>'+
      '<td><input type="text" name="dosage" class="form-control form-control-sm" placeholder="1"></td>'+
      '<td><div class="d-flex flex-wrap gap-1 frequency-pills">'+freq.map(x=>'<label class="badge rounded-pill text-bg-light border"><input type="checkbox" class="frequency-check me-1" value="'+x+'">'+x+'</label>').join('')+'</div><input type="hidden" name="frequency" class="frequency-value"></td>'+
      '<td><input type="number" name="duration" class="form-control form-control-sm" min="1" step="1" placeholder="7"></td>'+
      '<td><select name="route" class="form-select form-select-sm route-select"><option value="">Select</option>'+optionList(routeOptions)+'<option value="__OTHER__">+ Add route</option></select><span class="badge rounded-pill route-badge mt-1">Route</span><input type="text" class="form-control form-control-sm mt-1 custom-route" placeholder="New route" style="display:none"></td>'+
      '<td><input type="text" name="quantity" class="form-control form-control-sm" placeholder="14"></td>'+
      '<td><input type="text" name="instructions" class="form-control form-control-sm" placeholder="Before food"></td>'+
      '<td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td></tr>';
  }
  function syncFrequency(row){row.querySelector('.frequency-value').value=Array.from(row.querySelectorAll('.frequency-check:checked')).map(x=>x.value).join(', ');}
  function syncCustom(select,cls){const row=select.closest('tr'),input=row.querySelector(cls),other=select.value==='__OTHER__';input.style.display=other?'block':'none';if(other)input.focus();else input.value='';updateRouteBadge(row);}
  function updateRouteBadge(row){const s=row.querySelector('.route-select'),b=row.querySelector('.route-badge');if(!b)return;const v=s.value;b.textContent=v==='__OTHER__'?'Custom':(v||'Route');b.className='badge rounded-pill route-badge mt-1 '+({'P/O':'route-po','P/V':'route-pv','S/L':'route-sl','PR':'route-pr','I/V':'route-iv','I/M':'route-im','S/C':'route-sc'}[v]||'route-other');}
  function populateMedicine(row){const input=row.querySelector('input[name="medicineName"]');if(!input)return;const q=input.value.trim().toLowerCase();const m=medicineCatalog.find(x=>String(x.name||'').toLowerCase()===q || (String(x.name||'')+' '+String(x.strength||'')).trim().toLowerCase()===q);if(m){const comp=row.querySelector('input[name="composition"]');if(comp&&!comp.value)comp.value=m.composition||m.strength||'';const fs=row.querySelector('.medicine-form');if(fs&&!fs.value&&m.form){const match=Array.from(fs.options).find(o=>o.value.toLowerCase()===String(m.form).toLowerCase());if(match)fs.value=match.value;}}}
  function addRow(){body.insertAdjacentHTML('beforeend',rowHtml());}
  addRow();
  document.getElementById('addRowBtn').addEventListener('click',addRow);
  body.addEventListener('change',e=>{const row=e.target.closest('tr');if(!row)return;if(e.target.classList.contains('frequency-check'))syncFrequency(row);if(e.target.classList.contains('medicine-form'))syncCustom(e.target,'.custom-form');if(e.target.classList.contains('route-select'))syncCustom(e.target,'.custom-route');});
  body.addEventListener('input',e=>{if(e.target.name==='medicineName')populateMedicine(e.target.closest('tr'));});
  body.addEventListener('click',e=>{if(e.target.classList.contains('remove-row')&&body.rows.length>1)e.target.closest('tr').remove();});
  document.getElementById('rxForm').addEventListener('submit',()=>{body.querySelectorAll('tr').forEach(row=>{const f=row.querySelector('.medicine-form'),rt=row.querySelector('.route-select');if(f.value==='__OTHER__')f.value=row.querySelector('.custom-form').value.trim();if(rt.value==='__OTHER__')rt.value=row.querySelector('.custom-route').value.trim();syncFrequency(row);});});
})();
</script>

<script>
(function(){
  const value=document.getElementById('complaintValue'),tags=document.getElementById('complaintTags'),input=document.getElementById('complaintInput'),box=document.getElementById('complaintSuggestions'),form=document.querySelector('form[action^="/doctor/consultation/"]'),historyValue=document.getElementById('personalHistoryValue');
  if(!form)return;
  let complaints=<%- JSON.stringify(String(c.complaints || visit.reason || '').split(/[,;]+/).map(x=>x.trim()).filter(Boolean)) %>;
  const suggestions=<%- JSON.stringify((complaintSuggestions || []).map(x=>x.complaint)) %>;
  const ph=<%- JSON.stringify(personalHistory || {}) %>;
  function esc(v){return String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
  function sync(){complaints=[...new Set(complaints.map(x=>x.trim()).filter(Boolean))];value.value=complaints.join('; ');tags.innerHTML=complaints.map((x,i)=>'<span class="badge rounded-pill text-bg-primary d-inline-flex align-items-center gap-1">'+esc(x)+'<button type="button" class="btn-close btn-close-white btn-sm complaint-remove" data-index="'+i+'"></button></span>').join('');}
  function add(raw,save){const x=String(raw||'').trim().replace(/\s+/g,' ');if(!x||complaints.some(c=>c.toLowerCase()===x.toLowerCase()))return;complaints.push(x);sync();if(save)fetch('/doctor/complaints/suggestions',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({_csrf:'<%= csrfToken %>',complaint:x})}).catch(()=>{});}
  function render(q){if(!box)return;const list=suggestions.filter(x=>!complaints.some(c=>c.toLowerCase()===x.toLowerCase())&&(!q||x.toLowerCase().includes(q.toLowerCase()))).slice(0,12);box.innerHTML=list.map(x=>'<button type="button" class="list-group-item list-group-item-action complaint-suggestion">'+esc(x)+'</button>').join('');box.style.display=list.length?'block':'none';}
  if(input){input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();add(input.value,true);input.value='';render('');}});input.addEventListener('input',()=>render(input.value));input.addEventListener('focus',()=>render(input.value));}
  document.addEventListener('click',e=>{if(e.target.classList.contains('complaint-remove')){complaints.splice(Number(e.target.dataset.index),1);sync();}if(e.target.classList.contains('complaint-suggestion')){add(e.target.textContent,false);input.value='';render('');}if(box&&!box.contains(e.target)&&e.target!==input)box.style.display='none';});
  function setupOther(sid,iid){const s=document.getElementById(sid),i=document.getElementById(iid);if(!s||!i)return;const u=()=>{i.style.display=s.value==='OTHER'?'block':'none';};s.addEventListener('change',u);u();}
  setupOther('phSurgery','phSurgeryOther');setupOther('phSleep','phSleepOther');setupOther('phDrinking','phDrinkingOther');setupOther('phBowel','phBowelOther');
  const custom=document.getElementById('customHistoryItems');
  function addItem(k='',v=''){const row=document.createElement('div');row.className='col-md-6 d-flex gap-2';row.innerHTML='<input class="form-control form-control-sm ph-key" placeholder="Item" value="'+esc(k)+'"><input class="form-control form-control-sm ph-val" placeholder="Value" value="'+esc(v)+'"><button type="button" class="btn btn-sm btn-outline-danger ph-remove">&times;</button>';custom.appendChild(row);}
  (Array.isArray(ph.customItems)?ph.customItems:[]).forEach(x=>addItem(x.key,x.value));document.getElementById('addHistoryItem')?.addEventListener('click',()=>addItem());
  function syncHistory(){historyValue.value=JSON.stringify({surgery:{value:document.getElementById('phSurgery')?.value||'NO',other:document.getElementById('phSurgeryOther')?.value||''},sleep:{value:document.getElementById('phSleep')?.value||'NORMAL',other:document.getElementById('phSleepOther')?.value||''},drinking:{value:document.getElementById('phDrinking')?.value||'NO',other:document.getElementById('phDrinkingOther')?.value||''},bowel:{value:document.getElementById('phBowel')?.value||'REGULAR',other:document.getElementById('phBowelOther')?.value||''},customItems:Array.from(custom.children).map(r=>({key:r.querySelector('.ph-key').value.trim(),value:r.querySelector('.ph-val').value.trim()})).filter(x=>x.key||x.value)});}
  form.addEventListener('submit',syncHistory);custom.addEventListener('input',syncHistory);custom.addEventListener('click',e=>{if(e.target.classList.contains('ph-remove')){e.target.closest('.col-md-6').remove();syncHistory();}});
  if(ph.surgery){document.getElementById('phSurgery').value=ph.surgery.value||'NO';document.getElementById('phSurgeryOther').value=ph.surgery.other||'';}if(ph.sleep){document.getElementById('phSleep').value=ph.sleep.value||'NORMAL';document.getElementById('phSleepOther').value=ph.sleep.other||'';}if(ph.drinking){document.getElementById('phDrinking').value=ph.drinking.value||'NO';document.getElementById('phDrinkingOther').value=ph.drinking.other||'';}if(ph.bowel){document.getElementById('phBowel').value=ph.bowel.value||'REGULAR';document.getElementById('phBowelOther').value=ph.bowel.other||'';}['phSurgery','phSleep','phDrinking','phBowel'].forEach(id=>document.getElementById(id)?.dispatchEvent(new Event('change')));sync();syncHistory();
})();
</script>
<script>
(function () {
  const height = document.getElementById('consultHeightCm');
  const weight = document.querySelector('input[name="weightKg"]');
  const bmi = document.getElementById('consultBmi');
  if (!height || !weight || !bmi) return;
  function updateBMI() {
    const h = Number.parseFloat(height.value);
    const w = Number.parseFloat(weight.value);
    if (!Number.isFinite(h) || !Number.isFinite(w) || h <= 0 || w <= 0) {
      bmi.textContent = '—';
      return;
    }
    bmi.textContent = (w / Math.pow(h / 100, 2)).toFixed(1);
  }
  height.addEventListener('input', updateBMI);
  weight.addEventListener('input', updateBMI);
  updateBMI();
})();
</script>

<script>
(function () {
  const bmi = document.getElementById('receptionistBmi');
  if (!bmi) return;
  const height = Number.parseFloat('<%= appointmentVitals?.height_cm ?? "" %>');
  const weight = Number.parseFloat('<%= appointmentVitals?.weight_kg ?? "" %>');
  if (Number.isFinite(height) && Number.isFinite(weight) && height > 0 && weight > 0) {
    bmi.textContent = (weight / Math.pow(height / 100, 2)).toFixed(1);
  }
})();
</script>
