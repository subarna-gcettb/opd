<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Doctor Portal</h4>
  <a href="/doctor/profile" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-person-circle"></i> My Profile</a><a href="/doctor/queue" class="btn btn-primary btn-sm"><i class="bi bi-list-ol"></i> My Patients Today</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value"><%= stats.totalToday %></div><div class="stat-label">Today's Patients</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-secondary"><%= stats.waiting %></div><div class="stat-label">Waiting</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-warning"><%= stats.called %></div><div class="stat-label">Called</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-info"><%= stats.inConsultation %></div><div class="stat-label">In Consultation</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-success"><%= stats.completed %></div><div class="stat-label">Completed</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value"><%= stats.upcoming %></div><div class="stat-label">Upcoming</div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Today's Queue</span>
        <form method="POST" action="/doctor/queue/call-next">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-warning"><i class="bi bi-megaphone"></i> Call Next</button>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
          <thead><tr><th>Token</th><th>Patient</th><th>Age/Gender</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% queue.forEach(function(r) { %>
              <tr>
                <td><span class="token-badge"><%= String(r.token_number).padStart(3,'0') %></span></td>
                <td><%= r.patient_name %><div class="text-muted small"><%= r.health_id %></div></td>
                <td><%= r.age_years || '—' %>/<%= r.gender %></td>
                <td><span class="badge text-bg-secondary"><%= r.visit_status.replace('_',' ') %></span></td>
                <td><a href="/doctor/consultation/<%= r.visit_id %>" class="btn btn-sm btn-primary">Open</a></td>
              </tr>
            <% }) %>
            <% if (queue.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No patients in your queue today.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">Upcoming Appointments</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Date</th><th>Time</th><th>Patient</th></tr></thead>
          <tbody>
            <% upcoming.forEach(function(a) { %>
              <tr>
                <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
                <td><%= a.slot_time.slice(0,5) %></td>
                <td><%= a.patient_name %><div class="text-muted small"><%= a.health_id %></div></td>
              </tr>
            <% }) %>
            <% if (upcoming.length === 0) { %><tr><td colspan="3" class="text-center text-muted py-4">No upcoming appointments.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
