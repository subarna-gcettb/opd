<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h4 class="mb-0">Doctor Portal</h4>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <a href="/doctor/blogs" class="btn btn-success btn-sm"><i class="bi bi-journal-richtext me-1" aria-hidden="true"></i> My Blog</a>
    <a href="/doctor/profile" class="btn btn-outline-secondary btn-sm"><i class="bi bi-person-circle me-1" aria-hidden="true"></i> My Profile</a>
    <a href="/doctor/queue" class="btn btn-primary btn-sm"><i class="bi bi-list-ol me-1" aria-hidden="true"></i> My Patients Today</a>
  </div>
</div>

<section class="card border-primary shadow-sm mb-4" aria-labelledby="doctorBlogPanelTitle">
  <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 p-3 p-md-4">
    <div class="d-flex align-items-center gap-3">
      <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-journal-richtext fs-2" aria-hidden="true"></i></div>
      <div>
        <h5 class="mb-1" id="doctorBlogPanelTitle">Health Blog Publishing</h5>
        <p class="text-muted mb-0">Write patient-friendly health articles, add pictures or YouTube videos, and publish them on the hospital website.</p>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2 flex-shrink-0">
      <a href="/doctor/blogs" class="btn btn-outline-primary"><i class="bi bi-journal-medical me-1" aria-hidden="true"></i> My Blog</a>
      <a href="/doctor/blogs/new" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Write a Blog</a>
    </div>
  </div>
</section>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value"><%= stats.totalToday %></div><div class="stat-label">Today's Patients</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-secondary"><%= stats.waiting %></div><div class="stat-label">Waiting</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-warning"><%= stats.called %></div><div class="stat-label">Called</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-info"><%= stats.inConsultation %></div><div class="stat-label">In Consultation</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value text-success"><%= stats.completed %></div><div class="stat-label">Completed</div></div></div>
  <div class="col-6 col-md-2"><div class="stat-card"><div class="stat-value"><%= stats.upcoming %></div><div class="stat-label">Upcoming</div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Today's Queue</span>
        <form method="POST" action="/doctor/queue/call-next">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-warning"><i class="bi bi-megaphone"></i> Call Next</button>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
          <thead><tr><th>Token</th><th>Patient</th><th>Referral</th><th>Age/Gender</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% queue.forEach(function(r) { %>
              <tr>
                <td><span class="token-badge"><%= String(r.token_number).padStart(3,'0') %></span></td>
                <td><%= r.patient_name %><div class="text-muted small"><%= r.health_id %></div></td>
                <td><strong><%= r.referral_code || '—' %></strong><div class="text-muted small"><%= r.referral_provider_name || '' %></div></td>
                <td><%= r.age_years || '—' %>/<%= r.gender %></td>
                <td><span class="badge text-bg-secondary"><%= r.visit_status.replace('_',' ') %></span></td>
                <td><a href="/doctor/consultation/<%= r.visit_id %>" class="btn btn-sm btn-primary">Open</a></td>
              </tr>
            <% }) %>
            <% if (queue.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No patients in your queue today.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">Upcoming Appointments</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Referral</th></tr></thead>
          <tbody>
            <% upcoming.forEach(function(a) { %>
              <tr>
                <td><%= formatDate(a.appointment_date) %></td>
                <td><%= a.slot_time.slice(0,5) %></td>
                <td><%= a.patient_name %><div class="text-muted small"><%= a.health_id %></div></td>
                <td><strong><%= a.referral_code || '—' %></strong><div class="text-muted small"><%= a.referral_provider_name || '' %></div></td>
              </tr>
            <% }) %>
            <% if (upcoming.length === 0) { %><tr><td colspan="4" class="text-center text-muted py-4">No upcoming appointments.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
