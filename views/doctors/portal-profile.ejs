<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="mb-0">My Profile</h4>
    <div class="text-muted small">Update the personal and professional information shown to staff and patients.</div>
  </div>
  <a href="/doctor" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
</div>

<form method="POST" action="/doctor/profile" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-header"><i class="bi bi-person-badge"></i> Doctor Information</div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Full Name</label><input class="form-control" name="name" value="<%= doctor.name || '' %>" required></div>
      <div class="col-md-3"><label class="form-label">Gender</label><select class="form-select" name="gender"><option value="">—</option><% ['Male','Female','Other'].forEach(g => { %><option value="<%= g %>" <%= doctor.gender === g ? 'selected' : '' %>><%= g %></option><% }) %></select></div>
      <div class="col-md-3"><label class="form-label">Date of Birth</label><input type="date" class="form-control" name="dob" value="<%= doctor.dob || '' %>"></div>
      <div class="col-md-4"><label class="form-label">Mobile</label><input class="form-control" name="mobile" value="<%= doctor.mobile || '' %>"></div>
      <div class="col-md-8"><label class="form-label">Address</label><input class="form-control" name="address" value="<%= doctor.address || '' %>"></div>
      <div class="col-md-4"><label class="form-label">Professional Registration No.</label><input class="form-control" name="professionalRegNumber" value="<%= doctor.professional_reg_number || '' %>"></div>
      <div class="col-md-4"><label class="form-label">Qualification</label><input class="form-control" name="qualification" value="<%= doctor.qualification || '' %>"></div>
      <div class="col-md-4"><label class="form-label">Specialisation</label><input class="form-control" name="specialisation" value="<%= doctor.specialisation || '' %>"></div>
    </div>
    <div class="alert alert-light border mt-4 mb-0 small">
      <strong>Controlled by administration:</strong> doctor code, branch, department assignment, consultation fee, schedule and account activation.
    </div>
  </div>
  <div class="card-footer text-end"><button class="btn btn-primary"><i class="bi bi-check2"></i> Save Profile</button></div>
</form>
