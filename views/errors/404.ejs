<div class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-lg overflow-hidden"><div class="card-body text-center p-5"><div class="display-1 fw-bold text-primary">404</div><h1 class="h3 mt-3">Page Not Found</h1><p class="text-muted mb-4">The page you requested does not exist, may have moved, or may no longer be available.</p><% if (requestedPath) { %><div class="small text-muted mb-4"><code><%= requestedPath %></code></div><% } %><div class="d-flex justify-content-center gap-2 flex-wrap"><a href="<%= homeUrl || '/' %>" class="btn btn-primary"><i class="bi bi-house"></i> Go Home</a><button type="button" class="btn btn-outline-secondary" onclick="history.back()"><i class="bi bi-arrow-left"></i> Go Back</button></div></div></div></div></div></div>