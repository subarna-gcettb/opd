<div class="text-center text-white">
  <h1 class="display-3">Error</h1>
  <p><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></p>
  <% if (typeof showDetails !== 'undefined' && showDetails) { %>
    <pre class="text-start bg-dark text-white p-3 rounded" style="max-width: 700px; margin: 1rem auto; overflow:auto;"><%= showDetails %></pre>
  <% } %>
  <a href="/dashboard" class="btn btn-light">Go to Dashboard</a>
</div>
