<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4 class="mb-0">Laboratory Business Analytics</h4><div class="small text-muted">Collections, expenses, test counts and turnaround time.</div></div><a class="btn btn-outline-primary btn-sm" href="/lab/export.csv?from=<%= fromDate %>&to=<%= toDate %>">Export CSV</a></div>
<form method="GET" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="<%= fromDate %>" required></div><div class="col-md-4"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="<%= toDate %>" required></div><div class="col-md-4"><button class="btn btn-primary w-100">Apply dates</button></div></div></form>
<div class="row g-3 mb-3"><% [{label:'Collections',value:summary.collected},{label:'Expenses',value:summary.expenses},{label:'Net cash movement',value:net},{label:'Orders / released tests',value:summary.orders+' / '+summary.reports}].forEach(function(k){ %><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted"><%= k.label %></div><div class="fs-4 fw-bold"><%= typeof k.value==='number'?'₹'+k.value.toFixed(2):k.value %></div></div></div></div><% }) %></div>
<div class="row g-3"><div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong>Record expense</strong></div><div class="card-body"><form method="POST" action="/lab/expenses"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-2"><div class="col-md-6"><label class="form-label">Category</label><select class="form-select" name="category" required><% ['Reagents & consumables','Equipment','Salary','Rent','Electricity','Maintenance','Outsourced tests','Courier','Other'].forEach(function(x){ %><option><%= x %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Amount (₹)</label><input class="form-control" type="number" name="amount" min="0.01" step="0.01" required></div><div class="col-12"><label class="form-label">Description</label><input class="form-control" name="description" maxlength="500" required></div><div class="col-md-6"><label class="form-label">Expense date</label><input class="form-control" type="date" name="expenseDate" value="<%= toDate %>" required></div><div class="col-md-6"><label class="form-label">Payment method</label><select class="form-select" name="paymentMethod"><% ['CASH','UPI','CARD','BANK_TRANSFER','CHEQUE','OTHER'].forEach(function(x){ %><option><%= x %></option><% }) %></select></div><div class="col-12"><label class="form-label">Reference number (optional)</label><input class="form-control" name="referenceNo" maxlength="120"></div><div class="col-12 text-end"><button class="btn btn-primary">Save expense</button></div></div></form></div></div></div>
<div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong>Collections by day and method</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Method</th><th>Transactions</th><th>Amount</th></tr></thead><tbody><% collections.forEach(function(x){ %><tr><td><%= formatDate(x.day) %></td><td><%= x.payment_method %></td><td><%= x.transactions %></td><td>₹<%= Number(x.amount).toFixed(2) %></td></tr><% }) %><% if(!collections.length){ %><tr><td colspan="4" class="text-muted text-center">No collections in this period.</td></tr><% } %></tbody></table></div></div></div>
<div class="col-xl-6"><div class="card"><div class="card-header"><strong>Top tests</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Test</th><th>Count</th></tr></thead><tbody><% topTests.forEach(function(x){ %><tr><td><%= x.name %> <small class="text-muted"><%= x.code %></small></td><td><%= x.count %></td></tr><% }) %><% if(!topTests.length){ %><tr><td colspan="2" class="text-muted text-center">No test data.</td></tr><% } %></tbody></table></div></div></div>
<div class="col-xl-6"><div class="card"><div class="card-header"><strong>Average sample-to-report turnaround</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Test</th><th>Reports</th><th>Average TAT</th></tr></thead><tbody><% tat.forEach(function(x){ %><tr><td><%= x.name %></td><td><%= x.count %></td><td><%= Math.round(Number(x.avg_minutes||0)/60*10)/10 %> hours</td></tr><% }) %><% if(!tat.length){ %><tr><td colspan="3" class="text-muted text-center">No completed sample/report pairs.</td></tr><% } %></tbody></table></div></div></div>
<div class="col-12"><div class="card"><div class="card-header"><strong>Expenses</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Category</th><th>Description</th><th>Method</th><th>By</th><th>Amount</th></tr></thead><tbody><% expenses.forEach(function(x){ %><tr><td><%= formatDate(x.expense_date) %></td><td><%= x.category %></td><td><%= x.description %></td><td><%= x.payment_method %></td><td><%= x.created_by_name %></td><td>₹<%= Number(x.amount).toFixed(2) %></td></tr><% }) %><% if(!expenses.length){ %><tr><td colspan="6" class="text-muted text-center">No expenses in this period.</td></tr><% } %></tbody></table></div></div></div></div>