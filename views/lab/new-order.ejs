<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>New Laboratory / Diagnostic Order</h4><div class="text-muted small">Book tests for an existing patient</div></div><a href="/lab/orders" class="btn btn-outline-secondary btn-sm">Back</a></div>
<form method="POST" action="/lab/orders">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row g-3">
<div class="col-lg-4"><div class="card"><div class="card-header">Patient</div><div class="card-body">
<% if(patient){ %><input type="hidden" name="patientId" value="<%= patient.id %>"><div class="fw-semibold"><%= patient.name %></div><div class="small text-muted"><%= patient.health_id %> · <%= patient.mobile %></div><div class="mt-2"><a href="/patients/<%= patient.health_id %>">Open profile</a></div><% }else{ %><label class="form-label">Health ID</label><input class="form-control" name="healthId" placeholder="Search then reopen with ?healthId="><div class="small text-muted mt-2">Open this page from a patient profile to preselect the patient.</div><% } %>
</div></div>
<div class="card mt-3"><div class="card-header">Order details</div><div class="card-body">
<label class="form-label">Booking date</label><input type="date" class="form-control mb-2" name="bookingDate" value="<%= today %>">
<label class="form-label">Priority</label><select name="priority" class="form-select mb-2"><option>ROUTINE</option><option>URGENT</option><option>STAT</option></select>
<label class="form-label">Source</label><select name="source" class="form-select mb-2"><option value="RECEPTION">Reception</option><option value="PATIENT">Patient</option><option value="DOCTOR">Doctor</option></select>
<label class="form-label">Clinical notes</label><textarea name="clinicalNotes" class="form-control mb-2" rows="3"></textarea>
<% if(currentUser && currentUser.permissions.includes('lab.accounting.manage')){ %><label class="form-label">Discount (₹)</label><input type="number" min="0" step="0.01" name="discountAmount" class="form-control mb-2" value="0"><label class="form-label">Discount reason (required if discount is applied)</label><input name="discountReason" class="form-control mb-2" maxlength="500"><% } %>
<label class="form-label">Sample collection</label><select name="collectionType" id="labCollectionType" class="form-select mb-2"><option value="IN_LAB">At laboratory</option><option value="HOME">Home collection</option></select>
<div id="homeCollectionFields" hidden><label class="form-label">Home collection address</label><textarea name="homeCollectionAddress" class="form-control mb-2" rows="2"></textarea><label class="form-label">Preferred collection time</label><input type="datetime-local" name="homeCollectionScheduledAt" class="form-control mb-2"></div>
<script>(function(){const s=document.getElementById('labCollectionType'),f=document.getElementById('homeCollectionFields');function u(){f.hidden=s.value!=='HOME';f.querySelector('[name=homeCollectionAddress]').required=s.value==='HOME';}s.addEventListener('change',u);u();})();</script>
</div></div></div>
<div class="col-lg-8"><div class="card"><div class="card-header d-flex justify-content-between"><strong>Select Tests & Packages</strong><span class="small text-muted">Dynamic centre catalogue</span></div><div class="card-body"><% if(packages && packages.length){ %><h6>Health checkup packages</h6><div class="row g-2 mb-3"><% packages.forEach(function(p){ %><div class="col-md-6"><label class="border rounded p-2 d-flex gap-2 h-100"><input class="form-check-input mt-1" type="checkbox" name="packageIds" value="<%= p.id %>" <%= !patient?'disabled':'' %>><span><strong><%= p.name %></strong><small class="d-block text-muted"><%= p.code %> · <%= p.test_count %> tests · ₹<%= Number(p.price).toFixed(2) %></small></span></label></div><% }) %></div><hr><% } %><h6>Individual tests</h6><% if(!patient){ %><div class="alert alert-warning">A patient must be selected before creating the order.</div><% } %><div class="row g-2">
<% tests.forEach(function(t){ %><div class="col-md-6"><label class="border rounded p-2 d-flex gap-2 h-100"><input class="form-check-input mt-1" type="checkbox" name="testIds" value="<%= t.id %>" <%= !patient?'disabled':'' %>><span><strong><%= t.name %></strong><small class="d-block text-muted"><%= t.code %> · <%= t.test_type %> · ₹<%= Number(t.price||0).toFixed(2) %></small><% if(t.fasting_required){ %><span class="badge text-bg-warning">Fasting</span><% } %><% if(t.patient_preparation){ %><small class="d-block mt-1"><%= t.patient_preparation %></small><% } %></span></label></div><% }) %>
</div></div><div class="card-footer text-end"><button class="btn btn-primary" <%= !patient?'disabled':'' %>>Create Order</button></div></div></div>
</div></form>