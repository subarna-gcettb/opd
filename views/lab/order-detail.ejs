<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4><%= order.order_code %></h4><div class="text-muted"><%= order.patient_name %> · <%= order.health_id %> · <%= order.laboratory_name %></div></div><a href="/lab/orders" class="btn btn-outline-secondary btn-sm">Back</a></div>
<div class="card mb-3"><div class="card-body"><div class="row g-2 small"><div class="col-md-3"><strong>Status</strong><div><span class="badge text-bg-primary"><%= order.status.replaceAll('_',' ') %></span></div></div><div class="col-md-3"><strong>Source</strong><div><%= order.source %></div></div><div class="col-md-3"><strong>Referral</strong><div><%= order.referral_provider_name || "—" %><% if(order.referral_code){ %> · <code><%= order.referral_code %></code><% } %></div></div><div class="col-md-3"><strong>Priority</strong><div><%= order.priority %></div></div><div class="col-md-3"><strong>Amount</strong><div>₹<%= Number(order.net_amount||0).toFixed(2) %></div></div></div></div></div>
<div class="card"><div class="card-header"><strong>Tests & Sample Tracking</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Test</th><th>Specimen</th><th>Status</th><th>Sample / Barcode</th><th>Result</th><th>Action</th></tr></thead><tbody>
<% items.forEach(function(i){ %><tr><td><strong><%= i.test_name_snapshot %></strong><div class="small text-muted"><%= i.test_code_snapshot %> · <%= i.section_name||'' %></div></td><td><%= i.specimen_type_snapshot||'—' %></td><td><span class="badge text-bg-light border"><%= i.status.replaceAll('_',' ') %></span><% if(i.sample_status){ %><div class="small text-muted">Sample: <%= i.sample_status %></div><% } %></td>
<td><% if(i.sample_code){ %><strong><%= i.sample_code %></strong><div class="small"><code><%= i.barcode_value %></code></div><% }else{ %>—<% } %></td>
<td><% if(i.result_id){ %><a href="/lab/results/<%= i.result_id %>" class="btn btn-sm btn-outline-primary"><%= i.result_status %> v<%= i.result_version %></a><% }else{ %>—<% } %></td>
<td><div class="d-flex flex-wrap gap-1">
<% if(currentUser && currentUser.permissions.includes('lab.sample.collect') && ['ORDERED','BOOKED','SAMPLE_PENDING'].includes(i.status)){ %><form method="POST" action="/lab/items/<%= i.id %>/sample/collect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-primary">Collect</button></form><% } %>
<% if(currentUser && currentUser.permissions.includes('lab.sample.collect') && i.sample_status==='COLLECTED'){ %><form method="POST" action="/lab/items/<%= i.id %>/sample/receive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-secondary">Receive</button></form><% } %>
<% if(currentUser && currentUser.permissions.includes('lab.result.enter') && ['RECEIVED','COLLECTED','PROCESSING','RESULT_ENTERED','VERIFIED'].includes(i.status)){ %><a href="/lab/orders/<%= order.id %>/items/<%= i.id %>/result" class="btn btn-sm btn-primary">Result</a><% } %>
<% if(i.result_status==='RELEASED'){ %><a href="/lab/results/<%= i.result_id %>/print" target="_blank" class="btn btn-sm btn-outline-success">Report</a><% } %>
</div></td></tr><% }) %>
</tbody></table></div></div>
<% if(!['CANCELLED','REPORTED','PROCESSING','PARTIALLY_REPORTED'].includes(order.status)){ %><div class="mt-3"><form method="POST" action="/lab/orders/<%= order.id %>/cancel" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" class="form-control" placeholder="Cancellation reason"><button class="btn btn-outline-danger">Cancel Order</button></form></div><% } %>
<div class="card mt-3"><div class="card-header">Status History</div><ul class="list-group list-group-flush"><% history.forEach(function(h){ %><li class="list-group-item small d-flex justify-content-between"><span><strong><%= h.new_status.replaceAll('_',' ') %></strong> <%= h.note||'' %></span><span class="text-muted"><%= h.changed_by_name %> · <%= formatDateTime(h.created_at) %></span></li><% }) %></ul></div>