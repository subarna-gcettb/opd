<div class="container py-4" style="max-width:850px"><div class="card shadow-sm"><div class="card-body p-4"><div class="d-flex justify-content-between align-items-start gap-3"><div><h3 class="mb-1"><%= order.laboratory_name %></h3><div class="text-muted">Secure Laboratory Report & Bill Status</div></div><span class="badge text-bg-<%= order.status==='REPORTED'?'success':'primary' %>"><%= order.status.replaceAll('_',' ') %></span></div><hr><div class="row g-3"><div class="col-sm-6"><div class="small text-muted">Patient</div><strong><%= order.patient_name %></strong><div class="small text-muted">Health ID: <%= order.health_id %></div></div><div class="col-sm-6"><div class="small text-muted">Order number</div><strong><%= order.order_code %></strong><div class="small text-muted">Registered: <%= formatDate(order.created_at) %></div></div><div class="col-sm-4"><div class="small text-muted">Net amount</div><strong>₹<%= Number(order.net_amount||0).toFixed(2) %></strong></div><div class="col-sm-4"><div class="small text-muted">Payment status</div><strong><%= order.payment_status %></strong></div><div class="col-sm-4"><div class="small text-muted">Reports ready</div><strong><%= items.filter(x=>x.result_status==='RELEASED').length %> / <%= items.length %></strong></div></div><hr><h5>Tests and report status</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Test</th><th>Status</th><th>Report</th></tr></thead><tbody><% items.forEach(function(item){ %><tr><td><strong><%= item.test_name_snapshot %></strong><div class="small text-muted"><%= item.test_code_snapshot %></div></td><td><%= item.result_status==='RELEASED'?'Report ready':item.status.replaceAll('_',' ') %></td><td><% if(item.result_status==='RELEASED'&&item.result_id){ %><a class="btn btn-sm btn-primary" href="/lab/share/<%= token %>/reports/<%= item.result_id %>">View / Print PDF</a><% if(item.report_file_name){ %><a class="btn btn-sm btn-outline-secondary mt-1" href="/lab/share/<%= token %>/reports/<%= item.result_id %>/file" target="_blank">Open attached report</a><% } %><% }else{ %><span class="text-muted small">Not released yet</span><% } %></td></tr><% }) %></tbody></table></div><div class="small text-muted">This secure link expires at <%= formatDateTime(order.expires_at) %>. If you did not expect this link, contact the hospital.</div></div></div><div class="text-center text-muted small mt-3">Chhayabithi Hospital · Laboratory & Diagnostics</div></div>