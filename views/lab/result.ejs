<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4><%= result.test_name_snapshot %></h4><div class="text-muted"><%= result.order_code %> · <%= result.patient_name %> · Version <%= result.version %></div></div><div class="d-flex gap-2"><a href="/lab/results/<%= result.id %>/print" target="_blank" class="btn btn-outline-secondary btn-sm">Print</a><% if(result.status==='RELEASED' && currentUser && currentUser.permissions.includes('lab.report.share')){ %><a href="/lab/results/<%= result.id %>/share" class="btn btn-outline-primary btn-sm">Share report</a><% } %><% if(currentUser && currentUser.permissions.includes('lab.result.verify') && result.status==='RESULT_ENTERED'){ %><form method="POST" action="/lab/results/<%= result.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-primary btn-sm">Verify</button></form><% } %><% if(currentUser && currentUser.permissions.includes('lab.result.release') && result.status==='VERIFIED'){ %><form method="POST" action="/lab/results/<%= result.id %>/release"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-success btn-sm">Release to Patient</button></form><% } %></div></div>
<div class="card mb-3"><div class="card-body small"><div class="row g-2"><div class="col-md-3"><strong>Status</strong><div><span class="badge text-bg-primary"><%= result.status.replaceAll('_',' ') %></span></div></div><div class="col-md-3"><strong>Performed by</strong><div><%= result.performer_name||'—' %></div></div><div class="col-md-3"><strong>Reviewed by</strong><div><%= result.reviewer_name||'—' %></div></div><div class="col-md-3"><strong>Released by</strong><div><%= result.releaser_name||'—' %></div></div></div></div></div>
<div class="card mb-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Parameter</th><th>Result</th><th>Unit</th><th>Reference</th><th>Flag</th><th>Remarks</th></tr></thead><tbody><% parameters.forEach(function(p){ %><tr class="<%= ['CRITICAL_LOW','CRITICAL_HIGH'].includes(p.abnormal_flag)?'table-danger':'' %>"><td><%= p.name %></td><td><strong><%= p.value_text||'—' %></strong></td><td><%= p.unit_snapshot||p.unit||'—' %></td><td><%= p.reference_range_snapshot||p.reference_range_text||'—' %></td><td><%= p.abnormal_flag||'—' %></td><td><%= p.remarks||'—' %></td></tr><% }) %></tbody></table></div></div>
<div class="card mb-3"><div class="card-body"><strong>Summary</strong><p><%= result.result_summary||'—' %></p><strong>Interpretation</strong><p><%= result.interpretation||'—' %></p><strong>Comments</strong><p><%= result.comments||'—' %></p></div></div>
<div class="card"><div class="card-header">Digital report file</div><div class="card-body"><% if(result.report_file_name){ %><a href="/lab/results/<%= result.id %>/file" target="_blank"><%= result.report_file_name %></a><% }else{ %><span class="text-muted">No external digital report attached.</span><% } %><% if(result.status!=='RELEASED'){ %><form method="POST" action="/lab/results/<%= result.id %>/file" enctype="multipart/form-data" class="mt-3 d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="file" name="reportFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png"><button class="btn btn-outline-primary">Attach</button></form><% } %></div></div>