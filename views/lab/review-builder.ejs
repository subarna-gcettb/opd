<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-0">Google Review Builder</h4><div class="small text-muted">Create a personalized request without sending it automatically.</div></div><a class="btn btn-outline-secondary btn-sm" href="/lab/settings">Settings</a></div>
<% if(!reviewUrl){ %><div class="alert alert-warning">Configure your Google Business review URL first in <a href="/lab/settings">Laboratory Settings</a>.</div><% } %>
<div class="row g-3"><div class="col-lg-5"><div class="card"><div class="card-header"><strong>Recipient</strong></div><div class="card-body"><form method="GET" action="/lab/review-builder"><label class="form-label">Order ID (optional)</label><input class="form-control mb-2" type="number" min="1" name="orderId" value="<%= order?.id||'' %>" placeholder="Enter lab order ID"><button class="btn btn-outline-primary">Load patient</button></form><% if(order){ %><hr><div><strong><%= order.patient_name %></strong></div><div class="small text-muted"><%= order.order_code %> · <%= order.mobile||'' %></div><% } %></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header"><strong>Review message</strong></div><div class="card-body"><textarea id="reviewMessage" class="form-control mb-3" rows="5" readonly><%= message %><%= reviewUrl?' '+reviewUrl:'' %></textarea><div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('reviewMessage').value)">Copy message</button><% if(reviewUrl){ %><a class="btn btn-success" href="<%= 'https://wa.me/'+(order?String(order.mobile||'').replace(/[^0-9]/g,''):'')+'?text='+encodeURIComponent(message+' '+reviewUrl) %>" target="_blank" rel="noopener">WhatsApp</a><% if(order && order.mobile){ %><a class="btn btn-outline-primary" href="<%= 'sms:'+String(order.mobile).replace(/[^0-9+]/g,'')+'?body='+encodeURIComponent(message+' '+reviewUrl) %>">SMS app</a><% } %><a class="btn btn-outline-primary" href="<%= 'mailto:?subject='+encodeURIComponent('Share your feedback')+'&body='+encodeURIComponent(message+' '+reviewUrl) %>">Email</a><a class="btn btn-outline-dark" target="_blank" rel="noopener" href="<%= reviewUrl %>">Open Google review</a><% } %></div><div class="small text-muted mt-3">The links open a composer. Staff must review the message and explicitly send it.</div></div></div></div></div>