<div class="mb-3"><h4 class="mb-0">Laboratory Settings</h4><div class="text-muted small">Configure report layout and the Google review link used by staff.</div></div>
<form method="POST" action="/lab/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row g-3"><div class="col-lg-6"><div class="card h-100"><div class="card-header"><strong>Google Review Builder</strong></div><div class="card-body">
<label class="form-label">Google Business review URL</label><input class="form-control mb-2" type="url" name="googleReviewUrl" placeholder="https://g.page/r/..." value="<%= settings.google_review_url||'' %>">
<div class="form-text mb-3">Use the review link copied from your Google Business Profile. It will be used in WhatsApp/SMS/email review requests.</div>
<label class="form-label">Review request message</label><textarea class="form-control" name="reviewMessage" rows="4" maxlength="1000"><%= settings.review_message||'' %></textarea><div class="form-text">Optional placeholders: {patient}, {order}. The review link is appended automatically.</div>
<div class="mt-3"><a href="/lab/review-builder" class="btn btn-outline-primary btn-sm">Open Review Builder</a></div>
</div></div></div>
<div class="col-lg-6"><div class="card h-100"><div class="card-header"><strong>Report layout</strong></div><div class="card-body">
<div class="row g-2"><div class="col-md-4"><label class="form-label">Font size (pt)</label><input type="number" class="form-control" name="reportFontSizePt" min="8" max="16" step="0.5" value="<%= settings.report_font_size_pt??10 %>"></div><div class="col-md-4"><label class="form-label">Top margin (mm)</label><input type="number" class="form-control" name="reportMarginTopMm" min="0" max="40" step="0.5" value="<%= settings.report_margin_top_mm??10 %>"></div><div class="col-md-4"><label class="form-label">Bottom margin (mm)</label><input type="number" class="form-control" name="reportMarginBottomMm" min="0" max="40" step="0.5" value="<%= settings.report_margin_bottom_mm??10 %>"></div></div><hr>
<% [['reportShowInterpretation','report_show_interpretation','Show interpretation'],['reportShowComments','report_show_comments','Show comments'],['reportShowMethod','report_show_method','Show test method'],['reportShowInstrument','report_show_instrument','Show instrument name']].forEach(function(x){ %><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="<%= x[0] %>" value="1" id="<%= x[0] %>" <%= settings[x[1]]?'checked':'' %>><label class="form-check-label" for="<%= x[0] %>"><%= x[2] %></label></div><% }) %>
</div></div></div></div><div class="text-end mt-3"><button class="btn btn-primary">Save laboratory settings</button></div></form>