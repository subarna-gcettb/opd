<div class="d-flex justify-content-between align-items-center mb-3"><div><h4><%= title %></h4><div class="text-muted small"><%= order.order_code %> · <%= order.patient_name %></div></div><a class="btn btn-outline-secondary btn-sm" href="<%= kind==='result'?'/lab/results/'+result.id:'/lab/orders/'+order.id %>">Back</a></div>
<div class="row g-3"><div class="col-lg-5"><div class="card"><div class="card-header"><strong>Secure QR link</strong></div><div class="card-body text-center"><img src="<%= qrDataUri %>" alt="QR code for secure laboratory access" width="240" height="240" class="img-fluid"><p class="small text-muted mt-2">Anyone with this link can view the authorized information until the link expires in 7 days. Share only with the intended recipient.</p><input class="form-control form-control-sm" readonly value="<%= url %>" id="shareUrl"><button class="btn btn-outline-primary btn-sm mt-2" type="button" onclick="navigator.clipboard.writeText(document.getElementById('shareUrl').value)">Copy secure link</button></div></div></div>
<div class="col-lg-7"><div class="card mb-3"><div class="card-header"><strong>Share options</strong></div><div class="card-body"><div class="d-flex flex-wrap gap-2"><% if(phone){ %><a class="btn btn-success" target="_blank" rel="noopener" href="https://wa.me/<%= String(phone).replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent('Chhayabithi Laboratory '+(kind==='result'?'report':'bill/status')+' for '+order.order_code+': '+url) %>"><i class="bi bi-whatsapp"></i> WhatsApp</a><a class="btn btn-outline-primary" href="sms:<%= String(phone).replace(/[^0-9+]/g,'') %>?body=<%= encodeURIComponent('Chhayabithi Laboratory '+(kind==='result'?'report':'bill/status')+' for '+order.order_code+': '+url) %>">SMS app</a><% } %><button class="btn btn-outline-secondary" type="button" onclick="window.print()">Print QR</button></div><div class="small text-muted mt-2">WhatsApp and SMS open your device's composer; the message is not sent until you confirm it.</div></div></div>
<% if(kind==='result'){ %><div class="card"><div class="card-header"><strong>Email secure report link</strong></div><div class="card-body"><form method="POST" action="/lab/results/<%= result.id %>/share/email"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Recipient email</label><input class="form-control mb-2" type="email" name="email" value="<%= email||'' %>" required><button class="btn btn-primary">Send report link</button></form><div class="small text-muted mt-2">Email delivery requires configured SMTP settings. The email contains a time-limited secure link.</div></div></div><% } %>
</div></div>