<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-0">Laboratory Staff & Permissions</h4><div class="small text-muted">Map branch users to laboratory roles, including phlebotomists for home collection.</div></div><a class="btn btn-outline-secondary btn-sm" href="/lab/settings">Lab settings</a></div>
<div class="row g-3"><div class="col-lg-5"><div class="card"><div class="card-header"><strong>Add / Update lab worker</strong></div><div class="card-body"><form method="POST" action="/lab/workers"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Branch user</label><select class="form-select mb-3" name="userId" required><option value="">Select user</option><% users.forEach(function(u){ %><option value="<%= u.id %>"><%= u.name %> · <%= u.email||u.mobile||('User '+u.id) %></option><% }) %></select><label class="form-label">Laboratory role</label><select class="form-select mb-3" name="workerType"><% ['RECEPTION','TECHNICIAN','PATHOLOGIST','RADIOLOGIST','CARDIOLOGY','ADMIN','QUALITY','PHLEBOTOMIST'].forEach(function(x){ %><option value="<%= x %>"><%= x.replaceAll('_',' ') %></option><% }) %></select><label class="form-label">Professional registration number (optional)</label><input class="form-control mb-3" name="registrationNo" maxlength="100"><button class="btn btn-primary w-100">Save lab worker</button></form></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header"><strong>Configured laboratory workers</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>User</th><th>Role</th><th>Registration</th><th>Status</th></tr></thead><tbody><% workers.forEach(function(w){ %><tr><td><strong><%= w.name %></strong><div class="small text-muted"><%= w.email||w.mobile||'' %></div></td><td><%= w.worker_type.replaceAll('_',' ') %></td><td><%= w.professional_registration_no||'—' %></td><td><span class="badge text-bg-<%= w.is_active?'success':'secondary' %>"><%= w.is_active?'Active':'Inactive' %></span></td></tr><% }) %><% if(!workers.length){ %><tr><td colspan="4" class="text-center text-muted py-4">No lab staff configured yet.</td></tr><% } %></tbody></table></div></div></div></div>