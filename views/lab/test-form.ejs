<div class="d-flex justify-content-between align-items-center mb-3"><div><h4><%= test?'Edit':'Add' %> Laboratory Test</h4><div class="text-muted small">Configure the dynamic catalogue and structured result parameters.</div></div><a href="/lab/tests" class="btn btn-outline-secondary btn-sm">Back</a></div>
<form method="POST" action="<%= test?'/lab/tests/'+test.test.id:'/lab/tests' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card mb-3"><div class="card-header">Test Configuration</div><div class="card-body"><div class="row g-3">
<div class="col-md-3"><label class="form-label">Code *</label><input name="code" class="form-control" required value="<%= test?test.test.code:'' %>"></div>
<div class="col-md-5"><label class="form-label">Name *</label><input name="name" class="form-control" required value="<%= test?test.test.name:'' %>"></div>
<div class="col-md-4"><label class="form-label">Short name</label><input name="shortName" class="form-control" value="<%= test?test.test.short_name||'':'' %>"></div>
<div class="col-md-3"><label class="form-label">Type</label><select name="testType" class="form-select"><% ['LAB','RADIOLOGY','USG','ECG','CARDIOLOGY','OTHER'].forEach(function(x){ %><option value="<%= x %>" <%= test&&test.test.test_type===x?'selected':'' %>><%= x %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label">Section</label><select name="sectionId" class="form-select"><option value="">—</option><% sections.forEach(function(s){ %><option value="<%= s.id %>" <%= test&&Number(test.test.section_id)===Number(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label">Category</label><select name="categoryId" class="form-select"><option value="">—</option><% categories.forEach(function(c){ %><option value="<%= c.id %>" <%= test&&Number(test.test.category_id)===Number(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label">Price (₹)</label><input type="number" step="0.01" name="price" class="form-control" value="<%= test?test.test.price:0 %>"></div>
<div class="col-md-4"><label class="form-label">Specimen</label><input name="specimenType" class="form-control" value="<%= test?test.test.specimen_type||'':'' %>"></div>
<div class="col-md-4"><label class="form-label">Container</label><input name="containerType" class="form-control" value="<%= test?test.test.container_type||'':'' %>"></div>
<div class="col-md-4"><label class="form-label">Methodology</label><input name="methodology" class="form-control" value="<%= test?test.test.methodology||'':'' %>"></div>
<div class="col-md-3"><label class="form-label">TAT (minutes)</label><input type="number" name="tatMinutes" class="form-control" value="<%= test?test.test.tat_minutes:1440 %>"></div>
<div class="col-md-9"><label class="form-label">Patient preparation</label><textarea name="patientPreparation" class="form-control" rows="2"><%= test?test.test.patient_preparation||'':'' %></textarea></div>
<div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="fastingRequired" value="1" <%= test&&test.test.fasting_required?'checked':'' %>><label class="form-check-label">Fasting required</label></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isAccredited" value="1" <%= test&&test.test.is_accredited?'checked':'' %>><label class="form-check-label">Accredited scope test</label></div><% if(test){ %><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isActive" value="1" <%= test.test.is_active?'checked':'' %>><label class="form-check-label">Active</label></div><% } %></div>
</div></div></div>
<div class="card mb-3"><div class="card-header d-flex justify-content-between"><strong>Result Parameters</strong><button type="button" class="btn btn-sm btn-outline-primary" id="addParameter">Add parameter</button></div><div class="table-responsive"><table class="table align-middle mb-0" id="parameterTable"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Unit</th><th>Reference range</th><th>Formula (parameter codes)</th><th>Sex</th><th>Age min</th><th>Age max</th><th>Range low</th><th>Range high</th><th>Critical low</th><th>Critical high</th><th></th></tr></thead><tbody>
<% const params=test?test.parameters:[]; params.forEach(function(p){ %><tr><td><input name="parameterCode" class="form-control form-control-sm" value="<%= p.code %>"><input type="hidden" name="parameterId" value="<%= p.id %>"></td><td><input name="parameterName" class="form-control form-control-sm" value="<%= p.name %>"></td><td><select name="parameterType" class="form-select form-select-sm"><% ['TEXT','NUMERIC','POSITIVE_NEGATIVE','SELECT','BOOLEAN'].forEach(function(x){ %><option value="<%= x %>" <%= p.data_type===x?'selected':'' %>><%= x %></option><% }) %></select></td><td><input name="parameterUnit" class="form-control form-control-sm" value="<%= p.unit||'' %>"></td><td><input name="referenceRange" class="form-control form-control-sm" value="<%= p.reference_range_text||'' %>"></td><td><input name="formulaExpression" class="form-control form-control-sm" placeholder="e.g. LDL+HDL+VLDL" value="<%= p.formula_expression||'' %>"></td><td><select name="rangeSex" class="form-select form-select-sm"><% ['ALL','MALE','FEMALE'].forEach(function(x){ %><option value="<%= x %>" <%= (p.range_sex||'ALL')===x?'selected':'' %>><%= x %></option><% }) %></select></td><td><input name="ageMinYears" type="number" min="0" step="0.1" class="form-control form-control-sm" value="<%= p.age_min_years??'' %>"></td><td><input name="ageMaxYears" type="number" min="0" step="0.1" class="form-control form-control-sm" value="<%= p.age_max_years??'' %>"></td><td><input name="rangeLow" type="number" step="0.00001" class="form-control form-control-sm" value="<%= p.range_low_value??'' %>"></td><td><input name="rangeHigh" type="number" step="0.00001" class="form-control form-control-sm" value="<%= p.range_high_value??'' %>"></td><td><input name="criticalLow" type="number" step="0.00001" class="form-control form-control-sm" value="<%= p.critical_low??'' %>"></td><td><input name="criticalHigh" type="number" step="0.00001" class="form-control form-control-sm" value="<%= p.critical_high??'' %>"></td><td><button type="button" class="btn btn-sm btn-outline-danger remove-param">×</button></td></tr><% }) %>
</tbody></table></div></div>
<div class="text-end"><button class="btn btn-primary">Save Test Configuration</button></div></form>
<script>
(function(){const body=document.querySelector('#parameterTable tbody');document.getElementById('addParameter').addEventListener('click',function(){body.insertAdjacentHTML('beforeend','<tr><td><input name="parameterCode" class="form-control form-control-sm" value=""></td><td><input name="parameterName" class="form-control form-control-sm"></td><td><select name="parameterType" class="form-select form-select-sm"><option>TEXT</option><option>NUMERIC</option><option>POSITIVE_NEGATIVE</option><option>SELECT</option><option>BOOLEAN</option></select></td><td><input name="parameterUnit" class="form-control form-control-sm"></td><td><input name="referenceRange" class="form-control form-control-sm"></td><td><input name="formulaExpression" class="form-control form-control-sm" placeholder="e.g. LDL+HDL+VLDL"></td><td><select name="rangeSex" class="form-select form-select-sm"><option>ALL</option><option>MALE</option><option>FEMALE</option></select></td><td><input name="ageMinYears" type="number" min="0" step="0.1" class="form-control form-control-sm"></td><td><input name="ageMaxYears" type="number" min="0" step="0.1" class="form-control form-control-sm"></td><td><input name="rangeLow" type="number" step="0.00001" class="form-control form-control-sm"></td><td><input name="rangeHigh" type="number" step="0.00001" class="form-control form-control-sm"></td><td><input name="criticalLow" type="number" step="0.00001" class="form-control form-control-sm"></td><td><input name="criticalHigh" type="number" step="0.00001" class="form-control form-control-sm"></td><td><button type="button" class="btn btn-sm btn-outline-danger remove-param">×</button></td></tr>');});body.addEventListener('click',function(e){if(e.target.classList.contains('remove-param'))e.target.closest('tr').remove();});})();
</script>