<% const can = (p) => currentUser && currentUser.permissions.includes(p); %>

<% if (justBooked) { %>
  <div class="alert alert-success d-flex justify-content-between align-items-center">
    <div><strong>Appointment confirmed.</strong> Token <strong><%= String(appointment.token_number).padStart(3,'0') %></strong> for <%= appointment.doctor_name %>.</div>
    <a href="/opd/appointments/<%= appointment.id %>/token" target="_blank" class="btn btn-sm btn-primary"><i class="bi bi-printer"></i> Print Token</a>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0">Appointment <code><%= appointment.appointment_code %></code></h4>
    <div class="text-muted">Visit <%= appointment.visit_code || '—' %> &middot; <%= appointment.branch_name %></div>
  </div>
  <div class="d-flex gap-2">
    <a href="/opd/appointments/<%= appointment.id %>/token" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Token</a>
    <a href="/opd/appointments/<%= appointment.id %>/barcode" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-upc-scan"></i> Barcode</a>
    <% if (can('billing.create') && appointment.visit_id) { %>
      <a href="/billing/invoices/new?visitId=<%= appointment.visit_id %>" class="btn btn-primary btn-sm"><i class="bi bi-receipt"></i> Generate Bill</a>
    <% } %>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-8">
    <div class="card h-100">
      <div class="card-header">Details</div>
      <div class="card-body">
        <div class="row row-cols-2 g-2 small">
          <div><strong>Patient:</strong> <a href="/patients/<%= appointment.health_id %>"><%= appointment.patient_name %></a></div>
          <div><strong>Health ID:</strong> <code><%= appointment.health_id %></code></div>
          <div><strong>Age / Gender:</strong> <%= appointment.age_years || '—' %> / <%= appointment.gender %></div>
          <div><strong>Mobile:</strong> <%= appointment.mobile %></div>
          <div><strong>Doctor:</strong> <%= appointment.doctor_name %></div>
          <div><strong>Department:</strong> <%= appointment.department_name %></div>
          <div><strong>Date:</strong> <%= new Date(appointment.appointment_date).toLocaleDateString() %></div>
          <div><strong>Time:</strong> <%= appointment.slot_time.slice(0,5) %></div>
          <div><strong>Consultation Fee:</strong> ₹<%= Number(appointment.consultation_fee).toFixed(2) %></div>
          <div><strong>Booked At:</strong> <%= new Date(appointment.created_at).toLocaleString() %></div>
          <div class="col-12"><strong>Reason:</strong> <%= appointment.reason || '—' %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 text-center">
      <div class="card-header">Token</div>
      <div class="card-body">
        <div style="font-size:3rem;font-weight:800;color:var(--hms-primary);"><%= String(appointment.token_number).padStart(3,'0') %></div>
        <div class="mb-2">
          <span class="badge text-bg-<%= appointment.status === 'COMPLETED' ? 'success' : (appointment.status === 'CANCELLED' || appointment.status === 'NO_SHOW' ? 'danger' : 'primary') %>">
            Appointment: <%= appointment.status.replace('_',' ') %>
          </span>
        </div>
        <% if (appointment.visit_status) { %>
          <div><span class="badge text-bg-info">Visit: <%= appointment.visit_status.replace('_',' ') %></span></div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (!['CANCELLED','COMPLETED'].includes(appointment.status)) { %>
  <div class="card mb-3">
    <div class="card-header">Actions</div>
    <div class="card-body d-flex gap-2 flex-wrap">
      <% if (can('appointment.reschedule')) { %>
        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#rescheduleModal"><i class="bi bi-calendar-event"></i> Reschedule</button>
      <% } %>
      <% if (can('appointment.cancel') || can('appointment.reschedule')) { %>
        <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal"><i class="bi bi-x-circle"></i> Cancel</button>
      <% } %>
      <% if (can('queue.manage')) { %>
        <form method="POST" action="/opd/appointments/<%= appointment.id %>/no-show" data-confirm="Mark this patient as a no-show?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-outline-warning btn-sm"><i class="bi bi-person-dash"></i> Mark No-Show</button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">Appointment History</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead><tr><th>When</th><th>Action</th><th>From</th><th>To</th><th>Reason</th><th>By</th></tr></thead>
      <tbody>
        <% history.forEach(function(h) { %>
          <tr>
            <td><%= new Date(h.changed_at).toLocaleString() %></td>
            <td><span class="badge text-bg-secondary"><%= h.action.replace('_',' ') %></span></td>
            <td><%= h.old_date ? new Date(h.old_date).toLocaleDateString() + ' ' + (h.old_time || '').slice(0,5) : '—' %></td>
            <td><%= h.new_date ? new Date(h.new_date).toLocaleDateString() + ' ' + (h.new_time || '').slice(0,5) : '—' %></td>
            <td><%= h.reason || '—' %></td>
            <td><%= h.changed_by_name %></td>
          </tr>
        <% }) %>
        <% if (history.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-3">No changes recorded — this appointment has not been rescheduled or cancelled.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Reschedule modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/opd/appointments/<%= appointment.id %>/reschedule" class="modal-content">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h5 class="modal-title">Reschedule Appointment</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="alert alert-info small">The original date and time will be preserved in the appointment history. A new token will be issued for the new date.</div>
        <div class="mb-3">
          <label class="form-label">New Date</label>
          <input type="date" name="newDate" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">New Time</label>
          <input type="time" name="newTime" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Reason</label>
          <textarea name="reason" class="form-control" rows="2" required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Reschedule</button>
      </div>
    </form>
  </div>
</div>

<!-- Cancel modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/opd/appointments/<%= appointment.id %>/cancel" class="modal-content">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h5 class="modal-title">Cancel Appointment</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p>This will cancel the appointment and remove the patient from the queue. The record is retained for audit.</p>
        <label class="form-label">Reason</label>
        <textarea name="reason" class="form-control" rows="2" required></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-danger">Cancel Appointment</button>
      </div>
    </form>
  </div>
</div>
