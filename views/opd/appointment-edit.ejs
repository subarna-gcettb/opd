<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Edit Appointment</h4><div class="text-muted"><%= appointment.patient_name %> · Token <%= String(appointment.token_number).padStart(3,'0') %></div></div><a href="/opd/appointments/<%= appointment.id %>" class="btn btn-outline-secondary btn-sm">Cancel</a></div>
<form method="POST" action="/opd/appointments/<%= appointment.id %>/edit" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Appointment Date</label><input type="date" name="newDate" class="form-control" value="<%= new Date(appointment.appointment_date).toISOString().slice(0,10) %>" required></div>
<div class="col-md-4"><label class="form-label">Time</label><input type="time" name="newTime" class="form-control" value="<%= String(appointment.slot_time).slice(0,5) %>" required></div>
<div class="col-12"><label class="form-label">Reason / Chief Complaint</label><textarea name="reason" class="form-control" rows="3"><%= appointment.reason || '' %></textarea></div>
</div><div class="alert alert-info small mt-3 mb-0">Changing the date or time issues a new token and records the previous appointment timing in appointment history.</div></div><div class="card-footer text-end"><button class="btn btn-primary">Save Appointment</button></div></form>