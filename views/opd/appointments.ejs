<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Appointments</h4>
  <a href="/opd/appointments/new" class="btn btn-primary btn-sm"><i class="bi bi-calendar-plus"></i> Book Appointment</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">Date</label>
        <input type="date" name="date" class="form-control form-control-sm" value="<%= filters.date || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small">Doctor</label>
        <select name="doctorId" class="form-select form-select-sm">
          <option value="">All doctors</option>
          <% doctors.forEach(function(d) { %>
            <option value="<%= d.id %>" <%= String(filters.doctorId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">All statuses</option>
          <% ['BOOKED','RESCHEDULED','COMPLETED','CANCELLED','NO_SHOW'].forEach(function(s) { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-sm btn-primary flex-grow-1">Filter</button>
        <a href="/opd/appointments" class="btn btn-sm btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>Token</th><th>Appointment</th><th>Patient</th><th>Doctor</th><th>Department</th><th>Date / Time</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function(a) { %>
          <tr>
            <td><span class="token-badge"><%= String(a.token_number).padStart(3,'0') %></span></td>
            <td><code class="small"><%= a.appointment_code %></code></td>
            <td><%= a.patient_name %><div class="text-muted small"><%= a.health_id %> · <%= a.age_years || '—' %>/<%= a.gender %></div></td>
            <td><%= a.doctor_name %></td>
            <td><%= a.department_name %></td>
            <td><%= new Date(a.appointment_date).toLocaleDateString() %><div class="text-muted small"><%= a.slot_time.slice(0,5) %></div></td>
            <td>
              <span class="badge text-bg-<%= a.status === 'COMPLETED' ? 'success' : (a.status === 'CANCELLED' || a.status === 'NO_SHOW' ? 'danger' : 'primary') %>"><%= a.status.replace('_',' ') %></span>
              <% if (a.visit_status) { %><div class="text-muted small mt-1"><%= a.visit_status.replace('_',' ') %></div><% } %>
            </td>
            <td><a href="/opd/appointments/<%= a.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
          </tr>
        <% }) %>
        <% if (rows.length === 0) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No appointments match these filters.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>&date=<%= filters.date || '' %>&doctorId=<%= filters.doctorId || '' %>&status=<%= filters.status || '' %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>
