<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<h4 class="mb-3">Book OPD Appointment</h4>

<form method="POST" action="/opd/appointments/new" class="card" id="bookingForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="patientId" id="patientId" value="<%= patient ? patient.id : '' %>">
  <input type="hidden" name="healthId" id="healthIdField" value="<%= patient ? patient.health_id : '' %>">

  <div class="card-body">
    <!-- STEP 1: PATIENT -->
    <h6 class="text-uppercase text-muted small mb-2">1. Patient</h6>
    <div id="patientPicker" class="<%= patient ? 'd-none' : '' %>">
      <div class="input-group mb-2">
        <input type="text" id="patientSearch" class="form-control" placeholder="Search by Health ID, name or mobile…">
        <button class="btn btn-outline-secondary" type="button" id="patientSearchBtn">Search</button>
      </div>
      <div id="patientResults"></div>
    </div>
    <div id="patientSelected" class="alert alert-success d-flex justify-content-between align-items-center <%= patient ? '' : 'd-none' %>">
      <div>
        <strong id="selPatientName"><%= patient ? patient.name : '' %></strong>
        &middot; Health ID <code id="selPatientHid"><%= patient ? patient.health_id : '' %></code>
        &middot; <span id="selPatientMeta"><%= patient ? (patient.age_years || '—') + ' / ' + patient.gender : '' %></span>
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="changePatientBtn">Change</button>
    </div>

    <hr class="my-4">

    <!-- STEP 2: DOCTOR -->
    <h6 class="text-uppercase text-muted small mb-2">2. Branch, Department &amp; Doctor</h6>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label">Branch *</label>
        <select name="branchId" id="branchId" class="form-select" required>
          <% branches.forEach(function(b, i) { %>
            <option value="<%= b.id %>" <%= i === 0 ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Department *</label>
        <select name="departmentId" id="departmentId" class="form-select" required>
          <option value="">Select department</option>
          <% departments.forEach(function(d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Doctor *</label>
        <select name="doctorId" id="doctorId" class="form-select" required disabled>
          <option value="">Select department first</option>
        </select>
      </div>
    </div>

    <hr class="my-4">

    <!-- STEP 3: SLOT -->
    <h6 class="text-uppercase text-muted small mb-2">3. Date &amp; Time Slot</h6>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label">Appointment Date *</label>
        <input type="text" name="appointmentDate" id="appointmentDate" class="form-control" value="" placeholder="Select an available date" autocomplete="off" required>
<div id="dateAvailabilityHint" class="form-text">Select a doctor first. Only that doctor's available OPD dates will be enabled.</div>
      </div>
      <div class="col-md-9">
        <label class="form-label">Available Slots *</label>
        <div id="slotContainer" class="border rounded p-3 bg-light" style="min-height: 72px;">
          <span class="text-muted small">Select a doctor and date to see available slots.</span>
        </div>
        <input type="hidden" name="slotTime" id="slotTime" required>
      </div>
    </div>

    <hr class="my-4">

    <h6 class="text-uppercase text-muted small mb-2">4. Reason / Chief Complaint</h6>
    <textarea name="reason" class="form-control" rows="2" placeholder="e.g. Fever and body ache for 3 days"></textarea><div class="col-12 obstetric-section" style="display:none">
        <div class="card pregnancy-assessment-card border-info">
          <div class="card-header"><strong>Female / Obstetric Assessment</strong></div>
          <div class="card-body">
            <div class="alert alert-info small">Use LMP, conception date, EDD, or a USG/ultrasound report. Gestational age and EDD are calculated automatically; the server recalculates them when the appointment is saved.</div>
            <div class="row g-2">
              <div class="col-md-3"><label class="form-label small">Pregnancy status</label><select name="pregnancyStatus" id="pregnancyStatus" class="form-select"><option value="UNKNOWN">Unknown</option><option value="NOT_PREGNANT">Not pregnant</option><option value="PREGNANT">Pregnant</option></select></div>
              <div class="col-md-3"><label class="form-label small">Dating source</label><select id="pregnancyMethod" class="form-select"><option value="LMP">1st day of LMP</option><option value="CONCEPTION">Conception date</option><option value="EDD">Estimated due date</option><option value="USG">USG / Ultrasound — GA</option><option value="USG_EDD">USG / Ultrasound — EDD</option></select></div>
              <div class="col-md-3"><label class="form-label small" id="pregnancyReferenceLabel">Date</label><input type="date" id="pregnancyReferenceDate" class="form-control"><input type="hidden" name="lmpDate" id="lmpDate"><input type="hidden" name="pregnancyDatingMethod" id="pregnancyDatingMethod"></div>
              <div class="col-md-6" id="bookingUsgFields" style="display:none"><label class="form-label small">USG / Ultrasound gestational age at scan</label><div class="input-group"><input type="number" min="0" max="45" name="usgGestationalAgeWeeks" id="bookingUsgWeeks" class="form-control" placeholder="Weeks"><span class="input-group-text">weeks</span><input type="number" min="0" max="6" name="usgGestationalAgeDays" id="bookingUsgDays" class="form-control" placeholder="Days" value="0"><span class="input-group-text">days</span></div></div>
              <input type="hidden" name="conceptionDate" id="bookingConceptionDate">
              <input type="hidden" name="referenceDate" id="bookingReferenceDate">
              <input type="hidden" name="usgDate" id="bookingUsgDate">
              <input type="hidden" name="usgEdd" id="bookingUsgEdd">
              <div class="col-md-3"><label class="form-label small">Gravida (G)</label><input type="number" name="gravida" min="0" class="form-control"></div>
              <div class="col-md-3"><label class="form-label small">Para (P)</label><input type="number" name="para" min="0" class="form-control"></div>
              <div class="col-md-3"><label class="form-label small">Abortions (A)</label><input type="number" name="abortions" min="0" class="form-control"></div>
              <div class="col-12" id="pregnancyCalculatorResult" style="display:none">
                <div class="pregnancy-calculator-result">
                  <div class="row g-2">
                    <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Gestational age</small><strong id="bookingGaResult">—</strong></div></div>
                    <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>EDD</small><strong id="bookingEddResult">—</strong></div></div>
                    <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Trimester</small><strong id="bookingTrimesterResult">—</strong></div></div>
                    <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Remaining</small><strong id="bookingRemainingResult">—</strong></div></div>
                  </div>
                  <div class="small text-muted mt-2">Calculated LMP: <strong id="bookingDerivedLmp">—</strong> · Conception: <strong id="bookingConception">—</strong></div>
                </div>
              </div>
              <div class="col-12"><div id="pregnancyBookingError" class="alert alert-danger py-2 mb-0" style="display:none"></div></div>
              <div class="col-12"><label class="form-label small">Obstetric notes</label><textarea name="obstetricNotes" class="form-control" rows="2"></textarea></div>
            </div>
          </div>
        </div>
      </div>
  </div>

  <div class="card-footer d-flex justify-content-end gap-2">
    <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary" id="submitBtn"><i class="bi bi-calendar-check"></i> Confirm Appointment</button>
  </div>
</form>

<script>
(function () {
  const patientSearch = document.getElementById('patientSearch');
  const patientResults = document.getElementById('patientResults');
  const patientPicker = document.getElementById('patientPicker');
  const patientSelected = document.getElementById('patientSelected');
  const patientIdField = document.getElementById('patientId');
  const obstetricSection = document.querySelector('.obstetric-section');
  function toggleObstetric(gender) { if (obstetricSection) obstetricSection.style.display = String(gender || '').toLowerCase() === 'female' ? '' : 'none'; }

  function runPatientSearch() {
    const q = patientSearch.value.trim();
    if (q.length < 2) return;
    patientResults.innerHTML = '<div class="text-muted small">Searching…</div>';
    fetch('/patients/search/results?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.results.length) {
          patientResults.innerHTML = '<div class="alert alert-warning py-2 mb-0">No patient found. ' +
            '<a href="/patients/new">Register a new patient</a> first.</div>';
          return;
        }
        patientResults.innerHTML = '<div class="list-group">' + data.results.map(function (p) {
          return '<button type="button" class="list-group-item list-group-item-action" ' +
            'data-id="' + p.id + '" data-name="' + p.name + '" data-hid="' + p.health_id + '" ' +
            'data-meta="' + (p.age_years || '—') + ' / ' + p.gender + '" data-gender="' + p.gender + '">' +
            '<strong>' + p.name + '</strong> <code>' + p.health_id + '</code> · ' +
            (p.age_years || '—') + '/' + p.gender + ' · ' + p.mobile + '</button>';
        }).join('') + '</div>';
      })
      .catch(() => { patientResults.innerHTML = '<div class="text-danger small">Search failed.</div>'; });
  }

  document.getElementById('patientSearchBtn').addEventListener('click', runPatientSearch);
  patientSearch && patientSearch.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); runPatientSearch(); }
  });

  patientResults.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-id]');
    if (!btn) return;
    patientIdField.value = btn.dataset.id;
    document.getElementById('healthIdField').value = btn.dataset.hid;
    document.getElementById('selPatientName').textContent = btn.dataset.name;
    document.getElementById('selPatientHid').textContent = btn.dataset.hid;
    document.getElementById('selPatientMeta').textContent = btn.dataset.meta;
    toggleObstetric(btn.dataset.gender);
    patientPicker.classList.add('d-none');
    patientSelected.classList.remove('d-none');
    toggleObstetric('<%= patient ? patient.gender : '' %>');
  });

  document.getElementById('changePatientBtn').addEventListener('click', function () {
    patientIdField.value = '';
    patientSelected.classList.add('d-none');
    patientPicker.classList.remove('d-none');
  });

  toggleObstetric('<%= patient ? patient.gender : '' %>');

  // Branch -> Department -> Doctor -> Date -> Slot cascade.
  // Doctors are loaded from the server so the selector always reflects the
  // selected branch and department instead of relying on stale page data.
  const branchSel = document.getElementById('branchId');
  const departmentSel = document.getElementById('departmentId');
  const doctorSel = document.getElementById('doctorId');
  const dateInput = document.getElementById('appointmentDate');
  const slotContainer = document.getElementById('slotContainer');
  const slotTimeField = document.getElementById('slotTime');
  const dateHint = document.getElementById('dateAvailabilityHint');
  let bookingDatePicker = null;
  let availableDates = new Set();
  let doctorRequestId = 0;

  function resetBookingDateSlots(message) {
    availableDates = new Set();
    slotTimeField.value = '';
    slotContainer.innerHTML = '<span class="text-muted small">' + message + '</span>';
    if (bookingDatePicker) {
      bookingDatePicker.clear();
      bookingDatePicker.set('enable', []);
    } else {
      dateInput.value = '';
    }
  }

  function resetDoctor(message) {
    doctorSel.innerHTML = '<option value="">' + message + '</option>';
    doctorSel.disabled = true;
    resetBookingDateSlots('Select a doctor and date to see available slots.');
  }

  function initDatePicker() {
    if (!window.flatpickr || bookingDatePicker) return;
    bookingDatePicker = window.flatpickr(dateInput, {
      dateFormat: 'Y-m-d',
      minDate: '<%= today %>',
      disable: [function(date) {
        const key = bookingDatePicker ? bookingDatePicker.formatDate(date, 'Y-m-d') : '';
        return !availableDates.has(key);
      }],
      onChange: function(selectedDates, dateStr) {
        slotTimeField.value = '';
        loadSlots(dateStr);
      }
    });
  }

  async function loadDoctors() {
    const requestId = ++doctorRequestId;
    const branchId = branchSel.value;
    const departmentId = departmentSel.value;
    resetDoctor(departmentId ? 'Loading doctors…' : 'Select department first');
    if (!branchId || !departmentId) return;

    try {
      const response = await fetch('/doctors/api/list?branchId=' + encodeURIComponent(branchId) +
        '&departmentId=' + encodeURIComponent(departmentId), { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (requestId !== doctorRequestId) return;
      if (!response.ok) throw new Error(data.message || 'Unable to load doctors');
      doctorSel.innerHTML = '<option value="">Select doctor</option>';
      (data.doctors || []).forEach(function(doctor) {
        const option = document.createElement('option');
        option.value = doctor.id;
        option.textContent = doctor.name + (doctor.consultation_fee != null
          ? ' — ₹' + Number(doctor.consultation_fee || 0).toFixed(0) : '');
        doctorSel.appendChild(option);
      });
      doctorSel.disabled = !(data.doctors || []).length;
      if (!(data.doctors || []).length) {
        doctorSel.innerHTML = '<option value="">No active doctor found</option>';
      }
      resetBookingDateSlots('Select a doctor and date to see available slots.');
      dateHint.textContent = doctorSel.disabled
        ? 'No active doctor is available for this branch and department.'
        : 'Select a doctor. Only that doctor’s available OPD dates will be enabled.';
    } catch (error) {
      if (requestId !== doctorRequestId) return;
      resetDoctor('Unable to load doctors — try again');
      dateHint.textContent = error.message || 'Unable to load doctors.';
    }
  }

  async function loadDoctorDates() {
    const doctorId = doctorSel.value;
    initDatePicker();
    resetBookingDateSlots('Loading available OPD dates…');
    if (!doctorId) return;
    try {
      const response = await fetch('/doctors/' + encodeURIComponent(doctorId) +
        '/available-dates?from=' + encodeURIComponent('<%= today %>') + '&days=90',
        { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Unable to load available dates');
      availableDates = new Set((data.dates || []).map(String));
      if (bookingDatePicker) bookingDatePicker.set('enable', [function(date) {
        const key = bookingDatePicker.formatDate(date, 'Y-m-d');
        return availableDates.has(key);
      }]);
      dateHint.textContent = availableDates.size
        ? 'Only this doctor’s available OPD dates are enabled.'
        : 'This doctor has no available OPD dates in the next 90 days.';
    } catch (error) {
      dateHint.textContent = error.message || 'Unable to load doctor availability.';
    }
  }

  async function loadSlots(date) {
    const doctorId = doctorSel.value;
    if (!doctorId || !date) return;
    slotContainer.innerHTML = '<span class="text-muted small">Loading available slots…</span>';
    try {
      const response = await fetch('/doctors/' + encodeURIComponent(doctorId) +
        '/slots?date=' + encodeURIComponent(date), { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Unable to load slots');
      const slots = data.slots || [];
      if (!slots.length) {
        slotContainer.innerHTML = '<span class="text-muted small">No available slots for this date.</span>';
        return;
      }
      slotContainer.innerHTML = slots.map(function(slot) {
        const time = String(slot.time || slot.slot_time || '').slice(0, 5);
        const label = slot.label || time;
        const full = Number(slot.available != null ? slot.available : (Number(slot.capacity || 1) - Number(slot.booked || 0))) <= 0;
        return '<button type="button" class="btn btn-sm me-2 mb-2 ' + (full ? 'btn-danger' : 'btn-outline-primary') + '" data-slot-time="' +
          time.replace(/"/g, '&quot;') + '"' + (full ? ' disabled aria-disabled="true" title="Already booked"' : '') + '>' + label + (full ? ' · Booked' : '') + '</button>';
      }).join('');
      slotContainer.querySelectorAll('[data-slot-time]').forEach(function(button) {
        button.addEventListener('click', function() {
          if (button.disabled) return;
          slotTimeField.value = button.dataset.slotTime;
          slotContainer.querySelectorAll('[data-slot-time]').forEach(function(item) {
            item.classList.remove('active');
          });
          button.classList.add('active');
        });
      });
    } catch (error) {
      slotContainer.innerHTML = '<span class="text-danger small">' + (error.message || 'Unable to load slots.') + '</span>';
    }
  }

  branchSel.addEventListener('change', loadDoctors);
  departmentSel.addEventListener('change', loadDoctors);
  doctorSel.addEventListener('change', loadDoctorDates);
  initDatePicker();
  if (branchSel.value && departmentSel.value) loadDoctors();

  // Pregnancy calculator for the female assessment.
  const pregnancyStatus = document.getElementById('pregnancyStatus');
  const pregnancyMethod = document.getElementById('pregnancyMethod');
  const pregnancyReferenceDate = document.getElementById('pregnancyReferenceDate');
  const pregnancyLmp = document.getElementById('lmpDate');
  const pregnancyDatingMethod = document.getElementById('pregnancyDatingMethod');
  const pregnancyUsgFields = document.getElementById('bookingUsgFields');
  const pregnancyUsgWeeks = document.getElementById('bookingUsgWeeks');
  const pregnancyUsgDays = document.getElementById('bookingUsgDays');
  const pregnancyResult = document.getElementById('pregnancyCalculatorResult');
  const pregnancyError = document.getElementById('pregnancyBookingError');
  const pregnancyReferenceLabel = document.getElementById('pregnancyReferenceLabel');
  const pregnancyConceptionDate = document.getElementById('bookingConceptionDate');
  const pregnancyReferenceHidden = document.getElementById('bookingReferenceDate');
  const pregnancyUsgDate = document.getElementById('bookingUsgDate');
  const pregnancyUsgEdd = document.getElementById('bookingUsgEdd');
  function bookingParseDate(value) {
    const m = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return null;
    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    return d.getFullYear() === Number(m[1]) && d.getMonth() === Number(m[2]) - 1 && d.getDate() === Number(m[3]) ? d : null;
  }
  function bookingAddDays(date, days) { const d = new Date(date.getFullYear(), date.getMonth(), date.getDate()); d.setDate(d.getDate() + days); return d; }
  function bookingFmt(date) { return date.getFullYear() + '-' + String(date.getMonth()+1).padStart(2,'0') + '-' + String(date.getDate()).padStart(2,'0'); }
  function bookingDisplay(date) {
    return date ? String(date.getDate()).padStart(2, '0') + '-' +
      String(date.getMonth() + 1).padStart(2, '0') + '-' + date.getFullYear() : '—';
  }
  function bookingCalculate() {
    const mode = pregnancyMethod.value || 'LMP';
    pregnancyDatingMethod.value = mode;
    pregnancyUsgFields.style.display = mode === 'USG' ? '' : 'none';
    // Do not submit stale values from a previously selected dating method.
    pregnancyConceptionDate.value = '';
    pregnancyReferenceHidden.value = '';
    pregnancyUsgDate.value = '';
    pregnancyUsgEdd.value = '';
    const labels = {LMP:'1st day of LMP',CONCEPTION:'Conception date',EDD:'Estimated due date',USG:'USG / Ultrasound scan date',USG_EDD:'USG / Ultrasound EDD'};
    pregnancyReferenceLabel.textContent = labels[mode] || 'Date';
    if (pregnancyStatus.value !== 'PREGNANT') {
      pregnancyResult.style.display='none'; pregnancyError.style.display='none'; pregnancyLmp.value='';
      pregnancyConceptionDate.value = '';
      pregnancyReferenceHidden.value = '';
      pregnancyUsgDate.value = '';
      pregnancyUsgEdd.value = '';
      return true;
    }
    const ref = bookingParseDate(pregnancyReferenceDate.value);
    let calculatedLmp = null;
    if (mode === 'USG') {
      const weeks = Number(pregnancyUsgWeeks.value), days = Number(pregnancyUsgDays.value || 0);
      if (!ref || pregnancyUsgWeeks.value.trim() === '' || !Number.isInteger(weeks) || !Number.isInteger(days) || weeks < 0 || weeks > 45 || days < 0 || days > 6) {
        pregnancyError.textContent='Enter the USG/ultrasound scan date and valid gestational age (weeks 0–45, days 0–6).'; pregnancyError.style.display=''; pregnancyResult.style.display='none'; return false;
      }
      calculatedLmp = bookingAddDays(ref, -(weeks*7+days)); pregnancyUsgDate.value=bookingFmt(ref); pregnancyUsgEdd.value='';
    } else if (mode === 'USG_EDD') {
      if (!ref) { pregnancyError.textContent='Enter the EDD stated in the USG/ultrasound report.'; pregnancyError.style.display=''; pregnancyResult.style.display='none'; return false; }
      calculatedLmp = bookingAddDays(ref,-280); pregnancyUsgDate.value=''; pregnancyUsgEdd.value=bookingFmt(ref);
    } else {
      if (!ref) { pregnancyError.textContent='Enter a valid pregnancy dating date.'; pregnancyError.style.display=''; pregnancyResult.style.display='none'; return false; }
      calculatedLmp = mode==='CONCEPTION' ? bookingAddDays(ref,-14) : (mode==='EDD' ? bookingAddDays(ref,-280) : ref);
      pregnancyConceptionDate.value = mode==='CONCEPTION' ? bookingFmt(ref) : '';
      pregnancyReferenceHidden.value = mode==='EDD' ? bookingFmt(ref) : '';
      pregnancyUsgDate.value=''; pregnancyUsgEdd.value='';
    }
    // Match the server calculation: when booking for a future OPD date,
    // calculate gestational age as of that appointment date.
    const selectedAppointmentDate = bookingParseDate(dateInput.value);
    const today = new Date();
    const asOf = selectedAppointmentDate || new Date(today.getFullYear(),today.getMonth(),today.getDate());
    if (calculatedLmp > asOf) { pregnancyError.textContent='The calculated LMP cannot be in the future.'; pregnancyError.style.display=''; pregnancyResult.style.display='none'; return false; }
    const elapsed=Math.floor((asOf-calculatedLmp)/86400000), weeks=Math.floor(elapsed/7), days=elapsed%7, due=bookingAddDays(calculatedLmp,280), remaining=Math.max(0,280-elapsed);
    pregnancyLmp.value=bookingFmt(calculatedLmp);
    document.getElementById('bookingGaResult').textContent=weeks+' weeks '+days+' days';
    document.getElementById('bookingEddResult').textContent=bookingDisplay(due);
    document.getElementById('bookingTrimesterResult').textContent=weeks<14?'First trimester':(weeks<28?'Second trimester':'Third trimester');
    document.getElementById('bookingRemainingResult').textContent=Math.floor(remaining/7)+'w '+(remaining%7)+'d';
    document.getElementById('bookingDerivedLmp').textContent=bookingDisplay(calculatedLmp);
    document.getElementById('bookingConception').textContent=bookingDisplay(bookingAddDays(calculatedLmp,14));
    pregnancyError.style.display='none'; pregnancyResult.style.display=''; return true;
  }
  dateInput && dateInput.addEventListener('change', bookingCalculate);
  pregnancyStatus && pregnancyStatus.addEventListener('change', bookingCalculate);
  pregnancyMethod && pregnancyMethod.addEventListener('change', bookingCalculate);
  pregnancyReferenceDate && pregnancyReferenceDate.addEventListener('change', bookingCalculate);
  [pregnancyUsgWeeks,pregnancyUsgDays].forEach(function(el){ el && el.addEventListener('input',bookingCalculate); });
  pregnancyStatus?.closest('form')?.addEventListener('submit', function(e) {
    if (pregnancyStatus.value === 'PREGNANT' && !bookingCalculate()) {
      e.preventDefault();
      pregnancyError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
  bookingCalculate();
})();
</script>
