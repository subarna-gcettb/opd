<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<h4 class="mb-3">Book OPD Appointment</h4>

<form method="POST" action="/opd/appointments/new" class="card" id="bookingForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="patientId" id="patientId" value="<%= patient ? patient.id : '' %>">
  <input type="hidden" name="healthId" id="healthIdField" value="<%= patient ? patient.health_id : '' %>">

  <div class="card-body">
    <!-- STEP 1: PATIENT -->
    <h6 class="text-uppercase text-muted small mb-2">1. Patient</h6>
    <div id="patientPicker" class="<%= patient ? 'd-none' : '' %>">
      <div class="input-group mb-2">
        <input type="text" id="patientSearch" class="form-control" placeholder="Search by Health ID, name or mobile…">
        <button class="btn btn-outline-secondary" type="button" id="patientSearchBtn">Search</button>
      </div>
      <div id="patientResults"></div>
    </div>
    <div id="patientSelected" class="alert alert-success d-flex justify-content-between align-items-center <%= patient ? '' : 'd-none' %>">
      <div>
        <strong id="selPatientName"><%= patient ? patient.name : '' %></strong>
        &middot; Health ID <code id="selPatientHid"><%= patient ? patient.health_id : '' %></code>
        &middot; <span id="selPatientMeta"><%= patient ? (patient.age_years || '—') + ' / ' + patient.gender : '' %></span>
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="changePatientBtn">Change</button>
    </div>

    <hr class="my-4">

    <!-- STEP 2: DOCTOR -->
    <h6 class="text-uppercase text-muted small mb-2">2. Branch, Department &amp; Doctor</h6>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label">Branch *</label>
        <select name="branchId" id="branchId" class="form-select" required>
          <% branches.forEach(function(b, i) { %>
            <option value="<%= b.id %>" <%= i === 0 ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Department *</label>
        <select name="departmentId" id="departmentId" class="form-select" required>
          <option value="">Select department</option>
          <% departments.forEach(function(d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Doctor *</label>
        <select name="doctorId" id="doctorId" class="form-select" required disabled>
          <option value="">Select department first</option>
        </select>
      </div>
    </div>

    <hr class="my-4">

    <!-- STEP 3: SLOT -->
    <h6 class="text-uppercase text-muted small mb-2">3. Date &amp; Time Slot</h6>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label">Appointment Date *</label>
        <input type="text" name="appointmentDate" id="appointmentDate" class="form-control" value="" placeholder="Select an available date" autocomplete="off" required>
<div id="dateAvailabilityHint" class="form-text">Select a doctor first. Only that doctor's available OPD dates will be enabled.</div>
      </div>
      <div class="col-md-9">
        <label class="form-label">Available Slots *</label>
        <div id="slotContainer" class="border rounded p-3 bg-light" style="min-height: 72px;">
          <span class="text-muted small">Select a doctor and date to see available slots.</span>
        </div>
        <input type="hidden" name="slotTime" id="slotTime" required>
      </div>
    </div>

    <hr class="my-4">

    <h6 class="text-uppercase text-muted small mb-2">4. Reason / Chief Complaint</h6>
    <textarea name="reason" class="form-control" rows="2" placeholder="e.g. Fever and body ache for 3 days"></textarea><div class="col-12 obstetric-section" style="display:none"><div class="alert alert-info small mb-2"><strong>Women’s health / pregnancy details</strong> — these values are calculated and shown to the doctor for clinical context.</div><div class="row g-2"><div class="col-md-3"><label class="form-label small">LMP</label><input type="date" name="lmpDate" id="lmpDate" class="form-control"></div><div class="col-md-2"><label class="form-label small">Pregnancy</label><select name="pregnancyStatus" id="pregnancyStatus" class="form-select"><option value="UNKNOWN">Unknown</option><option value="NOT_PREGNANT">Not pregnant</option><option value="PREGNANT">Pregnant</option></select></div><div class="col-md-2"><label class="form-label small">Gravida</label><input type="number" name="gravida" min="0" class="form-control"></div><div class="col-md-2"><label class="form-label small">Para</label><input type="number" name="para" min="0" class="form-control"></div><div class="col-md-2"><label class="form-label small">Abortions</label><input type="number" name="abortions" min="0" class="form-control"></div><div class="col-md-12"><label class="form-label small">Obstetric notes</label><textarea name="obstetricNotes" class="form-control" rows="2"></textarea></div></div></div>
  </div>

  <div class="card-footer d-flex justify-content-end gap-2">
    <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary" id="submitBtn"><i class="bi bi-calendar-check"></i> Confirm Appointment</button>
  </div>
</form>

<script>
(function () {
  const patientSearch = document.getElementById('patientSearch');
  const patientResults = document.getElementById('patientResults');
  const patientPicker = document.getElementById('patientPicker');
  const patientSelected = document.getElementById('patientSelected');
  const patientIdField = document.getElementById('patientId');
  const obstetricSection = document.querySelector('.obstetric-section');
  function toggleObstetric(gender) { if (obstetricSection) obstetricSection.style.display = String(gender || '').toLowerCase() === 'female' ? '' : 'none'; }

  function runPatientSearch() {
    const q = patientSearch.value.trim();
    if (q.length < 2) return;
    patientResults.innerHTML = '<div class="text-muted small">Searching…</div>';
    fetch('/patients/search/results?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.results.length) {
          patientResults.innerHTML = '<div class="alert alert-warning py-2 mb-0">No patient found. ' +
            '<a href="/patients/new">Register a new patient</a> first.</div>';
          return;
        }
        patientResults.innerHTML = '<div class="list-group">' + data.results.map(function (p) {
          return '<button type="button" class="list-group-item list-group-item-action" ' +
            'data-id="' + p.id + '" data-name="' + p.name + '" data-hid="' + p.health_id + '" ' +
            'data-meta="' + (p.age_years || '—') + ' / ' + p.gender + '" data-gender="' + p.gender + '">' +
            '<strong>' + p.name + '</strong> <code>' + p.health_id + '</code> · ' +
            (p.age_years || '—') + '/' + p.gender + ' · ' + p.mobile + '</button>';
        }).join('') + '</div>';
      })
      .catch(() => { patientResults.innerHTML = '<div class="text-danger small">Search failed.</div>'; });
  }

  document.getElementById('patientSearchBtn').addEventListener('click', runPatientSearch);
  patientSearch && patientSearch.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); runPatientSearch(); }
  });

  patientResults.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-id]');
    if (!btn) return;
    patientIdField.value = btn.dataset.id;
    document.getElementById('healthIdField').value = btn.dataset.hid;
    document.getElementById('selPatientName').textContent = btn.dataset.name;
    document.getElementById('selPatientHid').textContent = btn.dataset.hid;
    document.getElementById('selPatientMeta').textContent = btn.dataset.meta;
    toggleObstetric(btn.dataset.gender);
    patientPicker.classList.add('d-none');
    patientSelected.classList.remove('d-none');
    toggleObstetric('<%= patient ? patient.gender : '' %>');
  });

  document.getElementById('changePatientBtn').addEventListener('click', function () {
    patientIdField.value = '';
    patientSelected.classList.add('d-none');
    patientPicker.classList.remove('d-none');
  });

  // Department -> doctors cascade
  const deptSel = document.getElementById('departmentId');
  const docSel = document.getElementById('doctorId');
  const branchSel = document.getElementById('branchId');

  function loadDoctors() {
    const deptId = deptSel.value;
    if (!deptId) { docSel.innerHTML = '<option value="">Select department first</option>'; docSel.disabled = true; return; }
    docSel.disabled = true;
    docSel.innerHTML = '<option value="">Loading…</option>';
    fetch('/doctors/api/list?departmentId=' + deptId + '&branchId=' + branchSel.value, { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.doctors.length) {
          docSel.innerHTML = '<option value="">No doctors in this department</option>';
          return;
        }
        docSel.innerHTML = '<option value="">Select doctor</option>' + data.doctors.map(function (d) {
          return '<option value="' + d.id + '">' + d.name + ' (₹' + Number(d.consultation_fee).toFixed(2) + ')</option>';
        }).join('');
        docSel.disabled = false;
      });
  }
  deptSel.addEventListener('change', loadDoctors);
  branchSel.addEventListener('change', loadDoctors);

  // Doctor + date -> slots. The calendar is restricted to dates where
  // the selected doctor actually has an available OPD slot.
  const dateInput = document.getElementById('appointmentDate');
  const slotContainer = document.getElementById('slotContainer');
  const slotTimeField = document.getElementById('slotTime');
  const dateHint = document.getElementById('dateAvailabilityHint');
  let availableDatePicker = null;
  let availableDates = [];

  function initDatePicker() {
    if (!window.flatpickr) return;
    if (availableDatePicker) availableDatePicker.destroy();
    availableDatePicker = flatpickr(dateInput, {
      dateFormat: 'Y-m-d',
      minDate: '<%= today %>',
      disable: [function(date) {
        const value = [
          date.getFullYear(),
          String(date.getMonth() + 1).padStart(2, '0'),
          String(date.getDate()).padStart(2, '0')
        ].join('-');
        return availableDates.length === 0 || !availableDates.includes(value);
      }],
      onChange: function(selectedDates, dateStr) {
        if (dateStr) loadSlots();
      }
    });
  }

  function loadAvailableDates() {
    const doctorId = docSel.value;
    slotTimeField.value = '';
    slotContainer.innerHTML = '<span class="text-muted small">Select a date to see available slots.</span>';
    if (!doctorId) {
      availableDates = [];
      if (dateHint) dateHint.textContent = "Select a doctor first. Only that doctor's available OPD dates will be enabled.";
      initDatePicker();
      return;
    }
    if (dateHint) dateHint.textContent = 'Checking the doctor schedule and live slot capacity…';
    fetch('/doctors/' + doctorId + '/available-dates?from=<%= today %>&days=90', { headers: { Accept: 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        availableDates = Array.isArray(data.dates) ? data.dates : [];
        initDatePicker();
        if (!availableDates.length) {
          dateHint.textContent = 'This doctor has no available OPD dates in the next 90 days.';
          return;
        }
        dateHint.textContent = availableDates.length + ' available OPD date(s) found. Unavailable dates are disabled.';
        const current = dateInput.value;
        if (!availableDates.includes(current)) {
          availableDatePicker.setDate(availableDates[0], true);
        } else {
          loadSlots();
        }
      })
      .catch(function() {
        availableDates = [];
        initDatePicker();
        if (dateHint) dateHint.textContent = 'Could not load doctor availability. Please try again.';
      });
  }

  function loadSlots() {
    const doctorId = docSel.value;
    const date = dateInput.value;
    slotTimeField.value = '';
    if (!doctorId || !date) {
      slotContainer.innerHTML = '<span class="text-muted small">Select a doctor and date to see available slots.</span>';
      return;
    }
    slotContainer.innerHTML = '<span class="text-muted small">Loading slots…</span>';
    fetch('/doctors/' + doctorId + '/slots?date=' + date, { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.slots.length) {
          slotContainer.innerHTML = '<div class="text-danger small">This doctor holds no OPD on the selected date (no schedule, holiday, or on leave).</div>';
          return;
        }
        slotContainer.innerHTML = data.slots.map(function (s) {
          const disabled = s.available <= 0 ? 'disabled' : '';
          const cls = s.available <= 0 ? 'btn-outline-secondary' : 'btn-outline-primary';
          return '<button type="button" class="btn btn-sm ' + cls + ' m-1 slot-btn" ' + disabled +
            ' data-time="' + s.time + '">' + s.label +
            (s.capacity > 1 ? ' <span class="badge text-bg-light">' + s.available + '/' + s.capacity + '</span>' : '') +
            '</button>';
        }).join('');
      });
  }

  docSel.addEventListener('change', function () { loadAvailableDates(); });
  initDatePicker();

  slotContainer.addEventListener('click', function (e) {
    const btn = e.target.closest('.slot-btn');
    if (!btn || btn.disabled) return;
    slotContainer.querySelectorAll('.slot-btn').forEach(function (b) {
      b.classList.remove('btn-primary', 'active');
      if (!b.disabled) b.classList.add('btn-outline-primary');
    });
    btn.classList.remove('btn-outline-primary');
    btn.classList.add('btn-primary', 'active');
    slotTimeField.value = btn.dataset.time;
  });

  document.getElementById('bookingForm').addEventListener('submit', function (e) {
    if (!patientIdField.value) { e.preventDefault(); alert('Please select a patient.'); return; }
    if (!slotTimeField.value) { e.preventDefault(); alert('Please select a time slot.'); }
  });
})();
</script>
