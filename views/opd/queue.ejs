<%
  const statusBadge = { WAITING: 'secondary', CALLED: 'warning', IN_CONSULTATION: 'info', COMPLETED: 'success', CANCELLED: 'danger' };
  const counts = rows.reduce(function(acc, r) { acc[r.visit_status] = (acc[r.visit_status] || 0) + 1; return acc; }, {});
%>

<h4 class="mb-3">Today's OPD Queue</h4>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">Date</label>
        <input type="date" name="date" class="form-control form-control-sm" value="<%= date %>">
      </div>
      <div class="col-md-4">
        <label class="form-label small">Doctor</label>
        <select name="doctorId" class="form-select form-select-sm">
          <option value="">All doctors</option>
          <% doctors.forEach(function(d) { %>
            <option value="<%= d.id %>" <%= String(doctorId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Filter</button></div>
    </form>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value"><%= rows.length %></div><div class="stat-label">In Queue</div></div></div>
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value"><%= counts.WAITING || 0 %></div><div class="stat-label">Waiting</div></div></div>
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value"><%= counts.IN_CONSULTATION || 0 %></div><div class="stat-label">In Consultation</div></div></div>
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value"><%= counts.COMPLETED || 0 %></div><div class="stat-label">Completed</div></div></div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr><th>Token</th><th>Patient</th><th>Age / Gender</th><th>Doctor</th><th>Time</th><th>Status</th><th>Payment</th><th>Update</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r) { %>
          <tr>
            <td><span class="token-badge"><%= String(r.token_number).padStart(3,'0') %></span></td>
            <td><a href="/patients/<%= r.health_id %>"><%= r.patient_name %></a><div class="text-muted small"><%= r.health_id %></div></td>
            <td><%= r.age_years || '—' %> / <%= r.gender %></td>
            <td><%= r.doctor_name %></td>
            <td><%= r.slot_time.slice(0,5) %></td>
            <td><span class="badge text-bg-<%= statusBadge[r.visit_status] || 'secondary' %>"><%= r.visit_status.replace('_',' ') %></span></td>
            <td>
              <% if (!r.invoice_id) { %>
                <span class="badge text-bg-light text-dark">No Bill</span>
              <% } else if (r.payment_status === 'PAID') { %>
                <a href="/billing/invoices/<%= r.invoice_id %>" class="badge text-bg-success text-decoration-none">Paid</a>
              <% } else { %>
                <a href="/billing/invoices/<%= r.invoice_id %>" class="badge text-bg-warning text-decoration-none">Unpaid — ₹<%= Number(r.net_amount).toFixed(2) %></a>
              <% } %>
            </td>
            <td>
              <div class="d-flex gap-1 flex-wrap">
                <% if (r.visit_status === 'WAITING') { %>
                  <form method="POST" action="/opd/visits/<%= r.visit_id %>/status">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="CALLED">
                    <button class="btn btn-sm btn-warning">Call</button>
                  </form>
                <% } %>
                <% if (r.visit_status === 'CALLED') { %>
                  <form method="POST" action="/opd/visits/<%= r.visit_id %>/status">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="IN_CONSULTATION">
                    <button class="btn btn-sm btn-info">Start Consultation</button>
                  </form>
                <% } %>
                <% if (r.visit_status === 'IN_CONSULTATION') { %>
                  <form method="POST" action="/opd/visits/<%= r.visit_id %>/status">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="COMPLETED">
                    <button class="btn btn-sm btn-success">Complete</button>
                  </form>
                <% } %>
                <a href="/opd/appointments/<%= r.appointment_id %>" class="btn btn-sm btn-outline-secondary">Open</a>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (rows.length === 0) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No patients in the queue for this date.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
