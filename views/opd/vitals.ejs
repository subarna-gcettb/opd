<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4 class="mb-1">Patient Vitals</h4><div class="text-muted"><strong><%= visit.patient_name %></strong> · <code><%= visit.health_id %></code> · Token <span class="token-badge"><%= String(visit.token_number).padStart(3,'0') %></span></div></div><a href="/opd/queue" class="btn btn-outline-secondary btn-sm">Back to Queue</a></div>
<form method="POST" action="/opd/visits/<%= visit.id %>/vitals" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-body"><div class="row g-3">
<div class="col-6 col-md-3"><label class="form-label">BP</label><input class="form-control" name="bp" placeholder="120/80" value="<%= vitals.bp || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Pulse / min</label><input type="number" class="form-control" name="pulse" value="<%= vitals.pulse || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">SpO₂ %</label><input type="number" min="0" max="100" class="form-control" name="spo2" value="<%= vitals.spo2 || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Temperature °F</label><input type="number" step="0.1" class="form-control" name="temperature" value="<%= vitals.temperature || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Height cm</label><input type="number" step="0.1" class="form-control" name="heightCm" value="<%= vitals.height_cm || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Weight kg</label><input type="number" step="0.1" class="form-control" name="weightKg" value="<%= vitals.weight_kg || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Respiratory rate</label><input type="number" class="form-control" name="respiratoryRate" value="<%= vitals.respiratory_rate || '' %>"></div>
<div class="col-6 col-md-3"><label class="form-label">Pain score (0–10)</label><input type="number" min="0" max="10" class="form-control" name="painScore" value="<%= vitals.pain_score || '' %>"></div>
</div></div><div class="card-footer text-end"><button class="btn btn-primary">Save Vitals</button></div></form>