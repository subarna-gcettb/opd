<%
  const pregnancyData = pregnancy || {};
  const editable = typeof canEdit === 'undefined' || canEdit !== false;
  const initialCalculation = pregnancyCalculation || null;
  const initialMode = initialCalculation && initialCalculation.referenceMode ? initialCalculation.referenceMode : (pregnancyData.pregnancy_dating_method || 'LMP');
  const initialReference = initialCalculation && initialCalculation.referenceDate
    ? initialCalculation.referenceDate
    : (initialMode === 'USG_EDD' ? (pregnancyData.usg_edd ? String(pregnancyData.usg_edd).slice(0, 10) : '')
      : (initialMode === 'USG' ? (pregnancyData.usg_date ? String(pregnancyData.usg_date).slice(0, 10) : '')
      : (pregnancyData.lmp_date ? String(pregnancyData.lmp_date).slice(0, 10) : '')));
%>
<div class="card mb-3 pregnancy-assessment-card" data-pregnancy-widget data-editable="<%= editable ? '1' : '0' %>">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-gender-female me-1"></i> <strong>Female / Obstetric Assessment</strong></span>
    <span class="badge text-bg-success-subtle text-success-emphasis">Pregnancy dating</span>
  </div>
  <div class="card-body">
    <div class="alert alert-info small mb-3">
      <strong>Automatic Pregnancy Calculator</strong> — calculate gestational age and EDD from LMP, conception date, an established EDD, or USG / ultrasound dating. Confirm clinical dating against the ultrasound report when appropriate.
    </div>

    <div class="row g-3">
      <div class="col-12 col-md-4">
        <label class="form-label small">Pregnancy status</label>
        <select name="pregnancyStatus" class="form-select" data-pregnancy-status <%= editable ? '' : 'disabled' %>>
          <option value="UNKNOWN" <%= pregnancyData.pregnancy_status === 'UNKNOWN' || !pregnancyData.pregnancy_status ? 'selected' : '' %>>Unknown / not assessed</option>
          <option value="NOT_PREGNANT" <%= pregnancyData.pregnancy_status === 'NOT_PREGNANT' ? 'selected' : '' %>>Not pregnant</option>
          <option value="PREGNANT" <%= pregnancyData.pregnancy_status === 'PREGNANT' ? 'selected' : '' %>>Pregnant</option>
        </select>
      </div>

      <div class="col-12 col-md-4" data-pregnancy-method-wrap>
        <label class="form-label small">I know</label>
        <select class="form-select" data-pregnancy-method <%= editable ? '' : 'disabled' %>>
          <option value="LMP" <%= initialMode === 'LMP' ? 'selected' : '' %>>1st day of LMP</option>
          <option value="CONCEPTION" <%= initialMode === 'CONCEPTION' ? 'selected' : '' %>>Conception date</option>
          <option value="EDD" <%= initialMode === 'EDD' ? 'selected' : '' %>>Estimated due date</option>
          <option value="USG" <%= initialMode === 'USG' ? 'selected' : '' %>>USG / Ultrasound — gestational age</option>
          <option value="USG_EDD" <%= initialMode === 'USG_EDD' ? 'selected' : '' %>>USG / Ultrasound — EDD</option>
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label class="form-label small" data-pregnancy-reference-label>Date</label>
        <input type="date" class="form-control" data-pregnancy-reference value="<%= initialReference %>" <%= editable ? '' : 'readonly' %>>
      </div>

      <div class="col-12 col-md-6" data-pregnancy-usg-fields style="display:none">
        <label class="form-label small">USG / Ultrasound gestational age at scan</label>
        <div class="input-group">
          <input type="number" min="0" max="45" name="usgGestationalAgeWeeks" data-pregnancy-usg-weeks class="form-control" value="<%= pregnancyData.usg_gestational_age_weeks ?? '' %>" <%= editable ? '' : 'readonly' %>>
          <span class="input-group-text">weeks</span>
          <input type="number" min="0" max="6" name="usgGestationalAgeDays" data-pregnancy-usg-days class="form-control" value="<%= pregnancyData.usg_gestational_age_days ?? '0' %>" <%= editable ? '' : 'readonly' %>>
          <span class="input-group-text">days</span>
        </div>
      </div>

      <input type="hidden" name="pregnancyDatingMethod" data-pregnancy-dating-method value="<%= initialMode %>">
      <input type="hidden" name="conceptionDate" data-pregnancy-conception-input>
      <input type="hidden" name="referenceDate" data-pregnancy-reference-input>
      <input type="hidden" name="usgDate" data-pregnancy-usg-date value="<%= pregnancyData.usg_date ? String(pregnancyData.usg_date).slice(0,10) : '' %>">
      <input type="hidden" name="usgEdd" data-pregnancy-usg-edd value="<%= pregnancyData.usg_edd ? String(pregnancyData.usg_edd).slice(0,10) : '' %>">

      <input type="hidden" name="lmpDate" data-pregnancy-lmp value="<%= pregnancyData.lmp_date ? String(pregnancyData.lmp_date).slice(0,10) : '' %>">

      <div class="col-6 col-md-4">
        <label class="form-label small">Gravida (G)</label>
        <input type="number" min="0" name="gravida" class="form-control" value="<%= pregnancyData.gravida ?? '' %>" <%= editable ? '' : 'readonly' %>>
      </div>
      <div class="col-6 col-md-4">
        <label class="form-label small">Para (P)</label>
        <input type="number" min="0" name="para" class="form-control" value="<%= pregnancyData.para ?? '' %>" <%= editable ? '' : 'readonly' %>>
      </div>
      <div class="col-6 col-md-4">
        <label class="form-label small">Abortions (A)</label>
        <input type="number" min="0" name="abortions" class="form-control" value="<%= pregnancyData.abortions ?? '' %>" <%= editable ? '' : 'readonly' %>>
      </div>

      <div class="col-12" data-pregnancy-error style="display:none">
        <div class="alert alert-danger mb-0"></div>
      </div>
    </div>

    <div class="pregnancy-calculator-result mt-3" data-pregnancy-results style="display:none">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="small text-uppercase fw-bold">Current calculation</div>
        <span class="badge text-bg-light border" data-pregnancy-basis></span>
      </div>
      <div class="row g-2">
        <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Gestational age</small><strong data-pregnancy-ga>—</strong></div></div>
        <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Estimated due date</small><strong data-pregnancy-edd>—</strong></div></div>
        <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Trimester</small><strong data-pregnancy-trimester>—</strong></div></div>
        <div class="col-6 col-md-3"><div class="pregnancy-stat"><small>Remaining</small><strong data-pregnancy-remaining>—</strong></div></div>
      </div>
      <div class="row g-2 mt-2 small">
        <div class="col-md-4"><strong>Calculated LMP:</strong> <span data-pregnancy-derived-lmp>—</span></div>
        <div class="col-md-4"><strong>Estimated conception:</strong> <span data-pregnancy-conception>—</span></div>
        <div class="col-md-4"><strong>Status:</strong> <span data-pregnancy-term-status>—</span></div>
      </div>
    </div>

    <div class="mt-3">
      <label class="form-label small">Obstetric notes</label>
      <textarea name="obstetricNotes" class="form-control" rows="2" placeholder="Relevant pregnancy / obstetric history" <%= editable ? '' : 'readonly' %>><%= pregnancyData.obstetric_notes || '' %></textarea>
    </div>
  </div>
</div>

<script>
(function () {
  document.querySelectorAll('[data-pregnancy-widget]').forEach(function (root) {
    if (root.dataset.pregnancyInitialized === '1') return;
    root.dataset.pregnancyInitialized = '1';

  const status = root.querySelector('[data-pregnancy-status]');
  const method = root.querySelector('[data-pregnancy-method]');
  const reference = root.querySelector('[data-pregnancy-reference]');
  const referenceLabel = root.querySelector('[data-pregnancy-reference-label]');
  const lmp = root.querySelector('[data-pregnancy-lmp]');
  const datingMethod = root.querySelector('[data-pregnancy-dating-method]');
  const conceptionInput = root.querySelector('[data-pregnancy-conception-input]');
  const referenceInput = root.querySelector('[data-pregnancy-reference-input]');
  const usgDateInput = root.querySelector('[data-pregnancy-usg-date]');
  const usgEddInput = root.querySelector('[data-pregnancy-usg-edd]');
  const usgFields = root.querySelector('[data-pregnancy-usg-fields]');
  const usgWeeks = root.querySelector('[data-pregnancy-usg-weeks]');
  const usgDays = root.querySelector('[data-pregnancy-usg-days]');
  const results = root.querySelector('[data-pregnancy-results]');
  const error = root.querySelector('[data-pregnancy-error]');
  const ga = root.querySelector('[data-pregnancy-ga]');
  const edd = root.querySelector('[data-pregnancy-edd]');
  const trimester = root.querySelector('[data-pregnancy-trimester]');
  const remaining = root.querySelector('[data-pregnancy-remaining]');
  const derivedLmp = root.querySelector('[data-pregnancy-derived-lmp]');
  const conception = root.querySelector('[data-pregnancy-conception]');
  const basis = root.querySelector('[data-pregnancy-basis]');
  const termStatus = root.querySelector('[data-pregnancy-term-status]');

  function parseDate(value) {
    const m = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return null;
    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    return d.getFullYear() === Number(m[1]) && d.getMonth() === Number(m[2]) - 1 && d.getDate() === Number(m[3]) ? d : null;
  }
  function addDays(date, days) {
    const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    d.setDate(d.getDate() + days);
    return d;
  }
  function fmt(date) {
    return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
  }
  function display(date) {
    if (!date) return '—';
    return String(date.getDate()).padStart(2, '0') + '-' +
      String(date.getMonth() + 1).padStart(2, '0') + '-' + date.getFullYear();
  }
  function calculate() {
    const mode = String(method.value || 'LMP').toUpperCase();
    datingMethod.value = mode;
    // Clear values from the previously selected dating method before
    // populating only the fields that belong to the current method.
    conceptionInput.value = '';
    referenceInput.value = '';
    usgDateInput.value = '';
    usgEddInput.value = '';

    if (status.value !== 'PREGNANT') {
      results.style.display = 'none';
      error.style.display = 'none';
      lmp.value = '';
      conceptionInput.value = '';
      referenceInput.value = '';
      usgDateInput.value = '';
      usgEddInput.value = '';
      return true;
    }

    const ref = parseDate(reference.value);
    const today = new Date();
    const asOf = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    let calculatedLmp = null;
    let due = null;
    let scanDate = null;

    if (mode === 'USG' || mode === 'USG_EDD') {
      scanDate = mode === 'USG' ? ref : null;
      if (mode === 'USG') {
        const weeks = Number(usgWeeks.value);
        const days = Number(usgDays.value || 0);
        if (!scanDate || usgWeeks.value.trim() === '' || !Number.isInteger(weeks) || !Number.isInteger(days) || weeks < 0 || weeks > 45 || days < 0 || days > 6) {
          results.style.display = 'none';
          error.style.display = '';
          error.querySelector('.alert').textContent = 'Enter the USG/ultrasound scan date and valid gestational age (weeks 0–45, days 0–6).';
          return false;
        }
        calculatedLmp = addDays(scanDate, -(weeks * 7 + days));
        usgDateInput.value = fmt(scanDate);
        usgEddInput.value = '';
      } else {
        if (!ref) {
          results.style.display = 'none';
          error.style.display = '';
          error.querySelector('.alert').textContent = 'Enter the EDD stated in the USG/ultrasound report.';
          return false;
        }
        calculatedLmp = addDays(ref, -280);
        usgDateInput.value = '';
        usgEddInput.value = fmt(ref);
      }
    } else {
      if (!ref) {
        results.style.display = 'none';
        error.style.display = '';
        error.querySelector('.alert').textContent = 'Enter a valid pregnancy dating date.';
        return false;
      }
      calculatedLmp = ref;
      if (mode === 'CONCEPTION') calculatedLmp = addDays(ref, -14);
      if (mode === 'EDD') calculatedLmp = addDays(ref, -280);
      conceptionInput.value = mode === 'CONCEPTION' ? fmt(ref) : '';
      referenceInput.value = mode === 'EDD' ? fmt(ref) : '';
      usgDateInput.value = '';
      usgEddInput.value = '';
    }

    if (!calculatedLmp || calculatedLmp > asOf) {
      results.style.display = 'none';
      error.style.display = '';
      error.querySelector('.alert').textContent = 'The calculated LMP cannot be in the future.';
      return false;
    }

    const elapsed = Math.floor((asOf - calculatedLmp) / 86400000);
    const weeks = Math.floor(elapsed / 7);
    const days = elapsed % 7;
    due = addDays(calculatedLmp, 280);
    const conceptionDate = addDays(calculatedLmp, 14);
    const remainingDays = Math.max(0, 280 - elapsed);

    lmp.value = fmt(calculatedLmp);
    ga.textContent = weeks + ' weeks ' + days + ' days';
    edd.textContent = display(due);
    trimester.textContent = weeks < 14 ? 'First trimester' : (weeks < 28 ? 'Second trimester' : 'Third trimester');
    remaining.textContent = Math.floor(remainingDays / 7) + 'w ' + (remainingDays % 7) + 'd';
    derivedLmp.textContent = display(calculatedLmp);
    conception.textContent = display(conceptionDate);
    basis.textContent = mode === 'USG' ? 'USG / Ultrasound gestational age' :
      (mode === 'USG_EDD' ? 'USG / Ultrasound EDD' :
      (mode === 'CONCEPTION' ? 'Conception date' : (mode === 'EDD' ? 'Estimated due date' : 'LMP')));
    termStatus.textContent = elapsed > 280 ? 'Past estimated due date' : 'Within estimated pregnancy period';
    results.style.display = '';
    error.style.display = 'none';
    return true;
  }
  function updateLabel() {
    const labels = { LMP: '1st day of LMP', CONCEPTION: 'Conception date', EDD: 'Estimated due date', USG: 'USG / Ultrasound scan date', USG_EDD: 'USG / Ultrasound EDD' };
    referenceLabel.textContent = labels[method.value] || 'Date';
    usgFields.style.display = method.value === 'USG' ? '' : 'none';
  }

  status.addEventListener('change', calculate);
  method.addEventListener('change', function () { updateLabel(); calculate(); });
  [usgWeeks, usgDays].forEach(function (field) { field.addEventListener('input', calculate); });
  reference.addEventListener('change', calculate);
  updateLabel();
  calculate();

  root.closest('form')?.addEventListener('submit', function (event) {
    if (status.value === 'PREGNANT' && !calculate()) {
      event.preventDefault();
      error.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
  });
})();
</script>
