<style>
  .landing-topbar { background: var(--hms-sidebar-bg); color: #fff; padding: .9rem 0; position: sticky; top: 0; z-index: 20; }
  .landing-topbar .container { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; }
  .landing-topbar .brand { display: flex; align-items: center; gap: .5rem; font-weight: 700; letter-spacing: .04em; }
  .landing-topbar nav a { color: #dcefec; text-decoration: none; font-size: .92rem; margin: 0 .5rem; white-space: nowrap; }
  .landing-topbar nav a.active, .landing-topbar nav a:hover { color: #fff; }
  .landing-body { background: var(--hms-bg); }
  .landing-hero { background: linear-gradient(135deg, var(--hms-primary-dark), var(--hms-primary)); color: #fff; padding: 2.75rem 0; }
  .landing-hero h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: .5rem; }
  .landing-hero p.lead { color: #d9efec; font-size: 1rem; max-width: 640px; }
  .landing-section { padding: 2.75rem 0; }
  .landing-section h2 { font-size: 1.4rem; font-weight: 700; color: var(--hms-primary-dark); margin-bottom: 1.25rem; }
  .doctor-card, .service-card { background: #fff; border: 1px solid var(--hms-border); border-radius: .6rem; padding: 1.1rem; height: 100%; }
  .doctor-card .avatar { width: 46px; height: 46px; border-radius: 50%; background: var(--hms-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
  .landing-footer { background: var(--hms-sidebar-bg); color: #b9ddd6; padding: 2rem 0; font-size: .85rem; margin-top: auto; }
  .landing-footer a { color: #dcefec; }
</style>

<div class="landing-topbar">
  <div class="container landing-nav-container">
    <a href="/" class="brand text-decoration-none text-white" aria-label="<%= siteSettings.hospital_name %> home">
      <span class="brand-mark"><% if (siteSettings.logo_path) { %><img src="<%= siteSettings.logo_path %>" alt=""><% } else { %><i class="bi bi-hospital"></i><% } %></span>
      <span class="brand-name"><%= siteSettings.hospital_name %></span>
    </a>
    <nav class="public-desktop-nav" aria-label="Primary navigation">
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
      <a href="/patient-portal-info" class="<%= currentPage === 'patient-portal' ? 'active' : '' %>">Patient Portal</a>
      <a href="/services" class="<%= currentPage === 'services' ? 'active' : '' %>">Services</a>
      <a href="/our-doctors" class="<%= currentPage === 'doctors' ? 'active' : '' %>">Doctors</a>
      <a href="/lab-diagnostics" class="<%= currentPage === 'lab' ? 'active' : '' %>">Diagnostics</a>
      <a href="/live-opd" class="<%= currentPage === 'live-opd' ? 'active' : '' %>">Live OPD</a>
      <a href="/contact" class="<%= currentPage === 'contact' ? 'active' : '' %>">Contact</a>
    </nav>
    <div class="landing-nav-actions">
      <button type="button" class="btn btn-install pwa-install-nav" id="pwaInstallNav" hidden><i class="bi bi-download"></i><span>Install App</span></button>
      <a href="/auth/login" class="btn btn-signin">Sign In</a>
      <a href="/auth/signup" class="btn btn-signup">Patient Sign Up</a>
    </div>
    <div class="public-mobile-menu">
      <button class="mobile-menu-toggle" type="button" id="publicMenuToggle" aria-expanded="false" aria-controls="publicMenu">
        <i class="bi bi-list"></i><span>Menu</span>
      </button>
      <div class="public-mobile-dropdown" id="publicMenu">
        <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>"><i class="bi bi-house"></i>Home</a>
        <a href="/patient-portal-info" class="<%= currentPage === 'patient-portal' ? 'active' : '' %>"><i class="bi bi-person-vcard"></i>Patient Portal</a>
        <a href="/services" class="<%= currentPage === 'services' ? 'active' : '' %>"><i class="bi bi-heart-pulse"></i>Services</a>
        <a href="/our-doctors" class="<%= currentPage === 'doctors' ? 'active' : '' %>"><i class="bi bi-person-badge"></i>Doctors</a>
        <a href="/lab-diagnostics" class="<%= currentPage === 'lab' ? 'active' : '' %>"><i class="bi bi-eyedropper"></i>Diagnostics</a>
        <a href="/live-opd" class="<%= currentPage === 'live-opd' ? 'active' : '' %>"><i class="bi bi-broadcast"></i>Live OPD</a>
        <a href="/contact" class="<%= currentPage === 'contact' ? 'active' : '' %>"><i class="bi bi-telephone"></i>Contact</a>
        <div class="mobile-menu-divider"></div>
        <a href="/auth/login"><i class="bi bi-box-arrow-in-right"></i>Sign In</a>
        <a href="/auth/signup"><i class="bi bi-person-plus"></i>Patient Sign Up</a>
        <button type="button" class="mobile-install-action pwa-install-mobile" id="pwaInstallMobile" hidden><i class="bi bi-download"></i>Install App</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var toggle = document.getElementById('publicMenuToggle');
  var menu = document.getElementById('publicMenu');
  if (!toggle || !menu) return;
  toggle.addEventListener('click', function (event) {
    event.stopPropagation();
    var open = menu.classList.toggle('show');
    toggle.setAttribute('aria-expanded', String(open));
  });
  menu.addEventListener('click', function (event) {
    if (event.target.closest('a')) {
      menu.classList.remove('show');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('click', function (event) {
    if (!event.target.closest('.public-mobile-menu')) {
      menu.classList.remove('show');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
  window.addEventListener('resize', function () {
    if (window.innerWidth > 991) {
      menu.classList.remove('show');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
})();
</script>
