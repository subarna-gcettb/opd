<h4 class="mb-3">Book an Appointment</h4>

<form method="POST" action="/patient-portal/book" class="card" id="bookingForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="alert alert-info small">Booking for: <strong><%= patient.name %></strong> (<code><%= patient.health_id %></code>)</div>

    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Department *</label>
        <select name="departmentId" id="departmentId" class="form-select" required>
          <option value="">Select department</option>
          <% departments.forEach(function(d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Doctor *</label>
        <select name="doctorId" id="doctorId" class="form-select" required disabled>
          <option value="">Select department first</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Date *</label>
        <input type="date" name="appointmentDate" id="appointmentDate" class="form-control" value="<%= today %>" min="<%= today %>" required>
      </div>
      <div class="col-md-9">
        <label class="form-label">Available Slots *</label>
        <div id="slotContainer" class="border rounded p-3 bg-light" style="min-height:72px;">
          <span class="text-muted small">Select a doctor and date to see available slots.</span>
        </div>
        <input type="hidden" name="slotTime" id="slotTime" required>
      </div>
      <div class="col-12">
        <label class="form-label">Reason / Chief Complaint</label>
        <textarea name="reason" class="form-control" rows="2" placeholder="e.g. Fever and body ache for 3 days"></textarea>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex justify-content-end gap-2">
    <a href="/patient-portal" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="bi bi-calendar-check"></i> Confirm Appointment</button>
  </div>
</form>

<script>
(function () {
  const deptSel = document.getElementById('departmentId');
  const docSel = document.getElementById('doctorId');
  const dateInput = document.getElementById('appointmentDate');
  const slotContainer = document.getElementById('slotContainer');
  const slotTimeField = document.getElementById('slotTime');

  function loadDoctors() {
    const deptId = deptSel.value;
    if (!deptId) { docSel.innerHTML = '<option value="">Select department first</option>'; docSel.disabled = true; return; }
    docSel.disabled = true;
    docSel.innerHTML = '<option value="">Loading…</option>';
    fetch('/patient-portal/book/doctors?departmentId=' + deptId, { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.doctors.length) { docSel.innerHTML = '<option value="">No doctors in this department</option>'; return; }
        docSel.innerHTML = '<option value="">Select doctor</option>' + data.doctors.map(function (d) {
          return '<option value="' + d.id + '">' + d.name + (d.consultation_fee ? ' (₹' + Number(d.consultation_fee).toFixed(2) + ')' : '') + '</option>';
        }).join('');
        docSel.disabled = false;
      });
  }
  deptSel.addEventListener('change', loadDoctors);

  function loadSlots() {
    const doctorId = docSel.value;
    const date = dateInput.value;
    slotTimeField.value = '';
    if (!doctorId || !date) {
      slotContainer.innerHTML = '<span class="text-muted small">Select a doctor and date to see available slots.</span>';
      return;
    }
    slotContainer.innerHTML = '<span class="text-muted small">Loading slots…</span>';
    fetch('/patient-portal/book/doctors/' + doctorId + '/slots?date=' + date, { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((data) => {
        if (!data.slots.length) {
          slotContainer.innerHTML = '<div class="text-danger small">No slots available for this doctor on the selected date.</div>';
          return;
        }
        slotContainer.innerHTML = data.slots.map(function (s) {
          const disabled = s.available <= 0 ? 'disabled' : '';
          const cls = s.available <= 0 ? 'btn-outline-secondary' : 'btn-outline-primary';
          return '<button type="button" class="btn btn-sm ' + cls + ' m-1 slot-btn" ' + disabled + ' data-time="' + s.time + '">' + s.label + '</button>';
        }).join('');
      });
  }
  docSel.addEventListener('change', loadSlots);
  dateInput.addEventListener('change', loadSlots);

  slotContainer.addEventListener('click', function (e) {
    const btn = e.target.closest('.slot-btn');
    if (!btn || btn.disabled) return;
    slotContainer.querySelectorAll('.slot-btn').forEach(function (b) {
      b.classList.remove('btn-primary'); if (!b.disabled) b.classList.add('btn-outline-primary');
    });
    btn.classList.remove('btn-outline-primary'); btn.classList.add('btn-primary');
    slotTimeField.value = btn.dataset.time;
  });

  document.getElementById('bookingForm').addEventListener('submit', function (e) {
    if (!slotTimeField.value) { e.preventDefault(); alert('Please select a time slot.'); }
  });
})();
</script>
