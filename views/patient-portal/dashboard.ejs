<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0">Welcome, <%= patient.name %></h4>
    <div class="text-muted">Health ID <code><%= patient.health_id %></code> &middot; <%= patient.branch_name %></div>
  </div>
  <a href="/patient-portal/book" class="btn btn-primary btn-sm"><i class="bi bi-calendar-plus"></i> Book an Appointment</a>
  <a href="/patient-portal/edit-profile" class="btn btn-outline-secondary btn-sm ms-2"><i class="bi bi-pencil"></i> Edit Profile</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-8">
    <div class="card h-100">
      <div class="card-header">My Information</div>
      <div class="card-body small">
        <div class="row row-cols-2 g-2">
          <div><strong>Age / Gender:</strong> <%= patient.age_years || '—' %> / <%= patient.gender %></div>
          <div><strong>Mobile:</strong> <%= patient.mobile %></div>
          <div><strong>Blood Group:</strong> <%= patient.blood_group || '—' %></div>
          <div><strong>Aadhaar:</strong> <span class="masked-aadhaar"><%= patient.aadhaar_last4 ? 'XXXX XXXX ' + patient.aadhaar_last4 : 'Not provided' %></span></div>
          <div class="col-12"><strong>Address:</strong> <%= [patient.address, patient.village_town, patient.district, patient.state, patient.pin_code].filter(Boolean).join(', ') || '—' %></div>
          <div class="col-12"><strong>Allergies:</strong> <%= patient.allergies || 'None recorded' %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 text-center">
      <div class="card-header">Barcode</div>
      <div class="card-body">
        <img src="/patient-portal/barcode" alt="Health ID barcode" style="max-width:100%;" onerror="this.style.display='none'">
        <div class="text-muted small mt-2">Show this at reception for quick lookup.</div>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header">Upcoming Appointments</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead><tr><th>Date</th><th>Time</th><th>Token</th><th>Doctor</th><th>Department</th><th>Status</th></tr></thead>
      <tbody>
        <% upcoming.forEach(function(a) { %>
          <tr>
            <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
            <td><%= a.slot_time.slice(0,5) %></td>
            <td><span class="token-badge"><%= String(a.token_number).padStart(3,'0') %></span></td>
            <td><%= a.doctor_name %></td>
            <td><%= a.department_name %></td>
            <td><span class="badge text-bg-primary"><%= a.status.replace('_',' ') %></span></td>
          </tr>
        <% }) %>
        <% if (upcoming.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-3">No upcoming appointments.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<ul class="nav nav-tabs">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#history-tab">Visit History</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#rx-tab">Prescriptions</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#bill-tab">Bills</button></li>
</ul>
<div class="tab-content card border-top-0">
  <div class="tab-pane fade show active card-body" id="history-tab">
    <table class="table table-sm mb-0">
      <thead><tr><th>Date</th><th>Doctor</th><th>Department</th><th>Diagnosis</th><th>Follow-up</th></tr></thead>
      <tbody>
        <% history.forEach(function(v) { %>
          <tr>
            <td><%= new Date(v.checked_in_at).toLocaleString() %></td>
            <td><%= v.doctor_name %></td>
            <td><%= v.department_name %></td>
            <td><%= v.diagnosis || '—' %></td>
            <td><%= v.follow_up_date ? new Date(v.follow_up_date).toLocaleDateString() : '—' %></td>
          </tr>
        <% }) %>
        <% if (history.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-3">No completed visits yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <div class="tab-pane fade card-body" id="rx-tab">
    <table class="table table-sm mb-0">
      <thead><tr><th>Date</th><th>Doctor</th><th>Prescription</th><th></th></tr></thead>
      <tbody>
        <% prescriptions.forEach(function(p) { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleDateString() %></td>
            <td><%= p.doctor_name %></td>
            <td><%= p.prescription_code %> <span class="text-muted small">v<%= p.version %></span></td>
            <td><a href="/patient-portal/prescriptions/<%= p.id %>/print" target="_blank" class="btn btn-sm btn-outline-secondary">View / Print</a></td>
          </tr>
        <% }) %>
        <% if (prescriptions.length === 0) { %><tr><td colspan="4" class="text-center text-muted py-3">No prescriptions yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <div class="tab-pane fade card-body" id="bill-tab">
    <table class="table table-sm mb-0">
      <thead><tr><th>Invoice</th><th>Date</th><th>Amount</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% invoices.forEach(function(i) { %>
          <tr>
            <td><%= i.invoice_number %></td>
            <td><%= new Date(i.created_at).toLocaleDateString() %></td>
            <td>₹<%= Number(i.net_amount).toFixed(2) %></td>
            <td><span class="badge text-bg-<%= i.status === 'PAID' ? 'success' : 'secondary' %>"><%= i.status.replace('_',' ') %></span></td>
            <td><a href="/patient-portal/invoices/<%= i.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
          </tr>
        <% }) %>
        <% if (invoices.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-3">No invoices yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
