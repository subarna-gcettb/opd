<div class="d-flex justify-content-between align-items-center mb-3"><div><h4><%= order.order_code %></h4><div class="text-muted"><%= order.laboratory_name %> · <%= order.patient_name %></div></div><a href="/patient-portal/lab" class="btn btn-outline-secondary btn-sm">Back</a></div>
<div class="card mb-3"><div class="card-body"><div class="row g-2 small"><div class="col-md-3"><strong>Order status</strong><div><span class="badge text-bg-primary"><%= order.status.replaceAll('_',' ') %></span></div></div><div class="col-md-3"><strong>Booking</strong><div><%= formatDate(order.booking_date) %></div></div><div class="col-md-3"><strong>Priority</strong><div><%= order.priority %></div></div><div class="col-md-3"><strong>Amount</strong><div>₹<%= Number(order.net_amount||0).toFixed(2) %></div></div></div></div></div>
<div class="card"><div class="card-header"><strong>Test Tracking</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Test</th><th>Sample</th><th>Status</th><th>Report</th></tr></thead><tbody>
<% items.forEach(function(i){ %><tr><td><strong><%= i.test_name_snapshot %></strong><div class="small text-muted"><%= i.test_code_snapshot %></div></td><td><%= i.sample_code||'Not collected yet' %><% if(i.barcode_value){ %><div class="small"><code><%= i.barcode_value %></code></div><% } %></td><td><span class="badge text-bg-light border"><%= i.status.replaceAll('_',' ') %></span><% if(i.sample_status){ %><div class="small text-muted">Sample: <%= i.sample_status %></div><% } %></td><td><% if(i.result_id && i.result_status==='RELEASED'){ %><a href="/patient-portal/lab/reports/<%= i.result_id %>" class="btn btn-sm btn-success">Open Report</a><% }else{ %><span class="text-muted small">Not released</span><% } %></td></tr><% }) %>
</tbody></table></div></div>
<% if(['BOOKED','ORDERED'].includes(order.status)){ %><form method="POST" action="/patient-portal/lab/orders/<%= order.id %>/cancel" class="mt-3 d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="reason" class="form-control" placeholder="Optional cancellation reason"><button class="btn btn-outline-danger">Cancel Booking</button></form><% } %>