<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4><%= result.test_name_snapshot %></h4><div class="text-muted"><%= result.order_code %> · Released report</div></div><div class="d-flex gap-2"><a href="/patient-portal/lab/reports/<%= result.id %>/print" target="_blank" class="btn btn-primary btn-sm">Print</a><% if(result.report_file_name){ %><a href="/patient-portal/lab/reports/<%= result.id %>/file" target="_blank" class="btn btn-outline-secondary btn-sm">Digital Copy</a><% } %></div></div>
<div class="card mb-3"><div class="card-body"><div class="row g-2 small"><div class="col-md-3"><strong>Patient</strong><div><%= result.patient_name %></div></div><div class="col-md-3"><strong>Health ID</strong><div><%= result.health_id %></div></div><div class="col-md-3"><strong>Released</strong><div><%= result.released_at ? formatDateTime(result.released_at) : '—' %></div></div><div class="col-md-3"><strong>Authorized by</strong><div><%= result.releaser_name||'—' %></div></div></div></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Parameter</th><th>Result</th><th>Unit</th><th>Reference</th><th>Flag</th></tr></thead><tbody><% parameters.forEach(function(p){ %><tr><td><%= p.name %></td><td><strong><%= p.value_text||'—' %></strong></td><td><%= p.unit_snapshot||p.unit||'—' %></td><td><%= p.reference_range_snapshot||p.reference_range_text||'—' %></td><td><%= p.abnormal_flag||'—' %></td></tr><% }) %></tbody></table></div><div class="card-body"><strong>Interpretation</strong><p><%= result.interpretation||'—' %></p><strong>Comments</strong><p><%= result.comments||'—' %></p></div></div>