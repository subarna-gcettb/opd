<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div><h4>My Laboratory & Diagnostics</h4><div class="text-muted small">Book tests, track samples and open released reports.</div></div><a href="/patient-portal" class="btn btn-outline-secondary btn-sm">Portal</a></div>
<form method="POST" action="/patient-portal/lab/book">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card mb-3"><div class="card-header"><strong>Book Tests</strong></div><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-4"><label class="form-label">Preferred date</label><input type="date" name="bookingDate" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>"></div><div class="col-md-4"><label class="form-label">Priority</label><select name="priority" class="form-select"><option>ROUTINE</option><option>URGENT</option></select></div><div class="col-md-4"><label class="form-label">Clinical notes</label><input name="clinicalNotes" class="form-control"></div></div><div class="row g-2">
<% tests.forEach(function(t){ %><div class="col-md-6 col-xl-4"><label class="border rounded p-3 d-flex gap-2 h-100"><input class="form-check-input mt-1" type="checkbox" name="testIds" value="<%= t.id %>"><span><strong><%= t.name %></strong><small class="d-block text-muted"><%= t.code %> · <%= t.test_type %> · ₹<%= Number(t.price||0).toFixed(2) %></small><% if(t.fasting_required){ %><span class="badge text-bg-warning mt-1">Fasting</span><% } %><% if(t.patient_preparation){ %><small class="d-block mt-1"><%= t.patient_preparation %></small><% } %></span></label></div><% }) %>
</div></div><div class="card-footer text-end"><button class="btn btn-primary">Book Selected Tests</button></div></div>
</form>
<div class="card"><div class="card-header"><strong>My Test Bookings & Tracking</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Tests</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody>
<% orders.forEach(function(o){ %><tr><td><strong><%= o.order_code %></strong></td><td><%= o.total_tests %> test(s) · <%= o.reported_tests||0 %> released</td><td><span class="badge text-bg-<%= o.status==='REPORTED'?'success':(o.status==='CANCELLED'?'secondary':'primary') %>"><%= o.status.replaceAll('_',' ') %></span></td><td><%= formatDate(o.booking_date) %></td><td><a href="/patient-portal/lab/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Track</a></td></tr><% }) %>
<% if(!orders.length){ %><tr><td colspan="5" class="text-center text-muted py-4">No laboratory orders yet.</td></tr><% } %></tbody></table></div></div>