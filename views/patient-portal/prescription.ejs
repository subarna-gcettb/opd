<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0">Prescription <code><%= prescription.prescription_code %></code> <span class="badge text-bg-secondary">v<%= prescription.version %></span></h4>
    <div class="text-muted">Dr. <%= prescription.doctor_name %> &middot; <%= new Date(prescription.created_at).toLocaleDateString() %></div>
  </div>
  <a href="/patient-portal/prescriptions/<%= prescription.id %>/print" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Print</a>
</div>

<div class="card mb-3">
  <div class="card-header">Clinical Summary</div>
  <div class="card-body small">
    <div><strong>Diagnosis:</strong> <%= prescription.diagnosis || '—' %></div>
    <div><strong>Advice:</strong> <%= prescription.investigation_advice || '—' %></div>
    <div><strong>Follow-up:</strong> <%= prescription.follow_up_date ? new Date(prescription.follow_up_date).toLocaleDateString() : '—' %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">Medicines</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead>
      <tbody>
        <% items.forEach(function(it) { %>
          <tr>
            <td><%= it.medicine_name_freetext %></td>
            <td><%= it.dosage || '—' %></td>
            <td><%= it.frequency || '—' %></td>
            <td><%= it.duration || '—' %></td>
            <td><%= it.instructions || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
