<div class="d-flex justify-content-between mb-4"><div><h1 class="h3">Edit Patient</h1><p class="text-muted mb-0">Health ID <strong><%= patient.health_id %></strong> is permanent.</p></div><a href="/patients/<%= patient.health_id %>" class="btn btn-outline-secondary">Back</a></div><form method="POST" action="/patients/<%= patient.health_id %>/edit" class="card card-body shadow-sm"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="name" required value="<%= patient.name || '' %>"></div><div class="col-md-3"><label class="form-label">Gender</label><input class="form-control" name="gender" value="<%= patient.gender || '' %>"></div><div class="col-md-3"><label class="form-label">DOB</label><input class="form-control" type="date" name="dob" value="<%= patient.dob ? String(patient.dob).slice(0,10) : '' %>"></div><div class="col-md-4"><label class="form-label">Father Name</label><input class="form-control" name="fatherName" value="<%= patient.father_name || '' %>"></div><div class="col-md-4"><label class="form-label">Mobile</label><input class="form-control" name="mobile" value="<%= patient.mobile || '' %>"></div><div class="col-md-4"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="<%= patient.email || '' %>"></div><div class="col-12"><label class="form-label">Address</label><input class="form-control" name="address" value="<%= patient.address || '' %>"></div><div class="col-md-4"><label class="form-label">Village/Town</label><input class="form-control" name="villageTown" value="<%= patient.village_town || '' %>"></div><div class="col-md-4"><label class="form-label">Police Station</label><input class="form-control" name="policeStation" value="<%= patient.police_station || '' %>"></div><div class="col-md-4"><label class="form-label">District</label><input class="form-control" name="district" value="<%= patient.district || '' %>"></div><div class="col-md-4"><label class="form-label">PIN</label><input class="form-control" name="pinCode" value="<%= patient.pin_code || '' %>"></div><div class="col-md-4"><label class="form-label">Blood Group</label><input class="form-control" name="bloodGroup" value="<%= patient.blood_group || '' %>"></div><div class="col-md-4"><label class="form-label">Weight</label><input class="form-control" name="weightKg" value="<%= patient.weight_kg || '' %>"></div><div class="col-md-6"><label class="form-label">Allergies</label><textarea class="form-control" name="allergies"><%= patient.allergies || '' %></textarea></div><div class="col-md-6"><label class="form-label">Existing Conditions</label><textarea class="form-control" name="existingConditions"><%= patient.existing_conditions || '' %></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Save Changes</button></div></form>