<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">All Patients</h1><div class="d-flex gap-2"><a href="/patients/search" class="btn btn-outline-secondary">Search</a><a href="/patients/new" class="btn btn-primary">+ New Patient</a></div></div><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Health ID</th><th>Registration</th><th>Name</th><th>Gender</th><th>Age</th><th>Mobile</th><th>Registered</th><th></th></tr></thead><tbody><% (rows || []).forEach(p => { %><tr><td><strong><%= p.health_id %></strong></td><td><%= p.registration_number %></td><td><%= p.name %></td><td><%= p.gender %></td><td><%= p.age_years || '—' %></td><td><%= p.mobile %></td><td><%= p.created_at ? new Date(p.created_at).toLocaleDateString() : '—' %></td><td><a href="/patients/<%= p.health_id %>" class="btn btn-sm btn-outline-primary">Open</a></td></tr><% }) %></tbody></table></div><div class="card-footer d-flex justify-content-between"><span>Total: <%= total || 0 %></span><div class="btn-group"><% for(let i=1;i<=(totalPages||1);i++){ %><a class="btn btn-sm <%= i===page?'btn-primary':'btn-outline-secondary' %>" href="?page=<%= i %>"><%= i %></a><% } %></div></div></div>