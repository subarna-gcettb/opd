<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Patient Search</h1><p class="text-muted">Search by Health ID, registration number, name, mobile or Aadhaar last 4 digits.</p></div><a href="/patients/new" class="btn btn-primary">+ New Patient</a></div>
<form method="GET" action="/patients/search" class="card card-body shadow-sm mb-4"><div class="input-group input-group-lg"><input name="q" class="form-control" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Enter Health ID, name, mobile, registration no."><button class="btn btn-primary">Search</button></div></form>
<% if (typeof results !== 'undefined') { %><div class="card shadow-sm"><div class="card-header">Results <span class="badge bg-secondary"><%= results.length %></span></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Health ID</th><th>Name</th><th>Mobile</th><th>Age/Gender</th><th>District</th><th></th></tr></thead><tbody><% results.forEach(p => { %><tr><td><strong><%= p.health_id %></strong></td><td><%= p.name %></td><td><%= p.mobile || '—' %></td><td><%= p.age_years || '—' %> / <%= p.gender || '—' %></td><td><%= p.district || '—' %></td><td><a class="btn btn-sm btn-outline-primary" href="/patients/<%= p.health_id %>">Open</a></td></tr><% }) %><% if (!results.length) { %><tr><td colspan="6" class="text-center py-5 text-muted">No matching patients found.</td></tr><% } %></tbody></table></div></div><% } %>