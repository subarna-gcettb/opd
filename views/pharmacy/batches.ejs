<h4 class="mb-3">Batch & Expiry Control</h4><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>Supplier</th><th>MRP</th><th>Stock</th></tr></thead><tbody><%batches.forEach(b=>{const e=String(b.expiry_date)<new Date().toISOString().slice(0,10);%><tr class="<%=e?'table-danger':''%>"><td><%=b.name%><small class="text-muted d-block"><%=b.sku%></small></td><td><code><%=b.batch_number%></code></td><td><%=formatDate(b.expiry_date)%> <%if(e){%><span class="badge text-bg-danger">EXPIRED</span><%}%></td><td><%=b.supplier_name||'—'%></td><td>₹<%=Number(b.mrp).toFixed(2)%></td><td><%=b.quantity%></td></tr><%})%></tbody></table></div></div>