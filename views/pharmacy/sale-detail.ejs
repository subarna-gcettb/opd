<div class="d-flex justify-content-between mb-3"><div><h4>Pharmacy Bill <code><%=sale.sale_number%></code></h4><div><%=sale.patient_name||sale.customer_name||'Walk-in Customer'%> <small><%=sale.health_id||sale.customer_mobile||''%></small></div></div><button class="btn btn-outline-secondary" onclick="window.print()">Print</button></div><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>Qty</th><th>Price</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody><%items.forEach(i=>{%><tr><td><%=i.medicine_name_snapshot%></td><td><%=i.batch_number_snapshot%></td><td><%=formatDate(i.expiry_date_snapshot)%></td><td><%=i.quantity%></td><td>₹<%=Number(i.unit_price).toFixed(2)%></td><td>₹<%=Number(i.discount_amount).toFixed(2)%></td><td>₹<%=Number(i.tax_amount).toFixed(2)%></td><td>₹<%=Number(i.line_total).toFixed(2)%></td></tr><%})%></tbody></table></div><div class="card-body text-end">Gross ₹<%=Number(sale.gross_amount).toFixed(2)%> · Discount ₹<%=Number(sale.discount_amount).toFixed(2)%> · Tax ₹<%=Number(sale.tax_amount).toFixed(2)%><h5>Net ₹<%=Number(sale.net_amount).toFixed(2)%></h5>Paid ₹<%=Number(sale.paid_amount).toFixed(2)%> · Due ₹<%=Number(sale.due_amount).toFixed(2)%></div></div>