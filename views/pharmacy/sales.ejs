<div class="d-flex justify-content-between mb-3"><h4>Pharmacy Sales</h4><a class="btn btn-primary" href="/pharmacy/sales/new">New Bill</a></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bill</th><th>Customer / Patient</th><th>Date</th><th>Net</th><th>Paid</th><th>Due</th><th>Status</th></tr></thead><tbody><%rows.forEach(s=>{%><tr><td><a href="/pharmacy/sales/<%=s.id%>"><%=s.sale_number%></a></td><td><%=s.patient_name||s.customer_name||'Walk-in Customer'%><small class="d-block text-muted"><%=s.health_id||s.customer_mobile||''%></small></td><td><%=formatDateTime(s.sale_date)%></td><td>₹<%=Number(s.net_amount).toFixed(2)%></td><td>₹<%=Number(s.paid_amount).toFixed(2)%></td><td>₹<%=Number(s.due_amount).toFixed(2)%></td><td><span class="badge text-bg-<%=s.status==='PAID'?'success':s.status==='CANCELLED'?'danger':'warning'%>"><%=s.status%></span></td></tr><%})%></tbody></table></div></div>