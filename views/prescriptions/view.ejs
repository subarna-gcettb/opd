<div class="d-flex justify-content-between mb-4"><div><h1 class="h3"><%= prescription.prescription_code %></h1><p class="text-muted">Patient: <%= prescription.patient_name %> · Dr. <%= prescription.doctor_name %></p></div><a class="btn btn-outline-primary" href="/prescriptions/<%= prescription.id %>/print">Print</a></div><div class="card"><div class="card-header">Medicines</div><table class="table mb-0"><thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead><tbody><% (items||[]).forEach(i=>{ %><tr><td><%= i.medicine_name_freetext||i.medicine_name||'' %></td><td><%= i.dosage||'' %></td><td><%= i.frequency||'' %></td><td><%= i.duration||'' %></td><td><%= i.instructions||'' %></td></tr><% }) %></tbody></table></div>