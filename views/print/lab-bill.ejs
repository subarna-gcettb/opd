<style>@page{margin:<%= settings?.report_margin_top_mm??10 %>mm 10mm <%= settings?.report_margin_bottom_mm??10 %>mm 10mm}body,.print-sheet{font-size:<%= settings?.report_font_size_pt??10 %>pt}</style>
<div class="print-sheet">
<div class="print-actions no-print"><button type="button" class="btn btn-primary btn-sm" onclick="window.print()">Print / Save PDF</button><button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.close()">Close</button></div>
<header class="mb-4"><h2 class="mb-1"><%= order.laboratory_name %></h2><div><%= order.laboratory_address||'' %> · <%= order.laboratory_phone||'' %></div><% if(order.report_header){ %><div class="mt-2"><%= order.report_header %></div><% } %><hr><div class="d-flex justify-content-between align-items-start"><div><h4 class="mb-1">Laboratory / Diagnostic Bill</h4><strong>Bill No. <%= order.order_code %></strong><div class="small text-muted">Registered: <%= formatDateTime(order.created_at) %></div></div><% if(qrDataUri){ %><div class="text-center"><img src="<%= qrDataUri %>" alt="Secure bill and report QR code" width="105" height="105"><div class="small">Scan for status / reports</div></div><% } %></div></header>
<div class="row g-2 small mb-3"><div class="col-6"><strong>Patient</strong><div><%= order.patient_name %></div><div>Health ID: <%= order.health_id %></div><div><%= order.mobile||'' %></div></div><div class="col-6"><strong>Order details</strong><div>Booking date: <%= formatDate(order.booking_date) %></div><div>Source: <%= order.source %> · Priority: <%= order.priority %></div><div>Status: <%= order.status.replaceAll('_',' ') %></div><% if(order.referral_provider_name){ %><div>Referred by: <%= order.referral_provider_name %></div><% } %></div></div>
<table class="table table-bordered"><thead><tr><th>#</th><th>Test code</th><th>Test / investigation</th><th>Specimen</th><th>Status</th><th class="text-end">Amount</th></tr></thead><tbody><% items.forEach(function(item,i){ %><tr><td><%= i+1 %></td><td><%= item.test_code_snapshot %></td><td><%= item.test_name_snapshot %></td><td><%= item.specimen_type_snapshot||'—' %></td><td><%= item.status.replaceAll('_',' ') %></td><td class="text-end">₹<%= Number(item.price_snapshot||0).toFixed(2) %></td></tr><% }) %></tbody></table>
<div class="row justify-content-end"><div class="col-md-5"><table class="table table-sm"><tr><th>Subtotal</th><td class="text-end">₹<%= Number(order.total_amount||0).toFixed(2) %></td></tr><tr><th>Discount</th><td class="text-end">₹<%= Number(order.discount_amount||0).toFixed(2) %></td></tr><% if(order.discount_reason){ %><tr><th>Discount reason</th><td class="text-end"><%= order.discount_reason %></td></tr><% } %><tr><th>Net amount</th><th class="text-end">₹<%= Number(order.net_amount||0).toFixed(2) %></th></tr><tr><th>Paid</th><td class="text-end">₹<%= paid.toFixed(2) %></td></tr><tr><th>Balance due</th><th class="text-end">₹<%= due.toFixed(2) %></th></tr></table></div></div>
<div class="row mt-4 small"><div class="col-7"><strong>Payment status:</strong> <%= order.payment_status %><p class="mt-2">Please keep this bill. Scan the QR code to check report status and download released reports.</p><% if(order.report_footer){ %><div><%= order.report_footer %></div><% } %></div><div class="col-5 text-end"><strong>For <%= order.laboratory_name %></strong><div class="mt-5">Authorized signature</div></div></div>
</div><link rel="stylesheet" href="/css/print.css">
