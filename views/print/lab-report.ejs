<style>@page{margin:<%= settings?.report_margin_top_mm??10 %>mm 10mm <%= settings?.report_margin_bottom_mm??10 %>mm 10mm}body,.print-sheet{font-size:<%= settings?.report_font_size_pt??10 %>pt}</style>
<div class="print-sheet">
<div class="print-actions no-print"><button type="button" class="btn btn-primary btn-sm" onclick="printDocument()">Print</button><button type="button" class="btn btn-outline-secondary btn-sm" onclick="closePrintWindow()">Close</button></div>
<header class="mb-4"><div class="d-flex justify-content-between align-items-start gap-3"><div><h2 class="mb-1"><%= result.laboratory_name %></h2><div><%= result.laboratory_address||'' %> · <%= result.laboratory_phone||'' %></div><% if(result.report_header){ %><div class="mt-2"><%= result.report_header %></div><% } %><h4 class="mt-3">Laboratory / Diagnostic Report</h4><strong>Registration No.: <%= result.order_code %></strong></div><div class="text-center"><% if(barcodeDataUri){ %><img src="<%= barcodeDataUri %>" alt="Registration barcode" style="max-width:180px;max-height:55px"><% } %><% if(qrDataUri){ %><img src="<%= qrDataUri %>" alt="Secure report QR code" width="95" height="95" class="d-block mt-2"><small class="d-block">Scan to verify / view report</small><% } %></div></div><hr></header>
<div class="row g-2 small mb-3"><div class="col-md-3"><strong>Patient</strong><div><%= result.patient_name %></div></div><div class="col-md-3"><strong>Health ID</strong><div><%= result.health_id %></div></div><div class="col-md-3"><strong>Order</strong><div><%= result.order_code %></div></div><div class="col-md-3"><strong>Test</strong><div><%= result.test_name_snapshot %></div></div></div>
<div class="row g-2 small border rounded p-2 mb-3"><div class="col-md-3"><strong>Registered</strong><div><%= result.order_created_at?formatDateTime(result.order_created_at):'—' %></div></div><div class="col-md-3"><strong>Sample collected</strong><div><%= result.collected_at?formatDateTime(result.collected_at):'—' %></div></div><div class="col-md-3"><strong>Received in lab</strong><div><%= result.received_at?formatDateTime(result.received_at):'—' %></div></div><div class="col-md-3"><strong>Reported</strong><div><%= result.released_at?formatDateTime(result.released_at):'—' %></div></div></div>
<div class="row g-2 small mb-3"><% if(settings?.report_show_method){ %><div class="col-md-6"><strong>Method</strong><div><%= result.method_used||'—' %></div></div><% } %><% if(settings?.report_show_instrument){ %><div class="col-md-6"><strong>Instrument</strong><div><%= result.instrument_name||'—' %></div></div><% } %></div>
<table class="table table-bordered"><thead><tr><th>Parameter</th><th>Result</th><th>Unit</th><th>Reference Interval</th><th>Flag</th><th>Remarks</th></tr></thead><tbody><% parameters.forEach(function(p){ %><tr><td><%= p.name %></td><td><strong><%= p.value_text||'—' %></strong></td><td><%= p.unit_snapshot||p.unit||'—' %></td><td><%= p.reference_range_snapshot||p.reference_range_text||'—' %></td><td><%= p.abnormal_flag||'—' %></td><td><%= p.remarks||'—' %></td></tr><% }) %></tbody></table>
<div class="mt-4"><strong>Summary</strong><p><%= result.result_summary||'—' %></p><% if(settings?.report_show_interpretation){ %><strong>Interpretation</strong><p><%= result.interpretation||'—' %></p><% } %><% if(settings?.report_show_comments){ %><strong>Comments</strong><p><%= result.comments||'—' %></p><% } %></div>
<div class="row mt-5 small"><div class="col-4"><strong>Performed by</strong><div><%= result.performer_name||'—' %></div></div><div class="col-4"><strong>Reviewed by</strong><div><%= result.reviewer_name||'—' %></div></div><div class="col-4"><strong>Released by</strong><div><%= result.releaser_name||'—' %></div><div><%= result.released_at?formatDateTime(result.released_at):'' %></div></div></div>
<div class="row mt-4 small"><div class="col-8"></div><div class="col-4 text-end"><strong><%= result.signatory_name||result.releaser_name||'Authorized Signatory' %></strong><div><%= result.signatory_qualification||'' %></div><div><%= result.signatory_registration_no?'Registration No. '+result.signatory_registration_no:'' %></div><div class="mt-2">Authorized laboratory report</div></div></div>
<% if(result.report_footer){ %><hr><div class="small"><%= result.report_footer %></div><% } %>
</div>
<link rel="stylesheet" href="/css/print.css"><script>
(function(){
  window.printDocument=function(){window.focus();window.print();};
  window.closePrintWindow=function(){
    if(window.opener&&!window.opener.closed){window.close();return;}
    if(window.history.length>1){window.history.back();return;}
    window.location.href='/patient-portal/lab';
  };
  document.body.classList.add('print-doc');
})();
</script>