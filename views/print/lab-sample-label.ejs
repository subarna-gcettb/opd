<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sample Label</title><link rel="stylesheet" href="/css/print.css"><style>@page{size:80mm 50mm;margin:3mm}.label{width:74mm;min-height:44mm;font-family:Arial,sans-serif;color:#111;font-size:10px}.label h4{font-size:12px;margin:0 0 2mm}.barcode{width:100%;max-width:72mm;height:15mm;object-fit:contain}.muted{font-size:9px;color:#444}.no-print{margin-bottom:8px}@media screen{body{padding:20px}.label{border:1px dashed #aaa;padding:8px}}</style></head><body><div class="no-print"><button type="button" onclick="window.print()">Print label</button><button type="button" onclick="window.close()">Close</button></div><section class="label"><h4><%= sample.laboratory_name %></h4><div><strong>Patient:</strong> <%= sample.patient_name %> · <%= sample.health_id %></div><div><strong>Order:</strong> <%= sample.order_code %></div><div><strong>Test:</strong> <%= sample.test_name_snapshot %> (<%= sample.test_code_snapshot %>)</div><div><strong>Specimen:</strong> <%= sample.specimen_type||'—' %> <%= sample.container_type?'· '+sample.container_type:'' %></div><div><strong>Sample:</strong> <%= sample.sample_code %> · <%= sample.sample_status %></div><img class="barcode" src="<%= barcodeDataUri %>" alt="Sample barcode"><div class="muted"><%= sample.barcode_value %> · Collected <%= sample.collected_at?formatDateTime(sample.collected_at):'—' %></div></section></body></html>