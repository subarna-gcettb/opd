<script>
(function () {
  function fitPrescriptionToOnePage() {
    document.body.classList.add('single-a4-print');

    var sheet = document.querySelector('.print-sheet');
    if (!sheet) return;

    var pageHeight = 297 - 24; // A4 height minus 12mm top/bottom print margins.
    var pageWidth = 210 - 24;  // A4 width minus 12mm left/right print margins.

    // Temporarily remove the previous scale while measuring the natural content.
    sheet.style.setProperty('--prescription-print-scale', '1');
    sheet.style.transform = 'none';

    var naturalHeight = sheet.scrollHeight;
    var naturalWidth = sheet.scrollWidth;

    if (!naturalHeight || !naturalWidth) return;

    var scale = Math.min(
      1,
      (pageHeight / naturalHeight),
      (pageWidth / naturalWidth)
    );

    // Never allow a zero/invalid scale. A very long prescription may become
    // small, but all clinical content remains present on the single A4 sheet.
    scale = Math.max(0.05, scale);

    sheet.style.setProperty('--prescription-print-scale', String(scale));
    sheet.style.transform = 'scale(' + scale + ')';
  }

  function printDocument() {
    window.focus();
    fitPrescriptionToOnePage();
    window.print();
  }

  function closePrintWindow() {
    if (window.opener && !window.opener.closed) {
      window.close();
      setTimeout(function () {
        if (!window.closed) {
          window.location.href = document.referrer || '/';
        }
      }, 150);
      return;
    }

    if (window.history.length > 1) {
      window.history.back();
      return;
    }

    window.location.href = '/';
  }

  window.printDocument = printDocument;
  window.closePrintWindow = closePrintWindow;

  function markPrintDocument() {
    if (document.body) {
      document.body.classList.add('print-doc');
      fitPrescriptionToOnePage();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', markPrintDocument);
  } else {
    markPrintDocument();
  }

  window.addEventListener('beforeprint', fitPrescriptionToOnePage);
  window.addEventListener('afterprint', function () {
    var sheet = document.querySelector('.print-sheet');
    if (sheet) {
      sheet.style.removeProperty('--prescription-print-scale');
      sheet.style.removeProperty('transform');
    }
  });
})();
</script>
<link rel="stylesheet" href="/css/print.css">

<div class="print-sheet">
  <%- include('./_header') %>

  <div class="doc-title">Prescription</div>

  <div class="kv-grid three">
    <div class="kv"><span class="k">Patient</span><span class="v"><strong><%= prescription.patient_name %></strong></span></div>
    <div class="kv"><span class="k">Health ID</span><span class="v"><%= prescription.health_id %></span></div>
    <div class="kv"><span class="k">Age / Gender</span><span class="v"><%= prescription.age_years || '—' %> / <%= prescription.gender %></span></div>
    <div class="kv"><span class="k">Date</span><span class="v"><%= new Date(prescription.created_at).toLocaleDateString() %></span></div>
    <div class="kv"><span class="k">Doctor</span><span class="v"><%= prescription.doctor_name %></span></div>
    <div class="kv"><span class="k">Reg. No.</span><span class="v"><%= prescription.professional_reg_number || '—' %></span></div>
    <div class="kv"><span class="k">Qualification</span><span class="v"><%= prescription.qualification || '—' %></span></div>
    <div class="kv"><span class="k">Department</span><span class="v"><%= prescription.department_name %></span></div>
    <div class="kv"><span class="k">Prescription No.</span><span class="v"><%= prescription.prescription_code %> (v<%= prescription.version %>)</span></div>
  </div>

  <div class="section-label">Female / Obstetric Assessment</div>
  <% if (String(prescription.gender || '').toLowerCase() === 'female') { %>
    <div class="subsection-label">Pregnancy information</div>
    <div class="kv-grid three">
      <div class="kv"><span class="k">Pregnancy Status</span><span class="v"><%= prescription.pregnancy_status || '—' %></span></div>
      <div class="kv"><span class="k">LMP</span><span class="v"><%= prescription.lmp_date ? new Date(prescription.lmp_date).toLocaleDateString() : '—' %></span></div>
      <div class="kv"><span class="k">Gravida (G)</span><span class="v"><%= prescription.gravida ?? '—' %></span></div>
      <div class="kv"><span class="k">Para (P)</span><span class="v"><%= prescription.para ?? '—' %></span></div>
      <div class="kv"><span class="k">Abortions (A)</span><span class="v"><%= prescription.abortions ?? '—' %></span></div>
      <div class="kv"><span class="k">Gestational Age</span><span class="v"><%= prescription.gestational_age_weeks != null ? prescription.gestational_age_weeks + 'w ' + (prescription.gestational_age_days || 0) + 'd' : '—' %></span></div>
      <div class="kv"><span class="k">EDD</span><span class="v"><%= prescription.estimated_due_date ? new Date(prescription.estimated_due_date).toLocaleDateString() : '—' %></span></div>
      <% if (prescription.obstetric_notes) { %><div class="kv"><span class="k">Obstetric Notes</span><span class="v"><%= prescription.obstetric_notes %></span></div><% } %>
    </div>
  <% } %>

  <div class="section-label">Vitals</div>
  <div class="kv-grid three">
    <div class="kv"><span class="k">BP</span><span class="v"><%= prescription.bp || '—' %></span></div>
    <div class="kv"><span class="k">Pulse</span><span class="v"><%= prescription.pulse ?? '—' %></span></div>
    <div class="kv"><span class="k">Temp (°F)</span><span class="v"><%= prescription.temperature ?? '—' %></span></div>
    <div class="kv"><span class="k">SpO2 (%)</span><span class="v"><%= prescription.spo2 ?? '—' %></span></div>
    <div class="kv"><span class="k">Weight (kg)</span><span class="v"><%= prescription.weight_kg ?? '—' %></span></div>
    <div class="kv"><span class="k">Height (cm)</span><span class="v"><%= prescription.height_cm ?? '—' %></span></div>
    <div class="kv"><span class="k">Respiratory rate</span><span class="v"><%= prescription.respiratory_rate ?? '—' %></span></div>
    <div class="kv"><span class="k">BMI</span><span class="v"><%= prescription.height_cm && prescription.weight_kg ? (Number(prescription.weight_kg) / Math.pow(Number(prescription.height_cm) / 100, 2)).toFixed(1) : '—' %></span></div>
  </div>

  <div class="section-label">Chief Complaint</div>
  <div><%= prescription.complaints || '—' %></div>

  <%
    let personalHistory = prescription.personal_history;
    if (typeof personalHistory === 'string') {
      try { personalHistory = JSON.parse(personalHistory); } catch (_) { personalHistory = { notes: personalHistory }; }
    }
    personalHistory = personalHistory && typeof personalHistory === 'object' ? personalHistory : {};
    const historyLabels = {
      surgery: 'Surgery',
      sleep: 'Sleep',
      drinking: 'Alcohol / Drinking',
      bowel: 'Bowel',
      smoking: 'Smoking',
      appetite: 'Appetite',
      diet: 'Diet',
      occupation: 'Occupation',
      exercise: 'Exercise',
      other: 'Other'
    };
    const historyEntries = Object.keys(historyLabels)
      .filter(key => personalHistory[key] && (personalHistory[key].value || personalHistory[key].other))
      .map(key => ({
        label: historyLabels[key],
        value: personalHistory[key].value || '—',
        other: personalHistory[key].other || ''
      }));
    const customHistory = Array.isArray(personalHistory.customItems) ? personalHistory.customItems : [];
  %>
  <div class="section-label">Personal History</div>
  <div class="history-grid">
    <% historyEntries.forEach(function(item) { %>
      <div class="history-item">
        <span class="history-label"><%= item.label %></span>
        <span class="history-value"><%= item.value %><% if (item.other) { %> — <%= item.other %><% } %></span>
      </div>
    <% }) %>
    <% customHistory.forEach(function(item) {
      const label = item && (item.label || item.name || item.title);
      const value = item && (item.value || item.answer || item.other);
      if (label && value) { %>
      <div class="history-item">
        <span class="history-label"><%= label %></span>
        <span class="history-value"><%= value %></span>
      </div>
    <% } }) %>
    <% if (!historyEntries.length && !customHistory.length && personalHistory.notes) { %>
      <div class="history-free-text"><%= personalHistory.notes %></div>
    <% } %>
    <% if (!historyEntries.length && !customHistory.length && !personalHistory.notes) { %>
      <div class="text-muted">No personal history recorded.</div>
    <% } %>
  </div>

  <div class="section-label">Symptoms</div>
  <div><%= prescription.symptoms || '—' %></div>

  <div class="section-label">Allergies</div>
  <div><%= prescription.allergies || 'None recorded' %></div>

  <div class="section-label">Diagnosis</div>
  <div><%= prescription.diagnosis || '—' %></div>

  <div class="section-label">Clinical Notes</div>
  <div><%= prescription.clinical_notes || '—' %></div>

  <div class="section-label">Investigation Advice</div>
  <div><%= prescription.investigation_advice || '—' %></div>

  <div class="section-label rx-heading"><span>Rx</span> Prescription / Medication</div>
  <table class="rx-print-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Medicine / Composition</th>
        <th>Form</th>
        <th>Dose</th>
        <th>Frequency</th>
        <th>Duration</th>
        <th>Route</th>
        <th>Qty</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(it, i) { %>
        <tr>
          <td class="rx-no"><%= i + 1 %></td>
          <td>
            <strong><%= it.medicine_name_freetext %></strong>
            <% if (it.composition) { %><div class="rx-composition"><%= it.composition %></div><% } %>
            <% if (it.prescriptionText) { %>
              <div class="rx-instruction-en"><strong>English:</strong> <%= it.prescriptionText.english %></div>
              <div class="rx-instruction-bn"><strong>বাংলা:</strong> <%= it.prescriptionText.bengali %></div>
            <% } %>
            <% if (it.instructions) { %><div class="rx-additional"><%= it.instructions %></div><% } %>
          </td>
          <td><%= it.medicine_form || '—' %></td>
          <td><%= it.dosage || '—' %></td>
          <td><%= it.frequency || '—' %></td>
          <td><%= it.duration ? it.duration + (String(it.duration).match(/days?$/i) ? '' : ' days') : '—' %></td>
          <td><%= it.route || '—' %></td>
          <td><%= it.quantity || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="section-label">Follow-up</div>
  <div><%= prescription.follow_up_date ? new Date(prescription.follow_up_date).toLocaleDateString() : 'As needed' %></div>

  <div class="barcode-area">
    <img src="<%= barcodeDataUri %>" alt="Health ID barcode">
  </div>

  <div class="signature">
    <span class="line">Dr. <%= prescription.doctor_name %><br><%= prescription.qualification || '' %></span>
  </div>

  <div class="print-footer-note">Barcode encodes the patient's Health ID only. This prescription does not authorize dispensing without valid identification.</div>

  <div class="print-actions no-print">
    <button onclick="printDocument()" class="btn btn-primary">Print Prescription</button>
    <button onclick="closePrintWindow()" class="btn btn-outline-secondary">Close</button>
  </div>
</div>
