<link rel="stylesheet" href="/css/print.css">
<script>document.body.className = 'print-doc';</script>

<div class="print-sheet">
  <%- include('./_header') %>

  <div class="doc-title">Prescription</div>

  <div class="kv-grid three">
    <div class="kv"><span class="k">Patient</span><span class="v"><strong><%= prescription.patient_name %></strong></span></div>
    <div class="kv"><span class="k">Health ID</span><span class="v"><%= prescription.health_id %></span></div>
    <div class="kv"><span class="k">Age / Gender</span><span class="v"><%= prescription.age_years || '—' %> / <%= prescription.gender %></span></div>
    <div class="kv"><span class="k">Date</span><span class="v"><%= new Date(prescription.created_at).toLocaleDateString() %></span></div>
    <div class="kv"><span class="k">Doctor</span><span class="v"><%= prescription.doctor_name %></span></div>
    <div class="kv"><span class="k">Reg. No.</span><span class="v"><%= prescription.professional_reg_number || '—' %></span></div>
    <div class="kv"><span class="k">Qualification</span><span class="v"><%= prescription.qualification || '—' %></span></div>
    <div class="kv"><span class="k">Department</span><span class="v"><%= prescription.department_name %></span></div>
    <div class="kv"><span class="k">Prescription No.</span><span class="v"><%= prescription.prescription_code %> (v<%= prescription.version %>)</span></div>
  </div>

  <% if (prescription.bp || prescription.pulse || prescription.weight_kg || prescription.temperature || prescription.spo2) { %>
    <div class="section-label">Vitals</div>
    <div class="kv-grid three">
      <div class="kv"><span class="k">BP</span><span class="v"><%= prescription.bp || '—' %></span></div>
      <div class="kv"><span class="k">Pulse</span><span class="v"><%= prescription.pulse || '—' %></span></div>
      <div class="kv"><span class="k">Temp</span><span class="v"><%= prescription.temperature || '—' %> °F</span></div>
      <div class="kv"><span class="k">SpO2</span><span class="v"><%= prescription.spo2 || '—' %>%</span></div>
      <div class="kv"><span class="k">Weight</span><span class="v"><%= prescription.weight_kg || '—' %> kg</span></div>
      <div class="kv"><span class="k">Height</span><span class="v"><%= prescription.height_cm || '—' %> cm</span></div>
    </div>
  <% } %>

  <div class="section-label">Diagnosis</div>
  <div><%= prescription.diagnosis || '—' %></div>

  <div class="section-label">Rx</div>
  <table class="print-table">
    <thead><tr><th>#</th><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Route</th><th>Qty</th><th>Instructions</th></tr></thead>
    <tbody>
      <% items.forEach(function(it, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= it.medicine_name_freetext %></td>
          <td><%= it.dosage || '—' %></td>
          <td><%= it.frequency || '—' %></td>
          <td><%= it.duration || '—' %></td>
          <td><%= it.route || '—' %></td>
          <td><%= it.quantity || '—' %></td>
          <td><%= it.instructions || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (prescription.investigation_advice) { %>
    <div class="section-label">Investigation Advice</div>
    <div><%= prescription.investigation_advice %></div>
  <% } %>

  <div class="section-label">Follow-up</div>
  <div><%= prescription.follow_up_date ? new Date(prescription.follow_up_date).toLocaleDateString() : 'As needed' %></div>

  <div class="barcode-area">
    <img src="<%= barcodeDataUri %>" alt="Health ID barcode">
  </div>

  <div class="signature">
    <span class="line">Dr. <%= prescription.doctor_name %><br><%= prescription.qualification || '' %></span>
  </div>

  <div class="print-footer-note">Barcode encodes the patient's Health ID only. This prescription does not authorize dispensing without valid identification.</div>

  <div class="print-actions no-print">
    <button onclick="window.print()" class="btn btn-primary">Print Prescription</button>
    <button onclick="window.close()" class="btn btn-outline-secondary">Close</button>
  </div>
</div>
