<link rel="stylesheet" href="/css/print.css">
<script>document.body.className = 'print-doc';</script>

<div class="print-sheet" style="max-width: 420px;">
  <%- include('./_header') %>

  <div class="doc-title">OPD Token</div>

  <div class="token-box">
    <div class="token-label">Token Number</div>
    <div class="token-num"><%= String(appointment.token_number).padStart(3, '0') %></div>
  </div>

  <div class="kv-grid" style="grid-template-columns: 1fr;">
    <div class="kv"><span class="k">Patient</span><span class="v"><strong><%= appointment.patient_name %></strong></span></div>
    <div class="kv"><span class="k">Health ID</span><span class="v"><%= appointment.health_id %></span></div>
    <div class="kv"><span class="k">Age / Gender</span><span class="v"><%= appointment.age_years || '—' %> / <%= appointment.gender %></span></div>
    <div class="kv"><span class="k">Doctor</span><span class="v"><%= appointment.doctor_name %></span></div>
    <div class="kv"><span class="k">Department</span><span class="v"><%= appointment.department_name %></span></div>
    <div class="kv"><span class="k">Date</span><span class="v"><%= new Date(appointment.appointment_date).toLocaleDateString() %></span></div>
    <div class="kv"><span class="k">Reporting Time</span><span class="v"><%= appointment.slot_time.slice(0,5) %></span></div>
    <div class="kv"><span class="k">Appointment No.</span><span class="v"><%= appointment.appointment_code %></span></div>
  </div>

  <div style="text-align:center;margin:1rem 0 .5rem;"><img src="/opd/appointments/<%= appointment.id %>/barcode" alt="Appointment barcode" style="width:320px;height:80px;object-fit:contain;"><div style="font-size:.75rem;color:#666;">Scan appointment barcode at the doctor desk</div></div>

  <div class="print-footer-note">
    Please be seated in the waiting area. Tokens are called in order. Report to reception if you miss your call.
  </div>

  <div class="print-actions no-print">
    <button onclick="window.print()" class="btn btn-primary">Print Token</button>
    <button onclick="window.close()" class="btn btn-outline-secondary">Close</button>
  </div>
</div>
