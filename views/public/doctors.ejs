<div class="container py-5"><h1>Our Doctors</h1><div class="row g-4 mt-2"><% (doctors||[]).forEach(d=>{ %><div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5><%= d.name %></h5><div class="text-primary"><%= d.specialisation || 'Medical Specialist' %></div><p class="small text-muted mb-1"><%= d.qualification || '' %></p><p class="small text-muted"><%= d.department_name || '' %></p></div></div></div><% }) %></div></div>