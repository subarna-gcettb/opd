<%- include('../partials/public-nav') %>

<div class="landing-body">
  <section class="landing-hero">
    <div class="container">
      <h1><%= siteSettings.hospital_name %> Hospital Management System</h1>
      <p class="lead"><%= siteSettings.seo_description %></p>
      <div class="d-flex gap-2 flex-wrap mt-3">
        <a href="/auth/login" class="btn btn-light btn-lg"><i class="bi bi-hospital"></i> Staff &amp; Doctor Sign In</a>
        <a href="/patient-portal-info" class="btn btn-outline-light btn-lg"><i class="bi bi-person-heart"></i> Patient Portal</a>
      </div>

      <div style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);border-radius:.6rem;padding:1rem 1.2rem;margin-top:2rem;max-width:560px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <strong><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#4ade80;margin-right:6px;"></span>Live OPD — Today</strong>
          <a href="/live-opd" class="small text-white-50 text-decoration-none">View live board &rarr;</a>
        </div>
        <div class="row g-2 text-center" id="homeLiveStats">
          <div class="col"><div style="font-size:1.4rem;font-weight:700;" id="ls-doctors"><%= liveSummary.doctorsActive %></div><div class="small" style="color:#cfeae4;">Doctors Active</div></div>
          <div class="col"><div style="font-size:1.4rem;font-weight:700;" id="ls-inconsult"><%= liveSummary.inConsultation %></div><div class="small" style="color:#cfeae4;">In Consultation</div></div>
          <div class="col"><div style="font-size:1.4rem;font-weight:700;" id="ls-waiting"><%= liveSummary.waiting %></div><div class="small" style="color:#cfeae4;">Waiting</div></div>
          <div class="col"><div style="font-size:1.4rem;font-weight:700;" id="ls-total"><%= liveSummary.totalVisitsToday %></div><div class="small" style="color:#cfeae4;">Total Visits</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section">
    <div class="container">
      <h2>Services</h2>
      <div class="row g-3">
        <% departments.forEach(function(dept) { %>
          <div class="col-6 col-md-3">
            <div class="service-card">
              <i class="bi bi-heart-pulse" style="color:var(--hms-primary);font-size:1.3rem;"></i>
              <div class="fw-semibold mt-1"><%= dept.name %></div>
            </div>
          </div>
        <% }) %>
      </div>
      <a href="/services" class="btn btn-outline-primary btn-sm mt-3">View All Services</a>
    </div>
  </section>

  <section class="landing-section section-alt" style="background:#fff;">
    <div class="container">
      <h2>Our Doctors</h2>
      <div class="row g-3">
        <% doctors.forEach(function(doc) { %>
          <div class="col-md-6 col-lg-4">
            <div class="doctor-card d-flex gap-3">
              <div class="avatar"><%= doc.name.charAt(0) %></div>
              <div>
                <div class="fw-semibold"><%= doc.name %></div>
                <div class="text-muted small"><%= doc.specialisation || doc.department_name || '—' %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <a href="/our-doctors" class="btn btn-outline-primary btn-sm mt-3">View All Doctors</a>
    </div>
  </section>
</div>

<%- include('../partials/public-footer') %>

<script>
  function refreshLiveOpd() {
    fetch('/live-opd.json').then(function (r) { return r.json(); }).then(function (d) {
      document.getElementById('ls-doctors').textContent = d.summary.doctorsActive;
      document.getElementById('ls-inconsult').textContent = d.summary.inConsultation;
      document.getElementById('ls-waiting').textContent = d.summary.waiting;
      document.getElementById('ls-total').textContent = d.summary.totalVisitsToday;
    }).catch(function () {});
  }
  setInterval(refreshLiveOpd, 30000);
</script>
