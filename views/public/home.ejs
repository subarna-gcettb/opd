<%- include('../partials/public-nav') %>
<div class="clinic-site">
<section class="clinic-hero"><div class="container py-5"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="hero-eyebrow"><i class="bi bi-shield-check"></i> TRUSTED HEALTHCARE • MODERN OPD CARE</span><h1 class="display-3 fw-bold mt-3">Healthcare that puts <span>patients first.</span></h1><p class="hero-copy"><%= siteSettings.seo_description || 'Compassionate clinical care, experienced doctors and a seamless digital patient experience.' %></p><div class="d-flex flex-wrap gap-3 mt-4"><a href="/auth/signup" class="btn btn-light btn-lg px-4"><i class="bi bi-person-plus me-2"></i>Patient Sign Up</a><a href="/patient-portal-info" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-calendar2-check me-2"></i>Book an Appointment</a><a href="/live-opd" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-broadcast me-2"></i>Live OPD</a></div><div class="hero-trust mt-4"><span><i class="bi bi-check-circle-fill"></i> Experienced doctors</span><span><i class="bi bi-check-circle-fill"></i> Digital records</span><span><i class="bi bi-check-circle-fill"></i> Patient-first care</span></div></div><div class="col-lg-5"><div class="hero-live-card"><div class="d-flex justify-content-between"><strong><span class="live-dot"></span>OPD LIVE NOW</strong><a href="/live-opd">Open board <i class="bi bi-arrow-up-right"></i></a></div><div class="mt-4 small text-white-50">Patients currently in consultation</div><div class="hero-token-count" id="home-live-consult"><%= liveSummary.inConsultation %></div><div class="row g-2 mt-3"><div class="col-6"><div class="mini-stat"><strong id="home-live-wait"><%= liveSummary.waiting %></strong><span>Waiting</span></div></div><div class="col-6"><div class="mini-stat"><strong id="home-live-total"><%= liveSummary.totalVisitsToday %></strong><span>Today's visits</span></div></div></div></div></div></div></div></section>
<section class="clinic-section clinic-photo-section"><div class="container"><div class="section-heading"><div><span>OUR FACILITY</span><h2>A modern care environment.</h2><p class="text-muted mb-0">Designed around comfortable visits, coordinated clinical care and accessible diagnostics.</p></div><a href="/contact" class="btn btn-outline-primary">Visit / Contact us <i class="bi bi-arrow-right"></i></a></div><div class="row g-4"><div class="col-lg-7"><a class="clinic-photo-card clinic-photo-large" href="https://images.pexels.com/photos/6129681/pexels-photo-6129681.jpeg?auto=compress&dpr=1&h=900&w=1400" target="_blank" rel="noopener"><img src="https://images.pexels.com/photos/6129681/pexels-photo-6129681.jpeg?auto=compress&dpr=1&h=900&w=1400" alt="Doctors and nurse discussing patient care" loading="lazy"><span>Patient-focused clinical care</span></a></div><div class="col-lg-5"><div class="row g-4"><div class="col-12"><a class="clinic-photo-card clinic-photo-small" href="https://images.pexels.com/photos/29329917/pexels-photo-29329917/free-photo-of-modern-hospital-interior-with-staircase-and-elevators.jpeg?auto=compress&dpr=1&h=750&w=1260" target="_blank" rel="noopener"><img src="https://images.pexels.com/photos/29329917/pexels-photo-29329917/free-photo-of-modern-hospital-interior-with-staircase-and-elevators.jpeg?auto=compress&dpr=1&h=750&w=1260" alt="Modern hospital interior" loading="lazy"><span>Modern facility</span></a></div><div class="col-12"><a class="clinic-photo-card clinic-photo-small" href="https://images.pexels.com/photos/33105678/pexels-photo-33105678/free-photo-of-medical-laboratory-professionals-in-action.jpeg?auto=compress&dpr=1&h=750&w=1260" target="_blank" rel="noopener"><img src="https://images.pexels.com/photos/33105678/pexels-photo-33105678/free-photo-of-medical-laboratory-professionals-in-action.jpeg?auto=compress&dpr=1&h=750&w=1260" alt="Medical laboratory professionals working" loading="lazy"><span>Laboratory & diagnostics</span></a></div></div></div></div><p class="small text-muted mt-3 mb-0">Photography: Pexels contributors. Images are free to use under the Pexels License.</p></div></section><section class="clinic-stat-strip"><div class="container"><div class="row g-0"><div class="col-6 col-lg-3"><div class="clinic-stat"><i class="bi bi-people"></i><strong><%= liveSummary.totalVisitsToday %></strong><span>Visits today</span></div></div><div class="col-6 col-lg-3"><div class="clinic-stat"><i class="bi bi-person-badge"></i><strong><%= liveSummary.doctorsActive %></strong><span>Doctors active</span></div></div><div class="col-6 col-lg-3"><div class="clinic-stat"><i class="bi bi-hourglass-split"></i><strong><%= liveSummary.waiting %></strong><span>Patients waiting</span></div></div><div class="col-6 col-lg-3"><div class="clinic-stat"><i class="bi bi-heart-pulse"></i><strong>24/7</strong><span>Care-focused support</span></div></div></div></div></section>
<section class="clinic-section"><div class="container"><div class="section-heading"><div><span>CARE SERVICES</span><h2>Everything you need, in one place.</h2></div><a href="/services" class="btn btn-outline-primary">View all services <i class="bi bi-arrow-right"></i></a></div><div class="row g-4"><% departments.forEach(function(dept){ %><div class="col-6 col-md-4 col-lg-3"><a class="feature-card" href="/services"><div class="feature-icon"><i class="bi bi-heart-pulse"></i></div><h5><%= dept.name %></h5><p>Professional OPD consultation and patient care.</p><span>Explore <i class="bi bi-arrow-right"></i></span></a></div><% }) %></div></div></section>
<section class="clinic-section clinic-soft"><div class="container"><div class="section-heading"><div><span>OUR DOCTORS</span><h2>Meet our clinical team.</h2></div><a href="/our-doctors" class="btn btn-outline-primary">View doctors <i class="bi bi-arrow-right"></i></a></div><div class="row g-4"><% doctors.forEach(function(doc){ %><div class="col-md-6 col-lg-4"><div class="doctor-profile-card"><div class="doctor-avatar"><%= doc.name.charAt(0) %></div><div><h5><%= doc.name %></h5><p><%= doc.specialisation || doc.department_name || 'Medical Specialist' %></p><small><%= doc.qualification || '' %></small></div></div></div><% }) %></div></div></section>
<section class="clinic-section"><div class="container"><div class="portal-callout"><div><span>PATIENT PORTAL</span><h2>Your care, always within reach.</h2><p>Manage appointments, prescriptions, invoices and your health information from one secure portal.</p></div><a href="/patient-portal-info" class="btn btn-primary btn-lg">Open Patient Portal <i class="bi bi-arrow-right ms-2"></i></a></div></div></section>
<section class="clinic-section"><div class="container"><div class="live-preview"><div><span>LIVE OPD</span><h2>See the queue before you arrive.</h2><p>View the running token, consultation status and upcoming queue in real time.</p></div><a href="/live-opd" class="btn btn-light btn-lg">View Live OPD <i class="bi bi-broadcast ms-2"></i></a></div></div></section>
</div><%- include('../partials/public-footer') %>
<script>(function(){function r(){fetch('/live-opd.json',{cache:'no-store'}).then(x=>x.json()).then(d=>{document.getElementById('home-live-consult').textContent=d.summary.inConsultation;document.getElementById('home-live-wait').textContent=d.summary.waiting;document.getElementById('home-live-total').textContent=d.summary.totalVisitsToday}).catch(()=>{})}setInterval(r,15000)})();</script>