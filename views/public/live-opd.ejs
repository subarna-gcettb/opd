<%- include('../partials/public-nav') %>
<style>
.live-board-hero{background:linear-gradient(135deg,var(--hms-primary-dark),var(--hms-primary));color:#fff;padding:2rem 0}
.current-token{font-size:clamp(5rem,14vw,10rem);line-height:.9;font-weight:900;letter-spacing:-.06em}
.doctor-live-card{background:#fff;border:1px solid var(--hms-border);border-radius:1rem;padding:1.25rem;height:100%}
.waiting-token{font-size:2rem;font-weight:800}
</style>
<div class="landing-body">
  <section class="live-board-hero">
    <div class="container text-center">
      <div class="text-uppercase small fw-semibold opacity-75">Live OPD • Today</div>
      <h1 class="mt-2 mb-0">Now Serving</h1>
      <div id="hero-token" class="current-token">—</div>
      <div id="hero-doctor" class="fs-4 fw-semibold">Waiting for the next patient</div>
      <div class="mt-3"><span class="badge text-bg-light text-dark px-3 py-2" id="hero-status">Live</span></div>
    </div>
  </section>

  <section class="landing-section">
    <div class="container">
      <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="fs-2 fw-bold" id="s-doctors"><%= summary.doctorsActive %></div><div class="text-muted">Doctors Active</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="fs-2 fw-bold" id="s-waiting"><%= summary.waiting %></div><div class="text-muted">Patients Waiting</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="fs-2 fw-bold" id="s-consult"><%= summary.inConsultation %></div><div class="text-muted">In Consultation</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="fs-2 fw-bold" id="s-total"><%= summary.totalVisitsToday %></div><div class="text-muted">Today's Visits</div></div></div></div>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Doctor-wise Live Queue</h2>
        <span class="small text-muted">Auto-refreshes every 10 seconds</span>
      </div>
      <div class="row g-3" id="doctor-board">
        <% board.forEach(function(d){ %>
          <div class="col-md-6 col-lg-4">
            <div class="doctor-live-card">
              <div class="d-flex justify-content-between align-items-start">
                <div><h5 class="mb-1"><%= d.doctorName %></h5><div class="small text-muted"><%= d.departmentName || 'OPD' %></div></div>
                <span class="badge text-bg-<%= d.isPresent ? (d.inChamber ? 'success' : 'secondary') : 'danger' %>"><%= d.isPresent ? (d.inChamber ? 'In Chamber' : 'Available') : 'On Leave' %></span>
              </div>
              <hr>
              <% if (d.inChamber) { %><div class="small text-muted">Currently consulting</div><div class="waiting-token"><%= String(d.currentToken).padStart(3,'0') %></div><% } else { %><div class="text-muted py-3">No patient currently in consultation.</div><% } %>
              <div class="d-flex gap-3 small mt-2"><span>Waiting <strong><%= d.waitingCount %></strong></span><span>Called <strong><%= d.calledCount %></strong></span></div>
              <% if (d.nextInQueue.length) { %><div class="mt-3 small text-muted">Next tokens</div><div class="d-flex gap-2 flex-wrap mt-1"><% d.nextInQueue.forEach(n => { %><span class="badge text-bg-light border text-dark px-3 py-2"><%= String(n.token).padStart(3,'0') %></span><% }) %></div><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
</div>
<%- include('../partials/public-footer') %>
<script>
(function(){
  function render(d){
    document.getElementById('s-doctors').textContent=d.summary.doctorsActive;
    document.getElementById('s-waiting').textContent=d.summary.waiting;
    document.getElementById('s-consult').textContent=d.summary.inConsultation;
    document.getElementById('s-total').textContent=d.summary.totalVisitsToday;
    const current=d.board.find(x=>x.inChamber);
    document.getElementById('hero-token').textContent=current ? String(current.currentToken).padStart(3,'0') : '—';
    document.getElementById('hero-doctor').textContent=current ? current.doctorName : 'Waiting for the next patient';
    document.getElementById('hero-status').textContent=current ? (current.departmentName || 'OPD') : 'No active consultation';
  }
  fetch('/live-opd.json').then(r=>r.json()).then(render).catch(()=>{});
  setInterval(()=>fetch('/live-opd.json').then(r=>r.json()).then(render).catch(()=>{}),10000);
})();
</script>
