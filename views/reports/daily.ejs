<h4 class="mb-3">Daily OPD Report</h4>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-2"><label class="form-label small">From</label><input type="date" name="from" class="form-control form-control-sm" value="<%= from %>"></div>
      <div class="col-md-2"><label class="form-label small">To</label><input type="date" name="to" class="form-control form-control-sm" value="<%= to %>"></div>
      <div class="col-md-3">
        <label class="form-label small">Department</label>
        <select name="departmentId" class="form-select form-select-sm">
          <option value="">All</option>
          <% departments.forEach(function(d) { %><option value="<%= d.id %>" <%= String(filters.departmentId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small">Doctor</label>
        <select name="doctorId" class="form-select form-select-sm">
          <option value="">All</option>
          <% doctors.forEach(function(d) { %><option value="<%= d.id %>" <%= String(filters.doctorId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Apply</button></div>
    </form>
  </div>
</div>

<div class="card no-print">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Date</th><th>Total Patients</th><th>Completed</th><th>Cancelled</th><th>No-show</th><th>Revenue</th><th>Discount</th></tr></thead>
      <tbody>
        <% rows.forEach(function(r) { %>
          <tr>
            <td><%= new Date(r.date).toLocaleDateString() %></td>
            <td><%= r.total_patients %></td>
            <td><%= r.completed %></td>
            <td><%= r.cancelled %></td>
            <td><%= r.no_show %></td>
            <td>₹<%= Number(r.revenue).toFixed(2) %></td>
            <td>₹<%= Number(r.discount).toFixed(2) %></td>
          </tr>
        <% }) %>
        <% if (rows.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No data for this range.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<button onclick="window.print()" class="btn btn-outline-secondary btn-sm mt-3 no-print"><i class="bi bi-printer"></i> Print</button>
